          "type": 301
        },
        {
          "source": "/vocodrive",
          "destination": "https://biteperk.com/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/products/vocotable{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/products/vocoorder{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/products/vococoncierge{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/products/vocodrive{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/perktable",
          "destination": "https://biteperk.com/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/perkorder",
          "destination": "https://biteperk.com/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/perkconcierge",
          "destination": "https://biteperk.com/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/perkdrive",
          "destination": "https://biteperk.com/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/products/perktable{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/products/perkorder{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/products/perkconcierge{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/products/perkdrive{,/**}",
          "destination": "https://biteperk.com/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/privacy",
          "destination": "https://biteperk.com/au-en/legal/privacy/",
          "type": 301
        },
        {
          "source": "/terms",
          "destination": "https://biteperk.com/au-en/legal/terms/",
          "type": 301
        },
        {
          "source": "/cookies",
          "destination": "https://biteperk.com/au-en/legal/cookies/",
          "type": 301
        },
        {
          "//": "Trailing-slash paths (every Astro page URL). The glob catch-all below drops the slash, which biteperk.com then 301s back on — a second hop on exactly the URL shape external links use. RE2 named capture keeps it single-hop.",
          "regex": "^/(?P<path>.+)/$",
          "destination": "https://biteperk.com/au-en/:path/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://biteperk.com/au-en/:path",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ]
