{
  "functions": [
    {
      "source": "functions",
      "codebase": "biteperk-website",
      "runtime": "nodejs20"
    }
  ],
  "firestore": [
    {
      "database": "biteperk-leads",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "//": "biteperk.com — the one real site. Serves the merged build: /au-en (AU), /en + /fr (international), shared assets at root.",
      "target": "biteperk-global",
      "public": "dist-site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/contact",
          "function": {
            "functionId": "contactForm",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/event",
          "function": {
            "functionId": "analyticsEvent",
            "region": "australia-southeast1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/en/",
          "type": 301
        },
        {
          "source": "/gb",
          "destination": "/gb-en/",
          "type": 301
        },
        {
          "source": "/uk",
          "destination": "/gb-en/",
          "type": 301
        },
        {
          "source": "/be",
          "destination": "/be-en/",
          "type": 301
        },
        {
          "//": "Home-market shortcut, sibling of /gb /uk /be.",
          "source": "/au",
          "destination": "/au-en/",
          "type": 301
        },
        {
          "//": "fr-FR is the hreflang code; people type it as a path.",
          "source": "/fr-fr",
          "destination": "/fr/",
          "type": 301
        },
        {
          "source": "/au-en/voxtable",
          "destination": "/au-en/products/voxtable/",
          "type": 301
        },
