{
  "functions": [
    {
      "source": "functions",
      "codebase": "biteperk-website",
      "runtime": "nodejs20"
    }
  ],
  "firestore": [
    {
      "database": "biteperk-leads",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "//": "biteperk.com \u2014 the one real site. Serves the merged build: /au-en (AU), /en + /fr (international), shared assets at root.",
      "target": "biteperk-global",
      "public": "dist-site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/contact",
          "function": {
            "functionId": "contactForm",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/event",
          "function": {
            "functionId": "analyticsEvent",
            "region": "australia-southeast1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/en/",
          "type": 301
        },
        {
          "source": "/gb",
          "destination": "/gb-en/",
          "type": 301
        },
        {
          "source": "/uk",
          "destination": "/gb-en/",
          "type": 301
        },
        {
          "source": "/be",
          "destination": "/be-en/",
          "type": 301
        },
        {
          "source": "/au-en/voxtable",
          "destination": "/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/au-en/voxorder",
          "destination": "/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/au-en/voxconcierge",
          "destination": "/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/au-en/voxdrive",
          "destination": "/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/au-en/vocotable",
          "destination": "/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/au-en/vocoorder",
          "destination": "/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/au-en/vococoncierge",
          "destination": "/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/au-en/vocodrive",
          "destination": "/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/au-en/products/vocotable{,/**}",
          "destination": "/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/au-en/products/vocoorder{,/**}",
          "destination": "/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/au-en/products/vococoncierge{,/**}",
          "destination": "/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/au-en/products/vocodrive{,/**}",
          "destination": "/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/au-en/perktable",
          "destination": "/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/au-en/perkorder",
          "destination": "/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/au-en/perkconcierge",
          "destination": "/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/au-en/perkdrive",
          "destination": "/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/au-en/products/perktable{,/**}",
          "destination": "/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/au-en/products/perkorder{,/**}",
          "destination": "/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/au-en/products/perkconcierge{,/**}",
          "destination": "/au-en/products/voxconcierge/",
          "type": 301
        },
        {
          "source": "/au-en/products/perkdrive{,/**}",
          "destination": "/au-en/products/voxdrive/",
          "type": 301
        },
        {
          "source": "/au-en/privacy",
          "destination": "/au-en/legal/privacy/",
          "type": 301
        },
        {
          "source": "/au-en/terms",
          "destination": "/au-en/legal/terms/",
          "type": 301
        },
        {
          "source": "/au-en/cookies",
          "destination": "/au-en/legal/cookies/",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://snap.licdn.com; font-src 'self' data:; connect-src 'self' https://px.ads.linkedin.com https://px4.ads.linkedin.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "**/*.@(svg|png|jpeg|jpg|ico|webp|avif|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=2592000,immutable"
            }
          ]
        },
        {
          "source": "**/*.@(html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=300,must-revalidate"
            }
          ]
        },
        {
          "source": "/sitemap-index.xml",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=3600"
            }
          ]
        },
        {
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "//": "biteperk.com.au \u2014 redirect-only country-code front door (Accenture-style). Every path 301s, path-for-path, to biteperk.com/au-en/**.",
      "target": "biteperk",
      "public": "dist-cctld",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://biteperk.com/au-en/:path",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ]
    }
  ]
}
