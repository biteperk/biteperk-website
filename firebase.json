      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://snap.licdn.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; font-src 'self' data:; connect-src 'self' https://px.ads.linkedin.com https://px4.ads.linkedin.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://google.com https://www.google.co.uk https://www.google.com.au; frame-src https://www.googletagmanager.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
            }
          ],
          "//": "CSP keeps 'unsafe-inline' on purpose: the pre-paint theme/consent scripts in Base.astro and every JSON-LD block are is:inline, and a static host cannot nonce them. `data:` was removed from script-src (nothing loads a data-URI script; it is a known bypass) and object-src is 'none'."
        },
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "**/*.@(svg|png|jpeg|jpg|ico|webp|avif|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=2592000"
            }
          ],
          "//": "Not content-hashed (/og, /images, /brand, /manifest, favicons) — so no `immutable`; a regenerated card or manifest must be re-fetchable within max-age. Hashed /_astro/** is the rule above."
        },
        {
          "//": "HTML pages. With cleanUrls no request ends in .html — the previous `**/*.@(html)` glob never matched and pages cached for Firebase's 3600s default (measured live 13 Sep 2026). Pages are the only URLs ending in '/'; assets never do. check-hosting.mjs asserts this rule matches every index.html directory.",
          "regex": "^/.*/$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=300,must-revalidate"
            }
          ]
        },
        {
          "source": "/sitemap-index.xml",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=3600"
            }
          ]
        },
        {
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=86400"
            }
          ]
        },
        {
          "regex": "^/au-en(/.*)?$",
          "headers": [
            {
              "key": "Content-Language",
              "value": "en-AU"
            }
          ]
        },
        {
          "regex": "^/en(/.*)?$",
          "headers": [
            {
              "key": "Content-Language",
              "value": "en"
            }
          ]
        },
        {
          "regex": "^/gb-en(/.*)?$",
          "headers": [
            {
              "key": "Content-Language",
              "value": "en-GB"
            }
          ]
        },
        {
          "regex": "^/fr(/.*)?$",
          "headers": [
            {
              "key": "Content-Language",
              "value": "fr"
            }
          ]
        },
        {
          "regex": "^/be-en(/.*)?$",
          "headers": [
            {
              "key": "Content-Language",
              "value": "en-BE"
            }
          ]
        },
        {
          "regex": "^/be-fr(/.*)?$",
          "headers": [
            {
              "key": "Content-Language",
              "value": "fr-BE"
            }
          ]
        }
      ]
    },
    {
      "//": "biteperk.com.au — redirect-only country-code front door (Accenture-style). Every path 301s, path-for-path, to biteperk.com/au-en/**.",
      "target": "biteperk",
      "public": "dist-cctld",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "redirects": [
        {
          "//": "The apex. `/:path*` does not match the empty path, so without this the homepage fell through to dist-cctld/index.html — a meta-refresh, i.e. the WEAKEST redirect signal on the single URL carrying the most accumulated authority on the migrating domain. Server-side 301 is what Google's site-move guidance asks for.",
          "source": "/",
          "destination": "https://biteperk.com/au-en/",
          "type": 301
        },
        {
          "//": "Root-only files live at the biteperk.com ROOT (merge-dist keeps them out of /au-en). The catch-all below would send them to /au-en/<file> → 404 — which is what the old domain's Search Console sitemap did until 13 Sep 2026.",
          "source": "/sitemap-index.xml",
          "destination": "https://biteperk.com/sitemap-index.xml",
          "type": 301
        },
        {
          "source": "/sitemap-0.xml",
          "destination": "https://biteperk.com/sitemap-0.xml",
          "type": 301
        },
        {
          "source": "/robots.txt",
          "destination": "https://biteperk.com/robots.txt",
          "type": 301
        },
        {
          "source": "/llms.txt",
          "destination": "https://biteperk.com/llms.txt",
          "type": 301
        },
        {
          "source": "/humans.txt",
          "destination": "https://biteperk.com/humans.txt",
          "type": 301
        },
        {
          "//": "Legacy product/legal slugs: mirrored from the biteperk-global list so .com.au links are single-hop. check-hosting.mjs asserts the two lists agree.",
          "source": "/voxtable",
          "destination": "https://biteperk.com/au-en/products/voxtable/",
          "type": 301
        },
        {
          "source": "/voxorder",
          "destination": "https://biteperk.com/au-en/products/voxorder/",
          "type": 301
        },
        {
          "source": "/voxconcierge",
          "destination": "https://biteperk.com/au-en/products/voxconcierge/",
          "type": 301
        },
        {
