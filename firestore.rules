rules_version = '2';

// biteperk-leads (named DB). The contactForm Cloud Function uses the Admin
// SDK, which bypasses these rules. No client SDK ever points at this DB, so
// every direct client read/write is denied — defence in depth for lead data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
