---
import Base from "@/layouts/AuBase.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ImageBlock from "@/components/ImageBlock.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { site } from "@/data/site";
import { products, voxProof } from "@/data/products";
import { u, AU_BASE } from "@/data/locales";

const title = "Contact Biteperk — Restaurant voice AI, Sydney & Australia-wide";
const description =
  "Talk to Biteperk at Level 1/457-459 Elizabeth Street, Surry Hills NSW. Call +61 2 5504 1140 (Mon–Fri, 9am–5pm AEST) or email hello@biteperk.com.au. We answer every message — usually within a few hours.";
---

<Base title={title} description={description} path="/contact/" ogImage="/og/contact.png">
  <section class="contact-hero">
    <div class="contact-glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="contact-top">
        <Breadcrumbs items={[{ label: "Home", href: u("/") }, { label: "Contact" }]} />
      </div>
      <SectionHeader
        as="h1"
        eyebrow="Talk to a human"
        lede="We work with a small number of venues at a time. Whether you want to talk about VoxTable, a future product, or just the missed-call problem — say hello."
      >
        <Fragment slot="headline">
          One conversation away
          <br />
          from <span class="gold">a quieter Friday night.</span>
        </Fragment>
      </SectionHeader>

      {/* What happens next — turns a vague form into a concrete,
          low-risk ask. Static for everyone; demo CTAs land here. */}
      <ol class="contact-steps reveal reveal-stagger">
        <li>
          <span class="contact-step-n" aria-hidden="true">1</span>
          <h2>A 15-minute call</h2>
          <p>You tell us about your venue and your phone. No slides, no pressure.</p>
        </li>
        <li>
          <span class="contact-step-n" aria-hidden="true">2</span>
          <h2>Bella on a test line</h2>
          <p>We set her up for your venue on a number you can call yourself.</p>
        </li>
        <li>
          <span class="contact-step-n" aria-hidden="true">3</span>
          <h2>You make the call</h2>
          <p>Ring her, try to stump her, and decide if she belongs on your line.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="contact-strip">
    <div class="wrap">
      <div class="reveal contact-strip-frame">
        <ImageBlock
          slug="sydney-cafe-morning"
          alt="Sydney café interior at morning, warm amber light through the windows."
          aspect="21 / 9"
          widths="(min-width: 1280px) 1280px, 100vw"
        />
        <div class="contact-strip-tag">
          <span class="dot" aria-hidden="true"></span>
          Surry Hills, Sydney · Mon–Fri 9am–5pm AEST
        </div>
      </div>
    </div>
  </section>

  <section class="contact-grid-wrap">
    <div class="wrap">
      <div class="contact-grid">
        {/* Direct contact column */}
        <aside class="contact-side reveal">
          <div class="contact-side-block">
            <div class="contact-side-l">Call us</div>
            <a class="contact-side-v" href={site.phone.href}>{site.phone.display}</a>
            <div class="contact-side-h">{site.hours.display}</div>
          </div>
          <div class="contact-side-block">
            <div class="contact-side-l">Email</div>
            <a class="contact-side-v" href={site.email.href}>{site.email.display}</a>
            <div class="contact-side-h">We reply, usually within a few hours.</div>
          </div>
          {voxProof.demo && (
            <div class="contact-side-block">
              <div class="contact-side-l">Hear her first</div>
              <a
                class="contact-side-v"
                href={voxProof.demo.href}
                rel="noopener"
                target="_blank"
                data-cta="audio-demo"
              >
                {voxProof.demo.label} →
              </a>
              <div class="contact-side-h">Real Bella audio, one minute.</div>
            </div>
          )}
          <div class="contact-side-block">
            <div class="contact-side-l">Find us</div>
            <a
              class="contact-side-v contact-side-addr"
              href={site.address.mapsUrl}
              rel="noopener"
              target="_blank"
            >
              {site.address.street}<br />
              {site.address.locality} {site.address.region} {site.address.postalCode}
            </a>
            <div class="contact-side-h">Local team. Local data. Local hours.</div>
          </div>
          <div class="contact-side-block">
            <div class="contact-side-l">Follow along</div>
            <SocialLinks label="Follow BitePerk" showHandles size={18} />
          </div>
        </aside>

        {/* Form column */}
        <form
          class="contact-form reveal"
          method="post"
          action="/api/contact"
          aria-label="Contact form"
        >
          <noscript>
            <div class="contact-noscript">
              For a faster reply, email <a href={site.email.href}>{site.email.display}</a> directly.
            </div>
          </noscript>

          {/* Honeypot — bots fill it; humans don't see it. */}
          <div class="contact-honey" aria-hidden="true">
            <label>
              Please leave this field empty
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          {/* First-touch campaign attribution, populated from sessionStorage
              by the submit handler so each lead records which campaign drove
              it. First-party; travels only with the enquiry the user sends. */}
          <input type="hidden" name="attribution" value="" data-attribution />

          {/* Proof-of-interaction + dedupe key, filled at submit time by the
              JS handler. formToken = btoa(pageInitMs + ":" + submitMs) — its
              presence tells the function a browser ran our script (leads
              without it classify "unverified" and skip CRM/ad-conversion
              export; they are still stored and emailed). leadRef is a random
              UUID sent as the gtag conversion's transaction_id so offline
              conversion uploads can dedupe against the pixel. Neither field
              carries anything about the visitor. */}
          <input type="hidden" name="formToken" value="" data-form-token />
          <input type="hidden" name="leadRef" value="" data-lead-ref />
          {/* Which tree the lead came from — the intl form sends its locale
              base too, so every lead can be routed by market. */}
          <input type="hidden" name="locale" value={AU_BASE} />


          <div class="contact-row">
            <div class="contact-field">
              <label for="cf-name">Your name <span aria-hidden="true">*</span></label>
              <input id="cf-name" name="name" type="text" required maxlength="200" autocomplete="name" />
            </div>
            <div class="contact-field">
              <label for="cf-email">Email <span aria-hidden="true">*</span></label>
              <input id="cf-email" name="email" type="email" required maxlength="320" autocomplete="email" />
            </div>
          </div>

          <div class="contact-row">
            <div class="contact-field">
              <label for="cf-venue">Your venue</label>
              <input
                id="cf-venue"
                name="venue"
                type="text"
                maxlength="200"
                placeholder="e.g. The Garden Room, Surry Hills"
                autocomplete="organization"
              />
            </div>
            <div class="contact-field">
              <label for="cf-product">About</label>
              <select id="cf-product" name="product">
                {products.map((p) => <option value={p.slug}>{p.name}</option>)}
                <option value="general">Something else</option>
              </select>
            </div>
          </div>

          <div class="contact-field">
            <label for="cf-message">Message <span aria-hidden="true">*</span></label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              maxlength="5000"
              placeholder="What would you want VoxTable (or its next sibling) to do for your venue?"
            ></textarea>
          </div>

          <button class="btn contact-submit" type="submit">Send message →</button>
          <p class="contact-status" role="status" aria-live="polite" hidden></p>
          <p class="contact-fineprint">
            By submitting, you agree we can reply to your message.
            We never share your details and we'll delete the message once we've followed up.
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-hero {
    padding: clamp(120px, 14vw, 180px) 0 clamp(56px, 7vw, 80px);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .contact-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(40% 50% at 80% 0%, var(--gold-soft), transparent 70%);
  }
  .contact-hero .wrap { position: relative; z-index: 1; }
  .contact-top { margin-bottom: 28px; }

  .contact-strip {
    padding-block: clamp(24px, 3vw, 40px);
    background: var(--ink-0);
  }
  .contact-strip-frame {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }
  .contact-strip-frame :global(.image-block) {
    border-radius: 0;
  }
  .contact-strip-tag {
    position: absolute;
    bottom: 20px;
    left: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: var(--r-pill);
    background: rgba(10, 11, 13, 0.7);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--on-image);
  }
  .contact-strip-tag .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-fill);
    box-shadow: 0 0 12px var(--gold-fill);
  }

  .contact-grid-wrap { padding-block: var(--space-section); background: var(--ink-0); }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 64px;
    align-items: start;
  }
  /* Unified with the sitewide 980 split-grid collapse. When stacked, the
     form leads (right after the image band) so mobile visitors hit the
     primary action first; the Call us / Email / Find us details follow. */
  @media (max-width: 980px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
    .contact-form { order: -1; }
  }

  .contact-side { display: grid; gap: 32px; }
  .contact-side-block {
    padding: 24px 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--ink-1);
  }
  .contact-side-l {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--mist);
    font-weight: 600;
  }
  .contact-side-v {
    margin-top: 8px;
    display: block;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.02em;
  }
  a.contact-side-v:hover { color: var(--gold); }
  .contact-side-addr {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.45;
  }
  .contact-side-h {
    margin-top: 8px;
    font-size: 13px;
    color: var(--mist);
  }

  .contact-form {
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--gold-fill) 3%, transparent), transparent 50%),
      var(--ink-1);
  }
  .contact-noscript {
    margin-bottom: 18px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--ink-2);
    color: var(--text);
    font-size: 14px;
  }
  .contact-noscript a { color: var(--gold); }

  .contact-honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 18px;
  }
  @media (max-width: 540px) {
    .contact-row { grid-template-columns: 1fr; }
  }

  .contact-field label {
    display: block;
    font-size: 12.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--mist);
    margin-bottom: 8px;
    font-weight: 600;
  }
  .contact-field label span { color: var(--gold); }
  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    width: 100%;
    background: var(--ink-1);
    color: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    padding: 14px 16px;
    font-family: inherit;
    /* 16px minimum: any smaller and iOS Safari force-zooms the page the
       moment a field is focused — on the conversion form. */
    font-size: 16px;
    line-height: 1.5;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .contact-field textarea {
    resize: vertical;
    min-height: 140px;
  }
  .contact-field input:focus,
  .contact-field select:focus,
  .contact-field textarea:focus {
    border-color: var(--gold);
    background: var(--ink-3);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 14%, transparent);
  }
  .contact-field:focus-within label {
    color: var(--gold);
  }
  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: var(--mist);
  }

  .contact-field { margin-bottom: 22px; }
  .contact-row + .contact-field,
  .contact-row + .contact-row { margin-top: 0; }

  .contact-submit {
    margin-top: 10px;
  }
  .contact-fineprint {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--mist);
    line-height: 1.5;
  }

  .contact-status {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: var(--r-md);
    font-size: 14px;
    line-height: 1.5;
    border: 1px solid var(--line);
  }
  .contact-status[hidden] { display: none; }
  .contact-status.is-error {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 12%, transparent);
    border-color: color-mix(in srgb, var(--danger) 35%, transparent);
  }
  .contact-status a { color: var(--gold); }

  .contact-success {
    padding: 40px 32px;
    text-align: center;
  }
  .contact-success h2 {
    margin: 0 0 12px;
    font-size: clamp(22px, 3vw, 28px);
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .contact-success p {
    margin: 0;
    color: var(--mist);
    line-height: 1.6;
  }
  .contact-success-tick {
    display: inline-flex;
    color: var(--success);
    margin-bottom: 18px;
  }
  /* Success choreography — the card settles in and the tick draws
     itself. Keyframes fire on insertion, so no extra script is needed. */
  @media (prefers-reduced-motion: no-preference) {
    .contact-success {
      animation: contact-pop var(--dur-slow) var(--ease-soft) backwards;
    }
    .contact-success-tick svg circle,
    .contact-success-tick svg path {
      stroke-dasharray: 240;
      stroke-dashoffset: 240;
      animation: contact-trace 0.9s var(--ease-out) 150ms forwards;
    }
  }
  @keyframes contact-pop {
    from { opacity: 0; transform: scale(0.96) translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes contact-trace {
    to { stroke-dashoffset: 0; }
  }

  /* What happens next — 3-step demo strip */
  .contact-steps {
    list-style: none;
    margin: 52px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    counter-reset: step;
  }
  .contact-steps li {
    padding: 24px 26px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--ink-1);
  }
  .contact-step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--gold-fill);
    color: var(--gold-fill-text);
    font-weight: 800;
    font-size: 14px;
  }
  .contact-steps h2 {
    margin-top: 14px;
    font-size: 16.5px;
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.01em;
  }
  .contact-steps p {
    margin-top: 7px;
    color: var(--text);
    font-size: 13.5px;
    line-height: 1.55;
  }
  @media (max-width: 760px) {
    .contact-steps { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { googleAdsDemoContactConversionId } from "@/data/consent";
  import { reportGoogleAdsConversion } from "@/scripts/google-ads";

  (function () {
    function init() {
      const form = document.querySelector<HTMLFormElement>(".contact-form");
      // Guard against double-binding when astro:page-load re-runs on a persisted node.
      if (!form || form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      // Preselect the "About" dropdown from ?product= — the capability waitlist
      // CTAs link here with it, so each lead records which capability they want.
      const params = new URLSearchParams(window.location.search);
      const wantedProduct = params.get("product");
      if (wantedProduct) {
        const sel = form.querySelector<HTMLSelectElement>("#cf-product");
        if (sel && Array.from(sel.options).some((o) => o.value === wantedProduct)) {
          sel.value = wantedProduct;
        }
      }

      // Demo intent (?intent=demo, set by "Book a demo" CTAs) — reframe the
      // hero copy around the concrete 3-step path shown below it.
      if (params.get("intent") === "demo") {
        const eyebrow = document.querySelector<HTMLElement>(".contact-hero .eyebrow");
        const lede = document.querySelector<HTMLElement>(".contact-hero .section-header-lede");
        if (eyebrow) eyebrow.textContent = "Book a demo";
        if (lede)
          lede.textContent =
            "Fifteen minutes, then Bella on a test line set up for your venue — call her yourself before you decide anything.";
      }

      // Fill the attribution hidden field from first-touch sessionStorage.
      try {
        const attrField = form.querySelector<HTMLInputElement>("[data-attribution]");
        const attr = sessionStorage.getItem("bp-attr");
        if (attrField && attr) attrField.value = attr.slice(0, 1000);
      } catch {
        /* no storage — attribution simply stays empty */
      }

      const btn = form.querySelector<HTMLButtonElement>(".contact-submit");
      const status = form.querySelector<HTMLParagraphElement>(".contact-status");
      const btnLabel = btn ? btn.textContent : "Send message →";
      let busy = false;

      // Captured per init() (View-Transitions-safe: per page visit, not per
      // module eval) — the formToken proves to the function that a browser
      // ran this script; leads without it classify "unverified".
      const loadedAt = Date.now();
      // Dedupe key shared between the stored lead and the gtag conversion's
      // transaction_id, so offline conversion uploads can dedupe the pixel.
      const leadRef =
        typeof crypto !== "undefined" && "randomUUID" in crypto
          ? crypto.randomUUID()
          : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;

      function reportDemoConversion(): void {
        if (params.get("intent") !== "demo" || googleAdsDemoContactConversionId == null) return;
        reportGoogleAdsConversion(googleAdsDemoContactConversionId, leadRef);
      }

      function showError(msg: string) {
        if (!status) return;
        status.classList.add("is-error");
        // The message can include text echoed from the server response, so it
        // must never be interpreted as HTML — build the mailto link as a node.
        status.textContent = msg + " You can also email us at ";
        const mail = document.createElement("a");
        mail.href = "mailto:hello@biteperk.com.au";
        mail.textContent = "hello@biteperk.com.au";
        status.appendChild(mail);
        status.appendChild(document.createTextNode("."));
        status.hidden = false;
      }

      const SUCCESS_BODY =
        "Your message has reached the Biteperk team. We usually reply within a " +
        "few hours during business hours (Mon–Fri, 9am–5pm AEST).";
      const showSuccess = () => {
        // Arrow (not a hoisted declaration) so it captures `form` narrowed
        // non-null by the early-return guard above. The status live region
        // stays in the DOM (replacing innerHTML used to destroy it, so the
        // success was never announced) and focus moves to the confirmation
        // because the submit button that held it is now hidden.
        for (const child of Array.from(form.children)) {
          if (child !== status) (child as HTMLElement).hidden = true;
        }
        const done = document.createElement("div");
        done.className = "contact-success";
        done.tabIndex = -1;
        done.innerHTML =
          '<span class="contact-success-tick" aria-hidden="true">' +
          '<svg viewBox="0 0 56 56" width="44" height="44" fill="none">' +
          '<circle cx="28" cy="28" r="25" stroke="currentColor" stroke-width="2"/>' +
          '<path d="M17 29l8 8 15-17" stroke="currentColor" stroke-width="2.5" ' +
          'stroke-linecap="round" stroke-linejoin="round"/>' +
          "</svg></span>" +
          "<h2>Thanks — we'll be in touch.</h2>";
        const p = document.createElement("p");
        p.textContent = SUCCESS_BODY;
        done.appendChild(p);
        form.prepend(done);
        if (status) {
          status.textContent = SUCCESS_BODY;
          status.hidden = false;
        }
        done.focus();
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (busy) return; // double-submit guard
        busy = true;

        if (status) {
          status.hidden = true;
          status.classList.remove("is-error");
        }
        if (btn) {
          btn.setAttribute("aria-busy", "true");
          btn.disabled = true;
          btn.textContent = "Sending…";
        }

        // Filled at submit time (not init) so the token carries the real
        // dwell interval; the server only checks presence + shape.
        const tokenField = form.querySelector<HTMLInputElement>("[data-form-token]");
        if (tokenField) tokenField.value = btoa(`${loadedAt}:${Date.now()}`);
        const refField = form.querySelector<HTMLInputElement>("[data-lead-ref]");
        if (refField) refField.value = leadRef;

        const fd = new FormData(form);
        const payload: Record<string, string> = {};
        fd.forEach((v, k) => {
          payload[k] = typeof v === "string" ? v : "";
        });

        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(payload),
          });

          let body: { ok?: boolean; error?: string } = {};
          try {
            body = await res.json();
          } catch {
            // Non-JSON (e.g. an HTML error page) — treat as failure below.
          }

          if (res.ok && body.ok) {
            showSuccess();
            reportDemoConversion();
            document.dispatchEvent(new CustomEvent("bp:event", { detail: { name: "form-success" } }));
            return; // button is hidden; the finally block re-enables it harmlessly
          }

          showError(body.error || "Sorry — something went wrong.");
        } catch {
          showError("Network error — please try again.");
        } finally {
          busy = false;
          if (btn) {
            btn.removeAttribute("aria-busy");
            btn.disabled = false;
            btn.textContent = btnLabel;
          }
        }
      });
    }
    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
