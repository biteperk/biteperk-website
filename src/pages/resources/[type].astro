---
import { pageTitle } from "@/data/site";
import Base from "@/layouts/AuBase.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Cta from "@/components/Cta.astro";
import ConversionTrust from "@/components/conversion/ConversionTrust.astro";
import { getCollection } from "astro:content";
import {
  RESOURCE_SEGMENTS,
  resourceTypeFromSegment,
  type ResourceTypeMeta,
} from "@/data/resources";
import { buildCollectionPage } from "@/data/schema";
import { u } from "@/data/locales";
import { defaultCtaActions } from "@/data/conversion";

export async function getStaticPaths() {
  // Only categories with something in them get a page. Four of six shipped as
  // live, indexable pages whose whole body was "nothing published yet".
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const populated = new Set(posts.map((p) => p.data.type));
  return RESOURCE_SEGMENTS.filter((seg) => populated.has(resourceTypeFromSegment(seg)!.id)).map((type) => ({
    params: { type },
  }));
}

const segment = Astro.params.type!;
const meta = resourceTypeFromSegment(segment);
if (!meta) {
  throw new Error(`Unknown resources segment: ${segment}`);
}
const typedMeta: ResourceTypeMeta = meta;

const path = typedMeta.path;
const cta = defaultCtaActions();
const title = pageTitle(`${typedMeta.plural} — Resources`);
const description = typedMeta.description;

const posts = (
  await getCollection("blog", ({ data }) => !data.draft && data.type === typedMeta.id)
).sort(
  (a, b) =>
    (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) ||
    b.data.publishDate.getTime() - a.data.publishDate.getTime() ||
    a.id.localeCompare(b.id),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "long", year: "numeric" }).format(d);

// CollectionPage + ItemList of the posts (breadcrumbs via <Breadcrumbs>).
const collectionJsonLd = buildCollectionPage({
  path,
  name: title,
  description,
  items: posts.map((p) => ({ name: p.data.title, path: `/blog/${p.id}/` })),
  inLanguage: "en-AU",
});
---

<Base title={title} description={description} path={path} ogImage={`/og/resources/${segment}.png`}>
  <Fragment slot="jsonld">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  </Fragment>

  <header class="res-hero">
    <div class="wrap">
      <Breadcrumbs
        items={[
          { label: "Home", href: u("/") },
          { label: "Resources", href: u("/resources/") },
          { label: typedMeta.plural },
        ]}
      />
      <span class="eyebrow">{typedMeta.plural}</span>
      <h1 class="res-h1">{typedMeta.plural}</h1>
      <p class="lede res-lede">{typedMeta.description}</p>
    </div>
  </header>

  <section class="res-section">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="res-empty">Nothing published here yet.</p>
      ) : (
        <ul class="res-list">
          {posts.map((post) => (
            <li>
              <a href={u(`/blog/${post.id}/`)}>
                <span class="res-list-title">{post.data.title}</span>
                <span class="res-list-meta">
                  <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>{fmt(post.data.publishDate)}</time>
                  {post.data.featured && <span>· Cornerstone</span>}
                </span>
                <span class="res-list-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="res-conv">
    <div class="wrap">
      <ConversionTrust />
    </div>
  </section>
  <Cta
    eyebrow="Book a demo"
    headline="Done reading — hear it on a real line."
    lede="Bring the guide that matched your problem. We'll put Vox on a call and map the overflow."
    primary={cta.primary}
    secondary={cta.secondary}
  />
</Base>

<style>
  .res-hero {
    padding: clamp(120px, 16vw, 180px) 0 clamp(48px, 6vw, 72px);
    border-bottom: 1px solid var(--line);
  }
  .res-h1 {
    margin-top: 16px;
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--white);
  }
  .res-lede {
    margin-top: 18px;
    max-width: 62ch;
  }
  .res-section {
    padding-block: var(--space-section);
    border-bottom: 1px solid var(--line);
  }
  .res-empty {
    color: var(--text);
    max-width: 60ch;
  }
  .res-empty a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .res-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .res-list a {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }
  .res-list a:hover {
    border-color: color-mix(in srgb, var(--white) 35%, var(--line));
  }
  .res-list-title {
    color: var(--white);
    font-weight: 700;
  }
  .res-list-meta {
    color: var(--mist);
    font-size: var(--fs-small);
  }
  .res-list-desc {
    color: var(--text);
  }
  .res-conv { padding-bottom: clamp(8px, 2vw, 16px); }
</style>
