---
/**
 * International locale trees (biteperk.com) — every global locale in
 * src/data/locales.ts (/en, /gb-en, /fr, /be-en, /be-fr).
 *
 * A single catch-all that emits all locale trees for the GLOBAL build only:
 * in the AU build `getStaticPaths` returns [], so this file contributes
 * nothing and the /au-en output is unaffected.
 *
 * Copy = language core (src/data/intl/copy.ts) + market override
 * (src/data/intl/markets.ts), resolved per locale by resolveCopy(). Never
 * key anything off `locale.lang` here — "fr-BE" is not "fr"; the locale
 * object carries copyLang/base for everything. Europe-truthful rules
 * (no AU price/phone/NAP) are enforced by scripts/gates/check-truthful.mjs.
 */
import IntlLayout from "@/layouts/IntlLayout.astro";
import { localesForTarget, pagesForLocale, currentTarget, ORIGIN, type Locale } from "@/data/locales";
import {
  resolveCopy, resolveMedia, resolveHero, resolveSupport, resolveCityStrip, resolveShowCallSim,
  type CopyBundle, type SimplePageCopy,
} from "@/data/intl";
import { intlCitiesForBase } from "@/data/intl/cities";
import { companyDetails } from "@/data/intl/company-details";
import { ukEmail } from "@/data/site";
import { intlProducts, intlProductsOverview } from "@/data/intl/products";
import { pageImageFor, productImageFor } from "@/data/intl/page-images";
import { products } from "@/data/products";
import { buildFaqPage, buildVoxApplication, voxEditionId, ORG_ID } from "@/data/schema";
import ImageBlock from "@/components/ImageBlock.astro";
import FAQ from "@/components/FAQ.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import PullQuote from "@/components/PullQuote.astro";
// The city components carry their CSS as `is:inline` styles, so importing
// them here adds nothing to non-city pages: the CSS renders with the
// component, not into this page's bundle. (A normal scoped <style> in them
// would be inlined on EVERY page this file emits — Astro collects component
// CSS by import graph, dynamic imports included, not by what renders.)
import CityBody from "@/components/intl/CityBody.astro";
import CityCards from "@/components/intl/CityCards.astro";
// Same `is:inline` contract as the city components — see its header.
import TrustPanel from "@/components/intl/TrustPanel.astro";
// Same is:inline contract — its 6.6KB stylesheet renders with the
// component, on the five homes, not into all ~75 pages this file emits.
import CallSim from "@/components/CallSim.astro";

export function getStaticPaths() {
  if (currentTarget() !== "global") return [];
  const out: { params: { intl: string }; props: { locale: Locale; page: string } }[] = [];
  for (const locale of localesForTarget("global")) {
    for (const page of pagesForLocale(locale)) {
      const seg = [locale.base.replace(/^\//, ""), page].filter(Boolean).join("/");
      out.push({ params: { intl: seg }, props: { locale, page } });
    }
  }
  return out;
}

/**
 * The page registry: which template renders a given path, and where its copy
 * lives. Adding a page kind (product, city, guide) is an entry here plus a
 * body branch below — not another limb on a ternary chain.
 *
 * "simple" pages all share one prose template, so they only need a selector
 * into the copy bundle. Home and contact have bespoke bodies.
 */
const SIMPLE_PAGES: Readonly<Record<string, (c: CopyBundle) => SimplePageCopy>> = {
  "how-it-works": (c) => c.howItWorks,
  about: (c) => c.about,
  "legal/privacy": (c) => c.privacy,
  "legal/terms": (c) => c.terms,
  "legal/cookies": (c) => c.cookies,
  // Ignores the bundle: this page is UK-only and English-only, so its copy is a
  // standalone module rather than a CopyBundle key every tree would carry. It
  // still renders through the shared prose template — see company-details.ts.
  "legal/company-details": () => companyDetails,
};

const { locale, page } = Astro.props;
// Links must come from the BASE ("/gb-en/…"), never the lang ("en-GB" → 404).
const p = (seg: string) => `${locale.base}/${seg ? `${seg}/` : ""}`;

const c = resolveCopy(locale);
const media = resolveMedia(locale);
// Mutually exclusive with `media` in practice: a tree gets the two-up band OR
// this single photo, never both. See MarketSupport in markets.ts.
const support = resolveSupport(locale);
const hero = resolveHero(locale);
const { home: h, contact: ct } = c;
// Only /gb-en carries market "gb" — the tree Biteperk Ltd's UK disclosures
// attach to. There is no French or Belgian entity.
const isUk = locale.market === "gb";

const simple = SIMPLE_PAGES[page]?.(c) ?? null;
// Supporting photo for sub-pages. undefined on the home (it has a hero) and on
// the legal pages (deliberately text-only — see page-images.ts).
const pageImage = pageImageFor(page);

// `cv-auto` (content-visibility:auto, global.css) is on every section below
// the proof band: the browser skips style/layout/paint for them until they
// near the viewport. The AU tree has used it since Jul 2026; the intl tree
// never did, and Style & Layout was ~200ms of the /fr/ LCP render delay. Not
// on the hero, proof band or quote — they sit at the fold, nothing to skip.
// Product pages: STRUCTURE from products.ts (order, status, which is core),
// PROSE from intl/products.ts. The overview lists every capability; a
// /products/<slug>/ page renders one.
const productSlug = page.startsWith("products/") ? page.slice("products/".length) : null;
const overview = intlProductsOverview[locale.copyLang];
const product = productSlug ? intlProducts[locale.copyLang][productSlug] : null;
// Product detail pages key their photo off the product, not the path.
const productImage = productSlug ? productImageFor(productSlug) : undefined;
const catalogue = productSlug ? products.find((x) => x.slug === productSlug) : null;

// City pages: every text field hand-written per city (intl/cities.ts), the
// section furniture around them from the language core (c.cityPage). The
// route exists because pagesForLocale() appended the slug, so a lookup miss
// here falls through to the RENDERABLE throw with the path named.
const city = intlCitiesForBase(locale.base).find((x) => x.slug === page) ?? null;
// Home city strip: rendered only when the market has BOTH the strip copy and
// at least one published city — so /en, /fr, /be-* stay untouched by derivation.
// Opt-in per market (markets.ts) — the shared transcript moves the
// anti-doorway similarity score, so it is not on all five homes.
const showCallSim = page === "" && resolveShowCallSim(locale);
const cityStrip = page === "" ? resolveCityStrip(locale) : undefined;
const homeCities = page === "" ? intlCitiesForBase(locale.base) : [];

// A path in pagesForLocale() that no branch here can render used to reach
// `simple!.title` and die on a null dereference — an unreadable crash from a
// data edit made in a different file. Fail with the path that caused it.
const RENDERABLE =
  page === "" || page === "contact" || page === "products" || !!simple ||
  (!!product && !!catalogue) || !!city;
if (!RENDERABLE)
  throw new Error(
    `[...intl].astro: no renderer for page "${page}" (locale ${locale.base}). ` +
      (productSlug
        ? `"${productSlug}" is in PRODUCT_SLUGS but has no entry in intl/products.ts (${locale.copyLang}) ` +
          `or no entry in products.ts.`
        : `Add it to SIMPLE_PAGES or give it a body branch, or drop it from INTL_EXTRA_PAGES.`),
  );

const meta =
  page === ""
    ? { title: h.title, description: h.description }
    : page === "contact"
      ? { title: ct.title, description: ct.description }
      : page === "products"
        ? { title: overview.title, description: overview.description }
        : product
          ? { title: product.title, description: product.description }
          : city
            ? { title: city.seoTitle, description: city.seoDescription }
            : { title: simple!.title, description: simple!.description };

// OG cards are per-locale (generate-brand's sibling, scripts/brand/generate-og.mjs,
// derives them from this same copy). /en keeps the legacy unsuffixed filenames so
// already-shared card URLs never churn.
const ogSuffix = locale.base === "/en" ? "" : `-${locale.base.slice(1)}`;
// Product cards are suffixed by LANGUAGE, not by base: the prose is identical
// across the English trees, so five byte-identical PNGs per product would be
// pure weight. The core pages keep the per-base convention (their copy carries
// market overrides, so those genuinely differ).
// City cards are per-base like the core pages (generate-og.mjs derives them
// from intl/cities.ts; check-cities requires the file to exist on disk).
const ogImage =
  page === "products" || product
    ? `/og/intl/${page === "products" ? "products" : productSlug}-${locale.copyLang}.png`
    : city
      ? `/og/intl/${city.slug}${ogSuffix}.png`
      : `/og/intl/${page === "contact" ? "contact" : "home"}${ogSuffix}.png`;

// Page-level structured data — the market trees' first. Europe-truthful:
// SoftwareApplication carries NO offers (no price anywhere on these pages).
const crumbs = [
  { name: c.chrome.nav.home, item: `${ORIGIN}${locale.base}/` },
  { name: overview.eyebrow, item: `${ORIGIN}${p("products")}` },
  ...(product ? [{ name: catalogue!.name, item: `${ORIGIN}${p(page)}` }] : []),
];
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((x, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: x.name,
    item: x.item,
  })),
};
// City pages: Service + BreadcrumbList. The Service node mirrors the AU
// [city].astro one MINUS areaServed/geo/address/offers — deliberately. There
// is no European premises and no European price; the service is NAMED for the
// city, never located in it (PLAN.md §8, enforced by check-truthful +
// check-schema). provider @id keeps the entity merge with the AU-anchored org.
const cityUrl = city ? `${ORIGIN}${locale.base}/${city.slug}/` : "";
const cityServiceJsonLd = city && {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${cityUrl}#service`,
  name: `AI phone answering for ${city.name} restaurants`,
  alternateName: `AI receptionist for ${city.name} restaurants`,
  serviceType: [
    "AI phone answering and reservation booking",
    "AI receptionist for restaurants",
  ],
  description: city.seoDescription,
  provider: { "@id": ORG_ID },
  audience: { "@type": "BusinessAudience", name: "Restaurants, cafés and venues" },
  url: cityUrl,
};
const cityBreadcrumbJsonLd = city && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: c.chrome.nav.home, item: `${ORIGIN}${locale.base}/` },
    { "@type": "ListItem", position: 2, name: city.name, item: cityUrl },
  ],
};

// Product pages carry their own FAQ; the home now carries the market FAQ.
// Note Google restricted FAQ rich results to government/health sites in 2023,
// so this earns no SERP snippet — it is here for answer engines and on-page UX.
const faqJsonLd = product
  ? buildFaqPage(product.faqs)
  : city
    ? buildFaqPage([...city.faqs])
    : page === ""
      ? buildFaqPage(h.faq.items)
      : null;
const appJsonLd =
  page === "products"
    ? buildVoxApplication({
        description: overview.lede,
        // LIVE capabilities only — structured data must never claim unshipped
        // work, and three of the five are in-development/concept. No `prices`:
        // AU tiers are an Australian fact (Europe-truthful, PLAN.md §8).
        featureList: products
          .filter((x) => x.status === "live")
          .map((x) => overview.capabilities[x.slug].outcome),
        editionIds: products.map((x) => voxEditionId(x.slug)),
      })
    : null;
---

<IntlLayout
  locale={locale}
  page={page}
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
>
  {page === "" && (
    <>
      <section class="intl-hero">
        <div class="wrap intl-hero-grid">
          <div class="intl-hero-text">
            {/* Names the MARKET, never a premises — there is no European office,
                and claiming one breaks the same rule that bans the NAP and the
                AU phone. /en carries no pill: it is the neutral x-default. */}
            {hero?.pill && <span class="pill intl-pill">{hero.pill}</span>}
            <p class="eyebrow">{h.eyebrow}</p>
            <h1>{h.h1}</h1>
            <p class="lede">{h.lede}</p>
            <div class="intl-ctas">
              <a class="btn" href={p("contact")}>{h.ctaPrimary}</a>
              <a class="btn-ghost" href={p("how-it-works")}>{h.ctaSecondary}</a>
            </div>
          </div>
          {hero && (
            <div class="intl-hero-visual">
              {/* `priority` + the preload in IntlLayout make this the LCP
                  element, taking that role from the headline. `aspect` is what
                  holds CLS at 0 while it loads. */}
              {/* Deliberately NOT `priority`, and deliberately not preloaded.
                  Measured: the LCP element on these pages is TEXT — the .lede
                  on /gb-en and /be-en, the h1 on /fr — because the market copy
                  is long. Text LCP waits on the webfont, so preloading the
                  hero only stole throttled bandwidth from the thing actually
                  being measured and pushed LCP to ~2.7-3.1s. Same conclusion
                  AU reached from the other direction (Hero.astro:158-161). */}
              <ImageBlock
                slug={hero.slug}
                alt={hero.alt}
                aspect="4 / 5"
                widths="(min-width: 981px) 38vw, 460px"
                deprioritize
              />
            </div>
          )}
        </div>
      </section>

      <section class="intl-band">
        <div class="wrap">
          <p class="eyebrow">{h.proof.eyebrow}</p>
          <h2>{h.proof.heading}</h2>
          <p class="lede">{h.proof.body}</p>
          <ul class="intl-points">
            {h.proof.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
      </section>

      {/* Straight after the proof band: that section asserts Vox is in
          production, this lets a named venue say so in their own voice. The
          quote is Australian and its role line says so — there is no European
          customer yet. PullQuote is props-only; Testimonial.astro would drag in
          the AU product module and a hardcoded English image alt. */}
      <section class="intl-quote">
        <div class="wrap">
          <PullQuote
            quote={h.testimonial.quote}
            author={h.testimonial.author}
            role={h.testimonial.role}
          />
        </div>
      </section>

      {media && (
        <section class="cv-auto intl-market">
          <div class="wrap">
            <p class="eyebrow">{media.eyebrow}</p>
            <h2>{media.heading}</h2>
            <p class="lede">{media.body}</p>
            {cityStrip && homeCities.length > 0 ? (
              /* Trees with a city-card grid drop the band's cityscape — the
                 gb-en band showed london-skyline and the London card in the
                 very next section shows the same photo. One hospitality shot
                 full-width instead; the cards do the geographic work. */
              <div class="intl-market-grid intl-market-grid-single">
                <ImageBlock slug={media.hospitality.slug} alt={media.hospitality.alt} aspect="16 / 9" widths="(min-width: 981px) 1120px, 100vw" rounded />
              </div>
            ) : (
              <div class="intl-market-grid">
                {/* No `priority`: the hero headline stays the LCP element. */}
                {/* widths must match .intl-market-grid's 2-up breakpoint (721px),
                    not the 1024px default — tablets were fetching ~2x the bytes
                    they actually render. */}
                <ImageBlock slug={media.cityscape.slug} alt={media.cityscape.alt} aspect="16 / 10" widths="(min-width: 721px) 50vw, 100vw" rounded />
                <ImageBlock slug={media.hospitality.slug} alt={media.hospitality.alt} aspect="16 / 10" widths="(min-width: 721px) 50vw, 100vw" rounded />
              </div>
            )}
          </div>
        </section>
      )}

      {cityStrip && homeCities.length > 0 && (
        <section class="cv-auto intl-cities">
          <div class="wrap">
            <p class="eyebrow">{cityStrip.eyebrow}</p>
            <h2>{cityStrip.heading}</h2>
            <p class="lede">{cityStrip.body}</p>
            <CityCards
              items={homeCities.map((x) => ({
                href: p(x.slug),
                name: x.name,
                imageSlug: x.cityscapeImage,
                imageAlt: x.cityscapeImageAlt,
              }))}
            />
          </div>
        </section>
      )}

      <section class="cv-auto">
        <div class="wrap">
          <p class="eyebrow">{h.steps.eyebrow}</p>
          <h2>{h.steps.heading}</h2>
          <div class="intl-grid">
            {h.steps.items.map((s) => (
              <div class="intl-card">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            ))}
          </div>
          {/* Only trees with no market band carry this — /en alone today. It
              breaks the longest prose run without inventing the "here is your
              city" band that the x-default must not claim. Never priority:
              the LCP element on these trees is text. */}
          {support && (
            <div class="intl-support-image">
              <ImageBlock
                slug={support.slug}
                alt={support.alt}
                aspect="16 / 9"
                widths="(min-width: 981px) 1120px, 100vw"
                rounded
              />
            </div>
          )}
        </div>
      </section>

      <section class="cv-auto intl-band">
        <div class="wrap">
          <p class="eyebrow">{h.pilot.eyebrow}</p>
          <h2>{h.pilot.heading}</h2>
          <p class="lede">{h.pilot.body}</p>
          <ul class="intl-points">
            {h.pilot.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <div class="intl-ctas">
            <a class="btn" href={p("contact")}>{h.pilot.cta}</a>
          </div>
        </div>
      </section>

      {/* The strongest proof the AU home has, now on the market trees too.
          showDemo={false} is load-bearing: that link points at the AU booking
          app, which no global page may link to. */}
      {showCallSim && (
        <CallSim
          copy={c.callSim}
          productHref={p("products/voxtable")}
          showDemo={false}
        />
      )}

      {/* Trust principles + the facts strip (entity, AI disclosure, where the
          data goes, lawful basis) — TrustPanel derives every fact from
          site.ts/copy.ts rather than restating it here. */}
      <TrustPanel locale={locale} copy={c} />

      {/* NOT wrapped in .intl-band: the band and FAQ.astro's items are both
          var(--ink-1), so banding this would make every item vanish into the
          background. The item borders carry the structure instead. */}
      <section class="cv-auto intl-faq">
        <div class="wrap">
          <h2>{h.faq.heading}</h2>
          <FAQ items={h.faq.items} stagger />
        </div>
      </section>

      <section class="cv-auto intl-closing">
        <div class="wrap">
          <h2>{h.closing.heading}</h2>
          <p>{h.closing.body}</p>
          <div class="intl-ctas" style="justify-content: center;">
            <a class="btn" href={p("contact")}>{h.closing.cta}</a>
          </div>
        </div>
      </section>
    </>
  )}

  {page === "contact" && (
    <>
    <section class="intl-hero">
      <div class="wrap contact-grid">
        <div>
          <p class="eyebrow">{ct.eyebrow}</p>
          <h1>{ct.h1}</h1>
          <p class="lede">{ct.intro}</p>

          <form class="intl-form" method="post" action="/api/contact" data-astro-reload>
            {/* Honeypot — same contract as the AU form / Cloud Function. */}
            <p class="hp" aria-hidden="true">
              <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
            </p>
            {/* Every locale posts through the same Zoho CRM path — previously
                /en-only. Anything this form sends must stay in lockstep with
                the privacy + cookie policy disclosures (src/data/intl/copy.ts
                cores, markets.ts per-market privacy overrides).
                No CAPTCHA by design: Google reCAPTCHA was removed 3 Sep 2026 —
                it loaded before any consent on every EU/UK contact page and
                sent visitor IPs to Google. The honeypot plus the function's
                per-connection rate limit do that job now. */}
            <input type="hidden" name="crmForm" value="zoho-global" />
            {/* First-touch campaign attribution (utm fields + gclid), mirrored
                from the AU form: without it no UK/EU ad click can ever be
                joined to a lead. Filled from sessionStorage by the submit
                handler; first-party, travels only with the enquiry sent. */}
            <input type="hidden" name="attribution" value="" data-attribution />
            {/* Proof-of-interaction + dedupe key — same contract as the AU
                form (see contact.astro): formToken presence classifies the
                lead "ok" server-side; without it (direct scripted POSTs, the
                observed spam) the lead stores as "unverified" and never
                reaches Zoho or the ads-conversion export. leadRef doubles as
                the gtag conversion's transaction_id. */}
            <input type="hidden" name="formToken" value="" data-form-token />
            <input type="hidden" name="leadRef" value="" data-lead-ref />
            <div class="field">
              <label for="if-name">{ct.form.name}</label>
              <input id="if-name" name="name" type="text" required maxlength="200" autocomplete="name" />
            </div>
            <div class="field">
              <label for="if-email">{ct.form.email}</label>
              <input id="if-email" name="email" type="email" required maxlength="320" autocomplete="email" />
            </div>
            <div class="field">
              <label for="if-venue">{ct.form.venue}</label>
              <input id="if-venue" name="venue" type="text" required maxlength="200" autocomplete="organization" placeholder={ct.form.venuePlaceholder} />
            </div>
            <div class="field">
              <label for="if-product">{ct.form.product}</label>
              {/* No default selection — a visitor who skips this field should
                  fail validation, not get silently recorded as a VoxTable
                  enquiry (the previous /en-only markup pre-selected VoxTable). */}
              <select id="if-product" name="product" required>
                <option value="" disabled selected>{ct.form.productPlaceholder}</option>
                {/* Derived from the catalogue, as contact.astro does — this
                    list was hand-written and had already drifted once. */}
                {products.map((x) => (
                  <option value={x.slug}>{x.name}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="if-message">{ct.form.message}</label>
              <textarea id="if-message" name="message" required maxlength="4000" rows="5" placeholder={ct.form.messagePlaceholder}></textarea>
            </div>
            <button class="btn" type="submit">{ct.form.submit}</button>
            <p class="intl-form-status" role="status" aria-live="polite" hidden></p>
            <p class="muted form-note">{ct.form.note}</p>
          </form>
        </div>
        <aside class="intl-card contact-aside">
          {/* h2, not h3: this is the only heading on the page besides the h1,
              so an h3 skipped a level on all five contact pages — a real
              screen-reader defect that shipped because axe rates heading-order
              `moderate` and the AU suite gates only serious/critical. Sized
              back down to card scale in IntlLayout. */}
          <h2>{ct.aside.heading}</h2>
          <p>{ct.aside.body}</p>
          {/* The UK tree must offer the UK entity's own address: E-Commerce
              Regs 2002 reg 6(1)(c) requires an email address allowing rapid and
              direct communication, and a form does not satisfy it. It is also
              the domain-by-audience rule (CLAUDE.md) — international
              correspondence belongs on @biteperk.com, not the AU property.
              The other four trees keep c.email until their mailboxes are
              decided; that inconsistency predates this change. */}
          <p>
            <a class="link-arrow" href={isUk ? ukEmail.href : `mailto:${c.chrome.email}`}>
              {ct.aside.emailLabel}
            </a>
          </p>
          <SocialLinks label={c.chrome.footerFollow} />
          {/* Contact takes its photo in the aside, not under the intro: the
              page is a two-column grid, and a full-width band between the
              form fields would cut the form in half. */}
          {pageImage && (
            <div class="intl-page-image">
              <ImageBlock
                slug={pageImage.slug}
                alt={pageImage.alt[locale.copyLang]}
                aspect={pageImage.aspect}
                widths="(min-width: 981px) 360px, 100vw"
                rounded
              />
            </div>
          )}
        </aside>
      </div>
    </section>
    {/* The facts strip again on the page where someone is about to hand us
        their details: who they contract with and where the enquiry goes. */}
    <TrustPanel locale={locale} copy={c} variant="facts" />
    </>
  )}

  {simple && (
    <section class="intl-hero">
      <div class="wrap intl-prose">
        <p class="eyebrow">{simple.eyebrow}</p>
        <h1>{simple.h1}</h1>
        <p class="lede">{simple.intro}</p>
        {/* Breaks the prose run. Never `priority` — the LCP element on these
            trees is text, so prioritising an image only steals bandwidth from
            it. Legal pages deliberately get none (see page-images.ts). */}
        {pageImage && (
          <div class="intl-page-image">
            <ImageBlock
              slug={pageImage.slug}
              alt={pageImage.alt[locale.copyLang]}
              aspect={pageImage.aspect}
              widths="(min-width: 981px) 720px, 100vw"
              rounded
            />
          </div>
        )}
        {simple.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.body.map((para) => <p>{para}</p>)}
          </section>
        ))}
        {simple.cta && (
          <div class="intl-ctas">
            <a class="btn" href={p("contact")}>{simple.cta.label}</a>
            {simple.cta.sub && <p class="muted" style="align-self: center; margin: 0;">{simple.cta.sub}</p>}
          </div>
        )}
      </div>
    </section>
  )}

  {(page === "products" || product) && (
    <script is:inline type="application/ld+json" slot="jsonld" set:html={JSON.stringify(breadcrumbJsonLd)} />
  )}
  {cityServiceJsonLd && (
    <script is:inline type="application/ld+json" slot="jsonld" set:html={JSON.stringify(cityServiceJsonLd)} />
  )}
  {cityBreadcrumbJsonLd && (
    <script is:inline type="application/ld+json" slot="jsonld" set:html={JSON.stringify(cityBreadcrumbJsonLd)} />
  )}
  {faqJsonLd && (
    <script is:inline type="application/ld+json" slot="jsonld" set:html={JSON.stringify(faqJsonLd)} />
  )}
  {appJsonLd && (
    <script is:inline type="application/ld+json" slot="jsonld" set:html={JSON.stringify(appJsonLd)} />
  )}

  {page === "products" && (
    <>
      <section class="intl-hero">
        <div class="wrap">
          <p class="eyebrow">{overview.eyebrow}</p>
          <h1>{overview.h1}</h1>
          <p class="lede">{overview.lede}</p>
          {pageImage && (
            <div class="intl-page-image">
              <ImageBlock
                slug={pageImage.slug}
                alt={pageImage.alt[locale.copyLang]}
                aspect={pageImage.aspect}
                widths="(min-width: 981px) 1120px, 100vw"
                rounded
              />
            </div>
          )}
          <div class="intl-ctas">
            <a class="btn" href={p("contact")}>{overview.ctaLabel}</a>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap intl-prose">
          {overview.intro.map((para) => <p>{para}</p>)}
        </div>
      </section>

      <section class="cv-auto intl-band">
        <div class="wrap">
          <h2>{overview.capabilitiesHeading}</h2>
          {/* intl-caps-grid, not the plain intl-grid: five equal cards in an
              auto-fit grid laid 3+2 and left an orphan. The core capability
              spans the row and the four add-ons sit 2x2 beneath it, matching
              the AU /products/ page. */}
          <div class="intl-grid intl-caps-grid reveal reveal-stagger">
            {/* Catalogue ORDER and STATUS come from products.ts, so the core
                capability leads and nothing here can drift from the AU site's
                idea of what ships. */}
            {products.map((prod) => {
              const cap = overview.capabilities[prod.slug];
              const copy = intlProducts[locale.copyLang][prod.slug];
              return (
                <a class="intl-card intl-card-link" href={p(`products/${prod.slug}`)}>
                  <p class="status-pill" data-status={prod.status}>{copy.statusLabel}</p>
                  <h3>{prod.name}</h3>
                  <p class="cap-outcome">{cap.outcome}</p>
                  <p>{cap.body}</p>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section class="cv-auto">
        <div class="wrap intl-prose">
          <h2>{overview.pilotHeading}</h2>
          <p>{overview.pilotBody}</p>
          <div class="intl-ctas">
            <a class="btn" href={p("contact")}>{overview.ctaLabel}</a>
          </div>
        </div>
      </section>
    </>
  )}

  {product && catalogue && (
    <>
      <section class="intl-hero">
        <div class="wrap">
          <nav class="intl-crumbs" aria-label="Breadcrumb">
            <a href={p("")}>{c.chrome.nav.home}</a>
            <span aria-hidden="true">/</span>
            <a href={p("products")}>{c.chrome.nav.products}</a>
          </nav>
          <p class="eyebrow">{product.eyebrow}</p>
          <h1>{product.h1}</h1>
          <p class="lede">{product.lede}</p>
          <p class="status-pill" data-status={catalogue.status}>{product.statusLabel}</p>
          <p class="muted status-note">{product.statusNote}</p>
          <div class="intl-ctas">
            <a class="btn" href={p("contact")}>{product.ctaLabel}</a>
          </div>
          {productImage && (
            <div class="intl-page-image">
              <ImageBlock
                slug={productImage.slug}
                alt={productImage.alt[locale.copyLang]}
                aspect={productImage.aspect}
                widths="(min-width: 981px) 1120px, 100vw"
                rounded
              />
            </div>
          )}
        </div>
      </section>

      <section class="cv-auto intl-band">
        <div class="wrap">
          <h2>{product.featuresHeading}</h2>
          <div class="intl-grid">
            {product.features.map((f) => (
              <div class="intl-card">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="cv-auto">
        <div class="wrap intl-prose">
          <h2>{product.faqHeading}</h2>
          {product.faqs.map((f) => (
            <section>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </section>
          ))}
        </div>
      </section>

      <section class="cv-auto intl-closing">
        <div class="wrap">
          <h2>{product.ctaHeading}</h2>
          <div class="intl-ctas" style="justify-content: center;">
            <a class="btn" href={p("contact")}>{product.ctaLabel}</a>
          </div>
        </div>
      </section>
    </>
  )}

  {city && <CityBody locale={locale} city={city} />}
</IntlLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1.5fr) minmax(240px, 1fr);
    align-items: start;
  }
  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  .contact-aside { position: sticky; top: 96px; }

  .intl-market-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr 1fr;
    margin-top: var(--space-6);
  }
  @media (max-width: 720px) {
    .intl-market-grid { grid-template-columns: 1fr; }
  }
  /* Trees whose home carries the city-card grid render the band with ONE
     hospitality image (the cityscape moved into the cards) — full width. */
  .intl-market-grid-single { grid-template-columns: 1fr; }

  .intl-form { margin-top: var(--space-6); display: grid; gap: var(--space-5); max-width: 560px; }
  .intl-form .hp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
  .intl-form .field { display: grid; gap: var(--space-2); }
  .intl-form label { font-weight: 600; font-size: var(--fs-small); }
  .intl-form input,
  .intl-form select,
  .intl-form textarea {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--text);
    font: inherit;
    padding: 12px 14px;
  }
  .intl-form input:focus-visible,
  .intl-form select:focus-visible,
  .intl-form textarea:focus-visible {
    outline: none;
    border-color: var(--gold);
    box-shadow: var(--ring-focus);
  }
  .intl-form .btn { justify-self: start; }
  .intl-form-status {
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--mist-2);
  }
  .intl-form-status[hidden] { display: none; }
  .intl-form-status.is-error { color: var(--danger); }
  .intl-form-success h2 { margin-bottom: var(--space-3); }
  .form-note { font-size: var(--fs-small); margin: 0; }

  /* ── Product pages ────────────────────────────────────────────── */
  .intl-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    font-size: var(--fs-small);
    margin-bottom: 1rem;
    color: var(--mist);
  }
  .intl-crumbs a { color: var(--mist); text-decoration: none; }
  @media (hover: hover) {
    .intl-crumbs a:hover { color: var(--gold); }
  }
  .intl-crumbs a:focus-visible { outline: none; box-shadow: var(--ring-focus); border-radius: 4px; }

  /* Status is honest and load-bearing here: three of the five capabilities are
     not shipping. `--gold` (not --gold-fill) because this is text. */
  .status-pill {
    display: inline-block;
    margin: 0 0 0.5rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--mist-2);
  }
  .status-pill[data-status="live"] { color: var(--success); }
  .status-pill[data-status="in-development"] { color: var(--gold); }
  .status-note { max-width: 60ch; margin: 0 0 1.5rem; }

  .cap-outcome { font-weight: 600; color: var(--text); }

  /* The capability grid is a grid of LINKS — the whole card is the target, so
     it clears 44px on touch without a separate "read more". */
  .intl-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  @media (hover: hover) {
    .intl-card-link:hover { border-color: var(--gold); transform: translateY(-2px); }
  }
  .intl-card-link:focus-visible { outline: none; box-shadow: var(--ring-focus); }
  @media (prefers-reduced-motion: reduce) {
    .intl-card-link { transition: none; }
    .intl-card-link:hover { transform: none; }
  }

  /* City-page styles (.intl-city-*) live in components/intl/CityBody.astro
     and CityCards.astro as `is:inline` styles — rendered with the component,
     so only city pages (and the market home strip) carry them. Restating
     them here would inline them on every page of every tree. */
</style>

<script>
  import { googleAdsGlobalDemoContactConversionId } from "@/data/consent";
  import { reportGoogleAdsConversion } from "@/scripts/google-ads";

  (function () {
    function initGlobalContact(): void {
      // .intl-form only ever renders on a locale's contact page, so this is
      // already scoped correctly for all five locales without matching on
      // pathname (which used to hardcode "/en/contact" and silently skipped
      // gb-en/fr/be-en/be-fr).
      const form = document.querySelector<HTMLFormElement>(".intl-form");
      if (!form || form.dataset.enhanced === "1") return;
      form.dataset.enhanced = "1";

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLParagraphElement>(".intl-form-status");
      const buttonLabel = button?.textContent ?? "Request a pilot";
      let busy = false;

      // First-touch attribution (utm_*/gclid) captured by scripts/attribution.ts
      // into sessionStorage on every tree — the AU form has read it since the
      // consent work; this form never did, so UK ad clicks were unjoinable.
      try {
        const attrField = form.querySelector<HTMLInputElement>("[data-attribution]");
        const attr = sessionStorage.getItem("bp-attr");
        if (attrField && attr) attrField.value = attr.slice(0, 1000);
      } catch {
        /* no storage — attribution simply stays empty */
      }

      // Same proof-of-interaction + dedupe contract as contact.astro.
      const loadedAt = Date.now();
      const leadRef =
        typeof crypto !== "undefined" && "randomUUID" in crypto
          ? crypto.randomUUID()
          : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (busy) return;
        busy = true;

        // Filled at submit time (not init) so the token carries the real
        // dwell interval; the server only checks presence + shape.
        const tokenField = form.querySelector<HTMLInputElement>("[data-form-token]");
        if (tokenField) tokenField.value = btoa(`${loadedAt}:${Date.now()}`);
        const refField = form.querySelector<HTMLInputElement>("[data-lead-ref]");
        if (refField) refField.value = leadRef;

        if (status) {
          status.hidden = true;
          status.classList.remove("is-error");
        }
        if (button) {
          button.disabled = true;
          button.setAttribute("aria-busy", "true");
          button.textContent = "Sending…";
        }

        const payload: Record<string, string> = {};
        new FormData(form).forEach((value, key) => {
          payload[key] = typeof value === "string" ? value : "";
        });

        try {
          const response = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(payload),
          });
          const body = await response.json().catch(() => ({})) as { ok?: boolean; error?: string };

          if (response.ok && body.ok) {
            reportGoogleAdsConversion(googleAdsGlobalDemoContactConversionId, leadRef);
            document.dispatchEvent(new CustomEvent("bp:event", { detail: { name: "form-success" } }));
            form.innerHTML =
              '<div class="intl-form-success">' +
              "<h2>Thanks — we'll be in touch.</h2>" +
              "<p>Your request has reached the BitePerk team. We'll reply within a business day.</p>" +
              "</div>";
            return;
          }

          if (status) {
            status.textContent = body.error || "Sorry — something went wrong. Please try again.";
            status.classList.add("is-error");
            status.hidden = false;
          }
        } catch {
          if (status) {
            status.textContent = "Network error — please try again or email hello@biteperk.com.au.";
            status.classList.add("is-error");
            status.hidden = false;
          }
        } finally {
          busy = false;
          if (button && button.isConnected) {
            button.disabled = false;
            button.removeAttribute("aria-busy");
            button.textContent = buttonLabel;
          }
        }
      });
    }

    initGlobalContact();
    document.addEventListener("astro:page-load", initGlobalContact);
  })();
</script>
