---
import Base from "@/layouts/AuBase.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Cta from "@/components/Cta.astro";
import { solutions } from "@/data/solutions";
import { site } from "@/data/site";
import { u, abs } from "@/data/locales";

const path = "/solutions/";
const live = solutions.filter((s) => s.status === "live" || s.status === "draft");
const hospitality = live.filter((s) => s.sector === "hospitality");
const services = live.filter((s) => s.sector === "services");
const enterprise = live.filter((s) => s.sector === "enterprise");

const title = "Industry solutions · BitePerk";
const description =
  "AI phone automation by industry — restaurants, hotels, cafes, takeaway, drive-thru, medical, professional services, and enterprise groups.";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
    { "@type": "ListItem", position: 2, name: "Solutions", item: abs(path) },
  ],
};

---

<Base title={title} description={description} path={path}>
  <Fragment slot="jsonld">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <header class="sol-index-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: "Home", href: u("/") }, { label: "Solutions" }]} />
      <h1 class="sol-index-h">Solutions by industry</h1>
      <p class="sol-index-sub">
        People search for the job to be done — AI receptionist for restaurants, hotel phone overflow,
        takeaway ordering — not product codenames. Start with your vertical.
      </p>
      <div class="sol-index-cta">
        <a class="btn" href={u("/contact/?intent=demo")} data-cta="book-demo">Book Demo</a>
        <a class="btn-ghost" href={u("/products/")}>See products</a>
      </div>
    </div>
  </header>

  <section class="sol-index-section">
    <div class="wrap">
      <h2 class="sol-index-h2">Hospitality</h2>
      <div class="sol-index-grid">
        {hospitality.map((s) => (
          <a class="sol-card" href={u(`/solutions/${s.slug}/`)}>
            <h3>{s.name}</h3>
            <p>{s.shortDescription}</p>
            <span class="sol-card-go">View solution →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sol-index-section sol-index-band">
    <div class="wrap">
      <h2 class="sol-index-h2">Services</h2>
      <div class="sol-index-grid">
        {services.map((s) => (
          <a class="sol-card" href={u(`/solutions/${s.slug}/`)}>
            <h3>{s.name}</h3>
            <p>{s.shortDescription}</p>
            <span class="sol-card-go">View solution →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sol-index-section">
    <div class="wrap">
      <h2 class="sol-index-h2">Enterprise</h2>
      <div class="sol-index-grid">
        {enterprise.map((s) => (
          <a class="sol-card" href={u(`/solutions/${s.slug}/`)}>
            <h3>{s.name}</h3>
            <p>{s.shortDescription}</p>
            <span class="sol-card-go">View solution →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta
    eyebrow="Not sure which vertical?"
    headline="Book a demo and we will map your calls."
    lede="Bring a real overflow story — dinner rush, after-hours hotel line, multi-site group — and we will put the right Vox product on the conversation."
    primary={{ label: "Book Demo", href: u("/contact/?intent=demo") }}
    secondary={{ label: `Call ${site.phone.display}`, href: site.phone.href }}
  />
</Base>

<style>
  .sol-index-hero {
    padding: clamp(120px, 16vw, 180px) 0 clamp(56px, 7vw, 88px);
    border-bottom: 1px solid var(--line);
  }
  .sol-index-h {
    margin-top: 28px;
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--white);
    max-width: 14ch;
  }
  .sol-index-sub {
    margin-top: 20px;
    max-width: 60ch;
    color: var(--text);
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
  }
  .sol-index-cta {
    margin-top: 32px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .sol-index-section {
    padding-block: var(--space-section);
    border-bottom: 1px solid var(--line);
  }
  .sol-index-band {
    background: color-mix(in srgb, var(--ink) 92%, var(--white));
  }
  .sol-index-h2 {
    font-size: var(--fs-h3);
    font-weight: 800;
    color: var(--white);
  }
  .sol-index-grid {
    margin-top: 28px;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .sol-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    min-height: 100%;
  }
  .sol-card:hover {
    border-color: color-mix(in srgb, var(--white) 35%, var(--line));
  }
  .sol-card h3 {
    color: var(--white);
    font-weight: 700;
  }
  .sol-card p {
    color: var(--text);
    flex: 1;
  }
  .sol-card-go {
    color: var(--mist);
    font-size: var(--fs-small);
  }
</style>
