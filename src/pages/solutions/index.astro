---
import Base from "@/layouts/AuBase.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SolutionCard from "@/components/SolutionCard.astro";
import ConversionTrust from "@/components/conversion/ConversionTrust.astro";
import FAQ from "@/components/FAQ.astro";
import Cta from "@/components/Cta.astro";
import { solutions, solutionPath, HUB_FAQ } from "@/data/solutions";
import { site, pageTitle } from "@/data/site";
import { buildCollectionPage, buildFaqPage } from "@/data/schema";
import { u } from "@/data/locales";
import { bookDemoHref, CTA_LABELS, defaultCtaActions } from "@/data/conversion";

const path = "/solutions/";
// The verticals worth linking: live pages (live/draft status). Grouped by sector.
const live = solutions.filter((s) => s.status === "live" || s.status === "draft");
const groups = [
  { key: "hospitality", heading: "Hospitality", lede: "Where the phone rings mid-service and a missed call is a table gone.", items: live.filter((s) => s.sector === "hospitality") },
  { key: "services", heading: "Services", lede: "After-hours and overflow lines that a person cannot always reach in time.", items: live.filter((s) => s.sector === "services") },
  { key: "enterprise", heading: "Multi-site", lede: "One voice standard and central visibility across every venue you run.", items: live.filter((s) => s.sector === "enterprise") },
].filter((g) => g.items.length > 0);

const title = pageTitle("Solutions by industry");
const description =
  "AI phone answering by industry — restaurants, hotels, cafes, takeaway, drive-thru, medical, professional services and multi-site groups. Live in Australia.";

const collectionJsonLd = buildCollectionPage({
  path,
  name: title,
  description,
  items: live.map((s) => ({ name: s.name, path: solutionPath(s.slug) })),
  inLanguage: "en-AU",
});
const faqJsonLd = buildFaqPage(HUB_FAQ, "en-AU");
const cta = defaultCtaActions();
---

<Base title={title} description={description} path={path} ogImage="/og/solutions/index.png">
  <Fragment slot="jsonld">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <header class="sol-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ label: "Home", href: u("/") }, { label: "Solutions" }]} label="Breadcrumb" />
      <p class="sol-eyebrow">Solutions</p>
      <h1 class="sol-h1">Built for your kind of venue.</h1>
      <p class="sol-sub">
        One AI phone host, framed for how your calls actually come in — bookings during
        the dinner rush, the after-hours hotel line, takeaway at the pass. Pick your
        vertical, or talk to us about your own.
      </p>
      <div class="sol-hero-cta">
        <a class="btn" href={bookDemoHref()} data-cta="book-demo">{CTA_LABELS.bookDemo}</a>
        <a class="btn-ghost" href={u("/technology/")}>See how it works</a>
      </div>
      <ConversionTrust class="sol-hero-trust" />
    </div>
  </header>

  {groups.map((g) => (
    <section class="sol-section">
      <div class="wrap">
        <div class="sol-section-head">
          <h2>{g.heading}</h2>
          <p>{g.lede}</p>
        </div>
        <div class="sol-grid">
          {g.items.map((s) => <SolutionCard solution={s} />)}
        </div>
      </div>
    </section>
  ))}

  <section class="sol-faq">
    <div class="wrap wrap-narrow">
      <h2 class="sol-faq-h">Questions before you pick one</h2>
      <FAQ items={HUB_FAQ} />
    </div>
  </section>

  <Cta
    eyebrow="Not sure where you fit?"
    headline="Book a demo and we will map your calls."
    lede="Bring a real overflow story — the dinner rush, an after-hours hotel line, a multi-site group — and we will put the right Vox product on the conversation."
    primary={cta.primary}
    secondary={{ label: `Call ${site.phone.display}`, href: site.phone.href }}
  />
</Base>

<style>
  .sol-hero {
    padding: clamp(120px, 16vw, 180px) 0 clamp(48px, 6vw, 72px);
    border-bottom: 1px solid var(--line);
  }
  .sol-eyebrow {
    margin-top: 28px;
    color: var(--gold);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sol-h1 {
    margin-top: 12px;
    font-size: var(--fs-h1);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--white);
    max-width: 16ch;
  }
  .sol-sub {
    margin-top: 20px;
    max-width: 58ch;
    color: var(--text);
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
  }
  .sol-hero-cta {
    margin-top: 32px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .sol-hero-trust { margin-top: 24px; }

  .sol-section {
    padding-block: clamp(48px, 7vw, 88px);
    border-bottom: 1px solid var(--line);
  }
  .sol-section-head h2 {
    font-size: var(--fs-h3);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .sol-section-head p {
    margin-top: 8px;
    max-width: 52ch;
    color: var(--text);
  }
  .sol-grid {
    margin-top: 28px;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 980px) {
    .sol-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .sol-grid { grid-template-columns: 1fr; }
  }

  .sol-faq {
    padding-block: clamp(48px, 7vw, 88px);
    border-bottom: 1px solid var(--line);
  }
  .wrap-narrow { max-width: 760px; }
  .sol-faq-h {
    font-size: var(--fs-h3);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--white);
    margin-bottom: 24px;
  }
</style>
