---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

const title = "Biteperk — voice + AI tools for hospitality";
---

<Base title={title} description={site.description} path="/" preloadImage="/bella/portrait.png">
  <!-- HERO -->
  <header class="hero">
    <div class="hero-stage" aria-hidden="true">
      <div class="hero-stage-grid"></div>
      <div class="hero-stage-glow"></div>
    </div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="pill">
          <span class="dot"></span>
          Sydney, Australia
        </span>
        <h1 class="hero-title">
          We build <span class="gold">voice + AI</span><br />
          for hospitality.
        </h1>
        <p class="sub">
          Restaurants and venues lose bookings every day to a phone that nobody can pick up.
          Biteperk fixes that — one product at a time. Made in Sydney, deployed in Sydney,
          answering Sydney calls.
        </p>
        <div class="hero-cta">
          <a class="btn" href={site.vocotableUrl} rel="noopener">Meet VocoTable →</a>
          <a class="btn-ghost" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="hero-visual">
        <figure class="hero-card">
          <div class="hero-card-halo" aria-hidden="true"></div>
          <img
            src="/bella/portrait.png"
            alt="Bella, the AI phone host built by Biteperk"
            class="hero-card-img"
            width="640"
            height="800"
            fetchpriority="high"
          />
          <figcaption class="hero-card-caption">
            <span class="hero-card-caption-dot" aria-hidden="true"></span>
            Live · 24/7
          </figcaption>
        </figure>
      </div>
    </div>
    <div class="wrap hero-stats">
      <div>
        <div class="stat-n">1</div>
        <div class="stat-l">live product</div>
      </div>
      <span class="stat-divider" aria-hidden="true"></span>
      <div>
        <div class="stat-n">24/7</div>
        <div class="stat-l">always on the line</div>
      </div>
      <span class="stat-divider" aria-hidden="true"></span>
      <div>
        <div class="stat-n">AU</div>
        <div class="stat-l">data stays local</div>
      </div>
    </div>
  </header>

  <!-- MISSION -->
  <section class="mission">
    <div class="wrap">
      <div class="mission-grid reveal">
        <div class="eyebrow">Our craft</div>
        <h2>
          Hospitality lives in the details.
          <br />
          <span class="mist">So does our software.</span>
        </h2>
        <p class="mission-detail">
          We build a small, careful catalogue of voice and AI tools that solve real
          front-of-house problems. No buzzword roadmaps, no platform pitches. Just software
          that helps restaurant teams keep doing what they do best — taking care of guests —
          while the unglamorous bits (the phone, the bookings, the no-shows) take care of
          themselves.
        </p>
      </div>
    </div>
  </section>

  <!-- PRODUCT SHOWCASE -->
  <section class="product" id="products">
    <div class="wrap">
      <div class="reveal">
        <div class="product-eyebrow-row">
          <span class="dot" aria-hidden="true"></span>
          <span class="eyebrow">Currently shipping</span>
        </div>
        <h2>
          One product live today.
          <br />
          <span class="gold">More on the way.</span>
        </h2>
        <p class="product-lead">
          We'd rather ship one product brilliantly than ten products vaguely. Here's the first.
        </p>
      </div>

      <a
        class="product-card-v2 reveal"
        href={site.vocotableUrl}
        rel="noopener"
        aria-label="Visit VocoTable"
      >
        <div>
          <div class="product-name">
            <span class="voco">Voco</span><span class="table">Table</span>
          </div>
          <div class="product-tagline">The AI phone host for restaurants</div>
          <p class="product-desc">
            Bella picks up every call in a warm Australian voice, checks live table
            availability, and books the reservation while your team stays on the floor.
            Twenty-four hours a day. No menus, no hold music, no missed Friday nights.
          </p>
          <div class="product-feats">
            <div class="product-feat">
              <span class="check">✓</span>
              Unlimited inbound calls answered, 24/7
            </div>
            <div class="product-feat">
              <span class="check">✓</span>
              Live booking into your dashboard, no double-bookings
            </div>
            <div class="product-feat">
              <span class="check">✓</span>
              $80/month flat. No per-cover fees. No lock-in.
            </div>
            <div class="product-feat">
              <span class="check">✓</span>
              Local Sydney support, your data stays in Australia
            </div>
          </div>
          <div class="product-cta-row">
            <span class="btn">Visit VocoTable →</span>
            <span class="product-url-chip">vocotable.biteperk.com.au</span>
          </div>
        </div>
        <div class="product-visual">
          <div class="product-card-frame">
            <div class="halo" aria-hidden="true"></div>
            <img
              src="/bella/portrait.png"
              alt="Bella, the VocoTable voice agent"
              width="520"
              height="650"
              loading="lazy"
            />
            <span class="caption">
              <span class="caption-dot" aria-hidden="true"></span>
              Meet Bella
            </span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- SYDNEY -->
  <section class="sydney">
    <div class="sydney-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="sydney-grid">
        <div class="reveal">
          <div class="eyebrow">Sydney, end to end</div>
          <h2>
            Built here.
            <br />
            <span class="gold">Answered here.</span>
          </h2>
          <p class="sydney-body">
            Every line of Biteperk code is written, deployed and supported from Sydney. Our
            servers live in Australian data centres, the phone numbers are Australian, and the
            voice that greets your guests sounds like one of them. We're an AI company that
            behaves like a neighbourhood business — because the restaurants we serve are
            neighbourhood businesses too.
          </p>
          <div class="sydney-meta">
            <div>
              <div class="meta-n">100%</div>
              <div class="meta-l">made in Sydney</div>
            </div>
            <div>
              <div class="meta-n">AU</div>
              <div class="meta-l">data residency</div>
            </div>
            <div>
              <div class="meta-n">9 am – 9 pm</div>
              <div class="meta-l">human support, AEST</div>
            </div>
          </div>
        </div>
        <div class="reveal">
          <div class="sydney-card">
            <div class="sydney-card-title">Why this matters for restaurants</div>
            <p class="sydney-card-text">
              AI built for a different market tends to feel that way. Bella was trained on
              Australian English from the start, knows what BYO means, doesn't ask for a zip
              code, and gets "tomorrow night, eight o'clock for four" without three rounds of
              confirmation.
            </p>
            <div class="sydney-card-list">
              <div class="sydney-card-list-item">Natural AU accent, not localised offshore</div>
              <div class="sydney-card-list-item">Sydney suburbs spelt and pronounced right</div>
              <div class="sydney-card-list-item">Privacy Act compliant, hosted in AU</div>
              <div class="sydney-card-list-item">Direct phone support during service hours</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="testimonial">
    <div class="wrap">
      <div class="testimonial-card reveal">
        <div class="testimonial-quote-mark">“</div>
        <p class="testimonial-quote">
          We used to lose tables every Friday night just because nobody could reach the phone.
          Bella picks up every single call — and the bookings just appear on our screen. It
          paid for itself in the first week.
        </p>
        <div class="testimonial-author">
          <div class="testimonial-author-av">N</div>
          <div>
            <div class="testimonial-author-name">Natalia</div>
            <div class="testimonial-author-role">Owner · Natalia's Bistro, Sydney</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA / CONTACT -->
  <section class="cta" id="contact">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="wrap">
      <span class="pill">
        <span class="dot"></span>
        Talk to a human
      </span>
      <h2 class="cta-headline">Let's see what we can build for your venue.</h2>
      <p class="cta-lead">
        We work with a small number of restaurants at a time. If you want to talk — about
        VocoTable, about a future product, or just about the missed-call problem — say hello.
      </p>
      <div class="cta-actions">
        <a class="btn" href={site.phone.href} data-cta="bella-call">
          Call us · {site.phone.display}
        </a>
        <a class="btn-ghost" href={site.email.href}>Email hello@biteperk.com.au</a>
      </div>
      <div class="cta-bar">
        <div class="cta-bar-cell">
          <div class="cta-bar-cell-label">Call</div>
          <div class="cta-bar-cell-value">
            <a href={site.phone.href}>{site.phone.display}</a>
          </div>
        </div>
        <div class="cta-bar-cell">
          <div class="cta-bar-cell-label">Email</div>
          <div class="cta-bar-cell-value">
            <a href={site.email.href}>{site.email.display}</a>
          </div>
        </div>
        <div class="cta-bar-cell">
          <div class="cta-bar-cell-label">Product</div>
          <div class="cta-bar-cell-value">
            <a href={site.vocotableUrl} rel="noopener">vocotable.biteperk.com.au</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /*
   * Home-page-only styles. These selectors are page-specific and aren't
   * worth promoting to global utilities yet. `is:global` is used because
   * Astro's scoped-style class hashes can interact awkwardly with the JS
   * scroll-reveal observer scanning for `.reveal`; this stays explicit.
   */

  /* HERO */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 130px 0 100px;
    overflow: hidden;
  }
  .hero-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-stage-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 60% at 80% 40%, rgba(245, 196, 24, 0.16), transparent 70%),
      radial-gradient(40% 50% at 20% 70%, rgba(26, 77, 26, 0.35), transparent 70%);
  }
  .hero-stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
    opacity: 0.4;
  }
  .hero .wrap {
    position: relative;
    z-index: 1;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 88px;
    align-items: center;
  }
  .hero-text {
    max-width: 600px;
  }
  .hero-title {
    font-size: clamp(56px, 7vw, 104px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -3.2px;
    margin: 22px 0 26px;
  }
  .hero-title .gold {
    color: var(--bp-gold);
  }
  .sub {
    font-size: 19px;
    line-height: 1.6;
    color: #d5d9e0;
    max-width: 520px;
    font-weight: 400;
  }
  .hero-cta {
    margin-top: 38px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* HERO VISUAL — framed Bella portrait card */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--bp-surface);
    box-shadow:
      0 32px 80px -20px rgba(0, 0, 0, 0.75),
      0 10px 28px -8px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.5s ease;
    isolation: isolate;
  }
  .hero-card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 40px 100px -20px rgba(0, 0, 0, 0.8),
      0 16px 38px -8px rgba(245, 196, 24, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  .hero-card-halo {
    position: absolute;
    inset: -22%;
    z-index: -1;
    background:
      radial-gradient(45% 45% at 60% 50%, rgba(245, 196, 24, 0.32), transparent 65%),
      radial-gradient(50% 50% at 30% 70%, rgba(26, 77, 26, 0.45), transparent 70%);
    filter: blur(34px);
  }
  .hero-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% center;
    transform: scale(1.45);
    transform-origin: 78% 58%;
  }
  .hero-card-caption {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    border-radius: 100px;
    background: rgba(10, 11, 13, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 11.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 600;
    color: #f0f2f6;
  }
  .hero-card-caption-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bp-gold);
    box-shadow: 0 0 14px var(--bp-gold);
    animation: bp-pulse 2.4s ease-in-out infinite;
  }

  /* HERO STATS */
  .hero-stats {
    position: relative;
    z-index: 1;
    margin-top: 96px;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    column-gap: 32px;
    width: 100%;
  }
  .stat-n {
    font-size: clamp(28px, 2.6vw, 38px);
    font-weight: 700;
    color: #fff;
    letter-spacing: -1.4px;
    line-height: 1;
  }
  .stat-l {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bp-mist);
    margin-top: 12px;
    font-weight: 500;
  }
  .stat-divider {
    width: 1px;
    height: 44px;
    background: var(--bp-line);
  }

  /* MISSION */
  .mission {
    padding: 140px 0 120px;
    background: var(--bp-ink);
    position: relative;
    border-top: 1px solid var(--bp-line);
  }
  .mission-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 980px;
    margin: 0 auto;
  }
  .mission .eyebrow {
    margin-bottom: 28px;
  }
  .mission h2 {
    font-size: clamp(40px, 5.4vw, 72px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -2.2px;
  }
  .mission h2 .mist {
    color: var(--bp-mist);
  }
  .mission-detail {
    margin-top: 36px;
    font-size: 17px;
    line-height: 1.7;
    color: #d5d9e0;
    max-width: 640px;
  }

  /* PRODUCT SHOWCASE */
  .product {
    padding: 130px 0;
    background: linear-gradient(180deg, var(--bp-ink) 0%, var(--bp-ink2) 100%);
    border-top: 1px solid var(--bp-line);
    position: relative;
    overflow: hidden;
  }
  .product-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }
  .product-eyebrow-row .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bp-gold);
    box-shadow: 0 0 14px var(--bp-gold);
    animation: bp-pulse 2.6s ease-in-out infinite;
  }
  .product h2 {
    font-size: clamp(40px, 5.4vw, 72px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -2.4px;
  }
  .product h2 .gold {
    color: var(--bp-gold);
  }
  .product-lead {
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--bp-mist-2);
    max-width: 640px;
  }
  .product-card-v2 {
    margin-top: 64px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 80px;
    align-items: center;
    padding: 56px 64px;
    border: 1px solid var(--bp-line);
    border-radius: 28px;
    background:
      linear-gradient(160deg, rgba(245, 196, 24, 0.05), transparent 60%),
      var(--bp-surface);
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
  }
  .product-name {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-size: clamp(36px, 4.2vw, 56px);
    font-weight: 800;
    letter-spacing: -1.6px;
    line-height: 1;
  }
  .product-name .voco {
    color: #fff;
  }
  .product-name .table {
    color: var(--bp-mist);
    font-weight: 300;
  }
  .product-tagline {
    margin-top: 12px;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bp-gold);
    font-weight: 600;
  }
  .product-desc {
    margin-top: 26px;
    font-size: 17px;
    line-height: 1.65;
    color: #d5d9e0;
    max-width: 480px;
  }
  .product-feats {
    margin-top: 26px;
    display: grid;
    gap: 14px;
    max-width: 480px;
  }
  .product-feat {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    color: #d5d9e0;
  }
  .product-feat .check {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(245, 196, 24, 0.14);
    color: var(--bp-gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 13px;
    margin-top: 1px;
  }
  .product-cta-row {
    margin-top: 38px;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .product-url-chip {
    font-size: 13px;
    letter-spacing: 0.5px;
    color: var(--bp-mist);
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, monospace;
  }

  /* Product portrait card */
  .product-visual {
    position: relative;
  }
  .product-card-frame {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4 / 5;
    margin-left: auto;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--bp-surface);
    box-shadow:
      0 30px 70px -20px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    isolation: isolate;
  }
  .product-card-frame .halo {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(50% 50% at 60% 50%, rgba(245, 196, 24, 0.32), transparent 65%);
    filter: blur(36px);
  }
  .product-card-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% center;
    transform: scale(1.45);
    transform-origin: 78% 58%;
  }
  .product-card-frame .caption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 100px;
    background: rgba(10, 11, 13, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 600;
    color: #f0f2f6;
  }
  .product-card-frame .caption-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bp-gold);
    box-shadow: 0 0 12px var(--bp-gold);
    animation: bp-pulse 2.4s ease-in-out infinite;
  }

  /* SYDNEY */
  .sydney {
    padding: 130px 0;
    position: relative;
    background: var(--bp-ink);
    overflow: hidden;
    border-top: 1px solid var(--bp-line);
  }
  .sydney-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(50% 60% at 50% 40%, rgba(26, 77, 26, 0.35), transparent 70%);
  }
  .sydney .wrap {
    position: relative;
    z-index: 1;
  }
  .sydney-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 72px;
    align-items: center;
  }
  .sydney h2 {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -2px;
  }
  .sydney h2 .gold {
    color: var(--bp-gold);
  }
  .sydney-body {
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.7;
    color: #d5d9e0;
  }
  .sydney-meta {
    margin-top: 38px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 22px;
  }
  .sydney-meta .meta-n {
    font-size: 28px;
    font-weight: 700;
    color: var(--bp-gold);
    letter-spacing: -1px;
    line-height: 1;
  }
  .sydney-meta .meta-l {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bp-mist);
