---
import StarMark from "../components/StarMark.astro";

const title = "Biteperk — voice + AI tools for hospitality";
const description =
  "Biteperk builds VocoTable, the AI phone host for restaurants. Bella answers every call 24/7 in a natural Australian voice and books the table. Made in Sydney.";
const url = "https://biteperk.com.au";
const phone = "0450 011 140";
const phoneHref = "tel:+61450011140";
const email = "hello@biteperk.com.au";
const emailHref = "mailto:hello@biteperk.com.au";
const vocotableUrl = "https://vocotable.biteperk.com.au";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/bella/portrait.png" />
    <style is:global>
      :root {
        --bp-ink: #0a0b0d;
        --bp-ink2: #0e1014;
        --bp-surface: #14171c;
        --bp-surface-elev: #181c22;
        --bp-green-deep: #0e2f12;
        --bp-green: #1a4d1a;
        --bp-green-light: #4a8a48;
        --bp-gold: #f5c418;
        --bp-gold-amber: #ffb840;
        --bp-gold-dark: #d9aa0e;
        --bp-white: #ffffff;
        --bp-mist: #9aa1ad;
        --bp-mist-2: #b8bec8;
        --bp-line: rgba(255, 255, 255, 0.08);
        --bp-line-strong: rgba(255, 255, 255, 0.14);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background: var(--bp-ink);
        color: var(--bp-white);
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .reveal.is-in {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal,
        .reveal.is-in {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
    <style>
      .wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 28px;
      }

      /* NAV */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        background: rgba(10, 11, 13, 0.65);
        border-bottom: 1px solid transparent;
        transition:
          border-color 0.3s ease,
          background 0.3s ease;
      }
      .nav.scrolled {
        background: rgba(10, 11, 13, 0.95);
        border-bottom: 1px solid var(--bp-line);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: default;
      }
      .brand-name {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.4px;
      }
      .brand-name .perk {
        color: var(--bp-gold);
        font-style: italic;
        font-weight: 700;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .lnk {
        font-size: 14px;
        font-weight: 500;
        color: #c0c5ce;
        padding: 10px 14px;
        transition: color 0.2s;
      }
      .lnk:hover {
        color: #fff;
      }

      /* BUTTONS */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: linear-gradient(135deg, var(--bp-gold), var(--bp-gold-dark));
        color: #1a0f04;
        padding: 14px 26px;
        border-radius: 100px;
        font-weight: 700;
        font-size: 15px;
        border: none;
        cursor: pointer;
        font-family: inherit;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
        box-shadow: 0 8px 28px rgba(245, 196, 24, 0.18);
      }
      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 38px rgba(245, 196, 24, 0.32);
      }
      .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #fff;
        padding: 14px 26px;
        border-radius: 100px;
        font-weight: 600;
        font-size: 15px;
        background: transparent;
        cursor: pointer;
        font-family: inherit;
        transition:
          background 0.2s,
          border-color 0.2s;
      }
      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.35);
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        border: 1px solid var(--bp-line);
        border-radius: 100px;
        padding: 8px 16px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #e6e9ee;
        background: rgba(255, 255, 255, 0.03);
      }
      .pill .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--bp-gold);
        box-shadow: 0 0 12px var(--bp-gold);
        animation: bp-pulse 2.6s ease-in-out infinite;
      }

      @keyframes bp-pulse {
        0%,
        100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: 0.55;
          transform: scale(0.86);
        }
      }

      .eyebrow {
        font-size: 13px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--bp-gold);
        font-weight: 600;
      }

      /* HERO */
      .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 130px 0 100px;
        overflow: hidden;
      }
      .hero-stage {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
      }
      .hero-stage-glow {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(50% 60% at 80% 40%, rgba(245, 196, 24, 0.16), transparent 70%),
          radial-gradient(40% 50% at 20% 70%, rgba(26, 77, 26, 0.35), transparent 70%);
      }
      .hero-stage-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 80px 80px;
        mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
        opacity: 0.4;
      }
      .hero .wrap {
        position: relative;
        z-index: 1;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: 88px;
        align-items: center;
      }
      .hero-text {
        max-width: 600px;
      }
      .hero-title {
        font-size: clamp(56px, 7vw, 104px);
        font-weight: 800;
        line-height: 0.98;
        letter-spacing: -3.2px;
        margin: 22px 0 26px;
      }
      .hero-title .gold {
        color: var(--bp-gold);
      }
      .sub {
        font-size: 19px;
        line-height: 1.6;
        color: #d5d9e0;
        max-width: 520px;
        font-weight: 400;
      }
      .hero-cta {
        margin-top: 38px;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }

      /* HERO VISUAL — framed Bella portrait card */
      .hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .hero-card {
        position: relative;
        width: 100%;
        max-width: 480px;
        aspect-ratio: 4 / 5;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: var(--bp-surface);
        box-shadow:
          0 32px 80px -20px rgba(0, 0, 0, 0.75),
          0 10px 28px -8px rgba(0, 0, 0, 0.5),
          inset 0 1px 0 rgba(255, 255, 255, 0.07);
        transition:
          transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
          box-shadow 0.5s ease;
        isolation: isolate;
      }
      .hero-card:hover {
        transform: translateY(-6px);
        box-shadow:
          0 40px 100px -20px rgba(0, 0, 0, 0.8),
          0 16px 38px -8px rgba(245, 196, 24, 0.18),
          inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }
      .hero-card-halo {
        position: absolute;
        inset: -22%;
        z-index: -1;
        background:
          radial-gradient(45% 45% at 60% 50%, rgba(245, 196, 24, 0.32), transparent 65%),
          radial-gradient(50% 50% at 30% 70%, rgba(26, 77, 26, 0.45), transparent 70%);
        filter: blur(34px);
      }
      .hero-card-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 100% center;
        transform: scale(1.45);
        transform-origin: 78% 58%;
      }
      .hero-card-caption {
        position: absolute;
        left: 18px;
        bottom: 18px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 14px;
        border-radius: 100px;
        background: rgba(10, 11, 13, 0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 11.5px;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        font-weight: 600;
        color: #f0f2f6;
      }
      .hero-card-caption-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--bp-gold);
        box-shadow: 0 0 14px var(--bp-gold);
        animation: bp-pulse 2.4s ease-in-out infinite;
      }

      /* HERO STATS */
      .hero-stats {
        position: relative;
        z-index: 1;
        margin-top: 96px;
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        column-gap: 32px;
        width: 100%;
      }
      .stat-n {
        font-size: clamp(28px, 2.6vw, 38px);
        font-weight: 700;
        color: #fff;
        letter-spacing: -1.4px;
        line-height: 1;
      }
      .stat-l {
        font-size: 11.5px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--bp-mist);
        margin-top: 12px;
        font-weight: 500;
      }
      .stat-divider {
        width: 1px;
        height: 44px;
        background: var(--bp-line);
      }

      /* MISSION — bold typographic statement */
      .mission {
        padding: 140px 0 120px;
        background: var(--bp-ink);
        position: relative;
        border-top: 1px solid var(--bp-line);
      }
      .mission-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        max-width: 980px;
        margin: 0 auto;
      }
      .mission .eyebrow {
        margin-bottom: 28px;
      }
      .mission h2 {
        font-size: clamp(40px, 5.4vw, 72px);
        font-weight: 800;
        line-height: 1.04;
        letter-spacing: -2.2px;
      }
      .mission h2 .mist {
        color: var(--bp-mist);
      }
      .mission-detail {
        margin-top: 36px;
        font-size: 17px;
        line-height: 1.7;
        color: #d5d9e0;
        max-width: 640px;
      }

      /* PRODUCT SHOWCASE */
      .product {
        padding: 130px 0;
        background: linear-gradient(180deg, var(--bp-ink) 0%, var(--bp-ink2) 100%);
        border-top: 1px solid var(--bp-line);
        position: relative;
        overflow: hidden;
      }
      .product-eyebrow-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
      }
      .product-eyebrow-row .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--bp-gold);
        box-shadow: 0 0 14px var(--bp-gold);
        animation: bp-pulse 2.6s ease-in-out infinite;
      }
      .product h2 {
        font-size: clamp(40px, 5.4vw, 72px);
        font-weight: 800;
        line-height: 1.02;
        letter-spacing: -2.4px;
      }
      .product h2 .gold {
        color: var(--bp-gold);
      }
      .product-lead {
        margin-top: 24px;
        font-size: 18px;
        line-height: 1.6;
        color: var(--bp-mist-2);
        max-width: 640px;
      }
      .product-card-v2 {
        margin-top: 64px;
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: 80px;
        align-items: center;
        padding: 56px 64px;
        border: 1px solid var(--bp-line);
        border-radius: 28px;
        background:
          linear-gradient(160deg, rgba(245, 196, 24, 0.05), transparent 60%),
          var(--bp-surface);
        box-shadow:
          0 30px 80px -30px rgba(0, 0, 0, 0.6),
          inset 0 1px 0 rgba(255, 255, 255, 0.05);
        position: relative;
      }
      .product-name {
        display: flex;
        align-items: baseline;
        gap: 4px;
        font-size: clamp(36px, 4.2vw, 56px);
        font-weight: 800;
        letter-spacing: -1.6px;
        line-height: 1;
      }
      .product-name .voco {
        color: #fff;
      }
      .product-name .table {
        color: var(--bp-mist);
        font-weight: 300;
      }
      .product-tagline {
        margin-top: 12px;
        font-size: 14px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--bp-gold);
        font-weight: 600;
      }
      .product-desc {
        margin-top: 26px;
        font-size: 17px;
        line-height: 1.65;
        color: #d5d9e0;
        max-width: 480px;
      }
      .product-feats {
        margin-top: 26px;
        display: grid;
        gap: 14px;
        max-width: 480px;
      }
      .product-feat {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 15px;
        color: #d5d9e0;
      }
      .product-feat .check {
        flex: 0 0 22px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: rgba(245, 196, 24, 0.14);
        color: var(--bp-gold);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 13px;
        margin-top: 1px;
      }
      .product-cta-row {
        margin-top: 38px;
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
      }
      .product-url-chip {
        font-size: 13px;
        letter-spacing: 0.5px;
        color: var(--bp-mist);
        font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, monospace;
      }

      /* Product portrait card (reused style) */
      .product-visual {
        position: relative;
      }
      .product-card-frame {
        position: relative;
        width: 100%;
        max-width: 440px;
        aspect-ratio: 4 / 5;
        margin-left: auto;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: var(--bp-surface);
        box-shadow:
          0 30px 70px -20px rgba(0, 0, 0, 0.7),
          inset 0 1px 0 rgba(255, 255, 255, 0.06);
        isolation: isolate;
      }
      .product-card-frame .halo {
        position: absolute;
        inset: -20%;
        z-index: -1;
        background:
          radial-gradient(50% 50% at 60% 50%, rgba(245, 196, 24, 0.32), transparent 65%);
        filter: blur(36px);
      }
      .product-card-frame img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 100% center;
        transform: scale(1.45);
        transform-origin: 78% 58%;
      }
      .product-card-frame .caption {
        position: absolute;
        left: 16px;
        bottom: 16px;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 100px;
        background: rgba(10, 11, 13, 0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 11px;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        font-weight: 600;
        color: #f0f2f6;
      }
      .product-card-frame .caption-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--bp-gold);
        box-shadow: 0 0 12px var(--bp-gold);
        animation: bp-pulse 2.4s ease-in-out infinite;
      }

      /* SYDNEY — local craft section */
      .sydney {
        padding: 130px 0;
        position: relative;
        background: var(--bp-ink);
        overflow: hidden;
        border-top: 1px solid var(--bp-line);
      }
      .sydney-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(50% 60% at 50% 40%, rgba(26, 77, 26, 0.35), transparent 70%);
      }
      .sydney .wrap {
        position: relative;
        z-index: 1;
      }
      .sydney-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 72px;
        align-items: center;
      }
      .sydney h2 {
        font-size: clamp(40px, 5vw, 64px);
        font-weight: 800;
        line-height: 1.04;
        letter-spacing: -2px;
      }
      .sydney h2 .gold {
        color: var(--bp-gold);
      }
      .sydney-body {
        margin-top: 28px;
        font-size: 17px;
        line-height: 1.7;
        color: #d5d9e0;
      }
      .sydney-meta {
        margin-top: 38px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 22px;
      }
      .sydney-meta .meta-n {
        font-size: 28px;
        font-weight: 700;
        color: var(--bp-gold);
        letter-spacing: -1px;
        line-height: 1;
      }
      .sydney-meta .meta-l {
        font-size: 11.5px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--bp-mist);
        margin-top: 8px;
        font-weight: 500;
      }
      .sydney-card {
        position: relative;
        border-radius: 24px;
        padding: 56px 48px;
        border: 1px solid var(--bp-line);
        background: linear-gradient(160deg, rgba(26, 77, 26, 0.18), var(--bp-surface) 70%);
        box-shadow:
          0 24px 60px -20px rgba(0, 0, 0, 0.55),
          inset 0 1px 0 rgba(255, 255, 255, 0.05);
      }
      .sydney-card-title {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        letter-spacing: -0.6px;
      }
      .sydney-card-text {
        margin-top: 14px;
        font-size: 15.5px;
        line-height: 1.65;
        color: var(--bp-mist-2);
      }
      .sydney-card-list {
        margin-top: 22px;
        display: grid;
        gap: 12px;
      }
      .sydney-card-list-item {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14.5px;
        color: #d5d9e0;
      }
      .sydney-card-list-item::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--bp-gold);
        flex: 0 0 5px;
      }

      /* TESTIMONIAL */
      .testimonial {
        padding: 140px 0;
        background: var(--bp-ink2);
        border-top: 1px solid var(--bp-line);
        border-bottom: 1px solid var(--bp-line);
      }
      .testimonial-card {
        max-width: 880px;
        margin: 0 auto;
        text-align: center;
        position: relative;
      }
      .testimonial-quote-mark {
        font-size: 80px;
        line-height: 0.4;
        color: var(--bp-gold);
        font-family: Georgia, serif;
        margin-bottom: 12px;
      }
      .testimonial-quote {
        font-size: clamp(22px, 2.8vw, 32px);
        font-weight: 500;
        line-height: 1.4;
        color: #f3f4f7;
        letter-spacing: -0.4px;
      }
      .testimonial-author {
        margin-top: 36px;
        display: inline-flex;
        align-items: center;
        gap: 14px;
      }
      .testimonial-author-av {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--bp-gold), var(--bp-gold-dark));
        color: #1a0f04;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 19px;
      }
