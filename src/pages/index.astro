---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/sections/Hero.astro";
import TrustRow from "@/components/sections/TrustRow.astro";
import ProductGrid from "@/components/sections/ProductGrid.astro";
import InTheWild from "@/components/sections/InTheWild.astro";
import Mission from "@/components/sections/Mission.astro";
import Sydney from "@/components/sections/Sydney.astro";
import Testimonial from "@/components/sections/Testimonial.astro";
import Cta from "@/components/Cta.astro";
import FooterMood from "@/components/sections/FooterMood.astro";
import { site } from "@/data/site";

const title = "Biteperk — Voice + AI for hospitality, made in Sydney";
const description =
  "Biteperk builds voice and AI tools that help restaurants stay on the floor while the phone takes care of itself. VocoTable is live; VocoOrder, VocoConcierge and VocoDrive are next.";

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  logo: `${site.url}/favicon.svg`,
  description,
  sameAs: [site.social.linkedin],
  address: {
    "@type": "PostalAddress",
    addressLocality: site.address.city,
    addressCountry: "AU",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: site.phone.href.replace("tel:", ""),
      contactType: "customer service",
      areaServed: "AU",
      availableLanguage: ["en-AU"],
    },
  ],
};
---

<Base
  title={title}
  description={description}
  path="/"
  preloadImage="/bella/portrait.png"
  ogImage="/og/home.png"
>
  <script
    is:inline
    type="application/ld+json"
    slot="jsonld"
    set:html={JSON.stringify(organizationJsonLd)}
  />

  <Hero />
  <TrustRow />
  <ProductGrid />
  <InTheWild />
  <Mission />
  <Sydney />
  <Testimonial />
  <Cta />
  <FooterMood />
</Base>
