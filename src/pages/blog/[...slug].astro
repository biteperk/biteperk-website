---
/**
 * /blog/[slug] — a single guide.
 *
 * Renders the Markdown body inside a `.prose` wrapper and emits
 * BlogPosting + BreadcrumbList structured data. Reading time is estimated
 * from the raw body word count.
 */
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Cta from "@/components/Cta.astro";
import { getCollection, render } from "astro:content";
import { u, abs } from "@/data/locales";
import { ORG_ID, WEBSITE_ID } from "@/data/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const path = `/blog/${post.id}/`;
const ogImage = post.data.ogImage ?? "/og/blog.png";

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "long", year: "numeric" }).format(d);
const iso = (d: Date) => d.toISOString().slice(0, 10);

const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingMinutes = Math.max(1, Math.round(words / 200));

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${abs(path)}#article`,
  headline: post.data.title,
  description: post.data.description,
  inLanguage: "en-AU",
  datePublished: iso(post.data.publishDate),
  dateModified: iso(post.data.updatedDate ?? post.data.publishDate),
  author: { "@type": "Organization", name: post.data.author, "@id": ORG_ID },
  publisher: { "@id": ORG_ID },
  image: abs(ogImage),
  mainEntityOfPage: { "@type": "WebPage", "@id": abs(path) },
  isPartOf: { "@id": WEBSITE_ID },
  keywords: post.data.tags.join(", "),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
    { "@type": "ListItem", position: 2, name: "Guides", item: abs("/blog/") },
    { "@type": "ListItem", position: 3, name: post.data.title, item: abs(path) },
  ],
};
---

<Base title={`${post.data.seoTitle ?? post.data.title} · Biteperk`} description={post.data.description} path={path} ogImage={ogImage}>
  <Fragment slot="jsonld">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <article class="post">
    <header class="post-hero">
      <div class="post-hero-glow" aria-hidden="true"></div>
      <div class="wrap post-wrap">
        <div class="post-top">
          <Breadcrumbs items={[
            { label: "Home", href: u("/") },
            { label: "Guides", href: u("/blog/") },
            { label: post.data.title },
          ]} />
        </div>
        {post.data.tags[0] && <span class="eyebrow">{post.data.tags[0]}</span>}
        <h1 class="post-title" transition:name={`post-${post.id}`}>{post.data.title}</h1>
        <p class="post-meta">
          <span>{post.data.author}</span>
          <span class="post-dot" aria-hidden="true">·</span>
          <time datetime={iso(post.data.publishDate)}>{fmt(post.data.publishDate)}</time>
          <span class="post-dot" aria-hidden="true">·</span>
          <span>{readingMinutes} min read</span>
        </p>
      </div>
    </header>

    <div class="wrap post-wrap">
      <div class="prose reveal">
        <Content />
      </div>

      <div class="post-foot reveal">
        <div class="post-foot-card">
          <h2>See it in action</h2>
          <p>
            VoxTable answers every restaurant call in a warm Australian voice and books the table
            — 24/7, from $80/month. Built, hosted and supported in Sydney.
          </p>
          <div class="post-foot-cta">
            <a class="btn" href={u("/products/voxtable/")}>Explore VoxTable →</a>
            <a class="btn-ghost" href={u("/contact/")}>Talk to us</a>
          </div>
        </div>
        <a class="post-back" href={u("/blog/")}>← All guides</a>
      </div>
    </div>
  </article>

  <Cta />
</Base>

<style>
  .post-hero {
    position: relative;
    padding: clamp(120px, 14vw, 176px) 0 clamp(32px, 4vw, 48px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .post-hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(46% 60% at 78% 0%, rgba(245, 196, 24, 0.13), transparent 70%);
  }
  .post-hero .wrap { position: relative; z-index: 1; }
  /* Narrow measure for comfortable long-form reading. */
  .post-wrap { max-width: 760px; }
  .post-top { margin-bottom: 24px; }
  .post-title {
    margin-top: 16px;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .post-meta {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--mist);
  }
  .post-dot { opacity: 0.6; }

  /* ── Long-form prose ──────────────────────────────────────────── */
  .prose {
    margin-top: clamp(32px, 5vw, 56px);
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose :global(> * + *) { margin-top: 1.35em; }
  .prose :global(h2) {
    margin-top: 2em;
    font-size: clamp(1.45rem, 1.1rem + 1.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--white);
  }
  .prose :global(h3) {
    margin-top: 1.7em;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--white);
  }
  .prose :global(p) { color: var(--text); }
  .prose :global(a) {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) { text-decoration-thickness: 2px; }
  .prose :global(strong) { color: var(--white); font-weight: 700; }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(li) { margin-top: 0.5em; }
  .prose :global(li)::marker { color: var(--gold); }
  .prose :global(blockquote) {
    margin-left: 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid var(--gold);
    color: var(--mist-2);
    font-style: italic;
    font-size: 1.15rem;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin-block: 2.4em;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--ink-2);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: 6px;
  }
  .prose :global(pre) {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 18px 20px;
    overflow-x: auto;
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(img) {
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) { color: var(--white); font-weight: 700; }

  /* ── Footer card ──────────────────────────────────────────────── */
  .post-foot { margin-top: clamp(48px, 6vw, 72px); }
  .post-foot-card {
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background:
      radial-gradient(80% 120% at 0% 0%, rgba(245, 196, 24, 0.08), transparent 60%),
      var(--ink-1);
  }
  .post-foot-card h2 {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .post-foot-card p { margin-top: 12px; color: var(--text); line-height: 1.65; }
  .post-foot-cta {
    margin-top: 22px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .post-back {
    display: inline-block;
    margin-top: 32px;
    color: var(--mist);
    font-size: 14px;
    font-weight: 600;
  }
  .post-back:hover { color: var(--white); }
</style>
