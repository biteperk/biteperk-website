---
/**
 * /blog/ — the Guides hub.
 *
 * Lists every published post, cornerstone (featured) first, then newest.
 * Emits Blog + BreadcrumbList structured data. Drafts are excluded.
 */
import Base from "@/layouts/AuBase.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Cta from "@/components/Cta.astro";
import ConversionTrust from "@/components/conversion/ConversionTrust.astro";
import { getCollection } from "astro:content";
import { u, abs } from "@/data/locales";
import { WEBSITE_ID } from "@/data/schema";

const path = "/blog/";
// /blog/ and /resources/guides/ list the same twelve guides. The articles keep
// their /blog/{slug}/ URLs (Ads finals, inbound links); this INDEX defers to
// the Resources hub as the canonical listing and leaves the sitemap
// (astro.config.mjs). A 301 can follow once analytics confirm nothing external
// links here.
const canonical = "/resources/guides/";
const title = "Guides for restaurant owners — Biteperk";
const description =
  "Practical, plain-English guides on missed calls, AI phone answering, bookings and running a busy restaurant phone — written for Australian venues by the team behind VoxTable.";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  // Slug tiebreak: two guides share a publishDate, and an unstable sort makes
  // the built HTML differ between environments/Node versions.
  return b.data.publishDate.getTime() - a.data.publishDate.getTime() || a.id.localeCompare(b.id);
});

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "long", year: "numeric" }).format(d);
const iso = (d: Date) => d.toISOString().slice(0, 10);

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${abs(path)}#blog`,
  name: "Biteperk Guides",
  description,
  url: abs(path),
  inLanguage: "en-AU",
  isPartOf: { "@id": WEBSITE_ID },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    description: p.data.description,
    datePublished: iso(p.data.publishDate),
    url: abs(`/blog/${p.id}/`),
  })),
};

---

<Base title={title} description={description} path={canonical} ogImage="/og/blog.png">
  <Fragment slot="jsonld">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
  </Fragment>

  <section class="blog-hero">
    <div class="blog-hero-glow" aria-hidden="true"></div>
    <div class="wrap">
      <div class="blog-top">
        <Breadcrumbs items={[{ label: "Home", href: u("/") }, { label: "Resources", href: u("/resources/") }, { label: "Guides" }]} />
      </div>
      <span class="eyebrow">Guides</span>
      <h1 class="blog-h1">Field notes for a <span class="gold">busier, calmer floor.</span></h1>
      <p class="lede blog-lede">
        Practical, no-jargon guides on the unglamorous bits — the phone, the missed calls,
        the bookings — written for Australian restaurants by the team behind VoxTable.
        Part of the <a href={u("/resources/")}>Resources</a> library.
      </p>
    </div>
  </section>

  <section class="blog-list-wrap">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="blog-empty">First guides are on the way. In the meantime, <a href={u("/contact/")}>say hello</a>.</p>
      ) : (
        <ul class="blog-grid">
          {posts.map((post) => (
            <li class="blog-cell reveal">
              <a class="blog-card pressable" href={u(`/blog/${post.id}/`)} data-glow>
                {post.data.featured && <span class="blog-card-flag">Start here</span>}
                <div class="blog-card-meta">
                  <time datetime={iso(post.data.publishDate)}>{fmt(post.data.publishDate)}</time>
                  {post.data.tags[0] && <span class="blog-card-tag">{post.data.tags[0]}</span>}
                </div>
                <h2 class="blog-card-title" transition:name={`post-${post.id}`}>{post.data.title}</h2>
                <p class="blog-card-desc">{post.data.description}</p>
                <span class="blog-card-read">Read the guide →</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="blog-conv">
    <div class="wrap">
      <ConversionTrust />
    </div>
  </section>
  <Cta
    eyebrow="Have a venue?"
    headline="Rather skip the reading and just hear it?"
    lede="VoxTable answers a real restaurant phone in a warm Australian voice. Book a 15-minute walkthrough — or see how it works first."
  />
</Base>

<style>
  .blog-hero {
    position: relative;
    padding: clamp(120px, 14vw, 180px) 0 clamp(40px, 5vw, 64px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .blog-hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(44% 56% at 78% 0%, var(--gold-soft), transparent 70%);
  }
  .blog-hero .wrap { position: relative; z-index: 1; }
  .blog-top { margin-bottom: 28px; }
  .blog-h1 {
    margin-top: 18px;
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--white);
    max-width: 16ch;
  }
  .blog-h1 .gold { color: var(--gold); }
  .blog-lede { margin-top: 24px; }
  .blog-lede a { color: var(--white); text-decoration: underline; text-underline-offset: 3px; }

  .blog-list-wrap { padding-block: var(--space-section); background: var(--ink-0); }
  .blog-empty { color: var(--mist); }
  .blog-empty a { color: var(--gold); }

  .blog-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background:
      linear-gradient(160deg, var(--fill-subtle), transparent 55%),
      var(--ink-1);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .blog-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--gold) 26%, var(--line));
    box-shadow: var(--shadow-card-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-card:hover { transform: none; }
  }
  .blog-card-flag {
    position: absolute;
    top: -10px;
    left: 24px;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font-size: 10.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 700;
    background: var(--gold-fill);
    color: var(--gold-fill-text);
  }
  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    letter-spacing: 0.4px;
    color: var(--mist);
    text-transform: uppercase;
  }
  .blog-card-tag {
    padding: 3px 10px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    color: var(--mist-2);
    letter-spacing: 1px;
    font-size: 10.5px;
  }
  .blog-card-title {
    margin-top: 16px;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--white);
  }
  .blog-card:hover .blog-card-title { color: var(--gold); }
  .blog-card-desc {
    margin-top: 12px;
    color: var(--text);
    font-size: 14.5px;
    line-height: 1.6;
    flex: 1;
  }
  .blog-card-read {
    margin-top: 20px;
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.3px;
  }
  .blog-conv { padding: 0 var(--wrap-pad, 0) clamp(8px, 2vw, 16px); }
</style>
