---
import ProductLayout from "@/layouts/ProductLayout.astro";
import FAQ from "@/components/FAQ.astro";
import PullQuote from "@/components/PullQuote.astro";
import Composite from "@/components/Composite.astro";
import ImageBlock from "@/components/ImageBlock.astro";
import Illustration from "@/components/Illustration.astro";
import { products, vocoProof, type Product } from "@/data/products";

// Slug-keyed ambient photo for in-development / concept products.
const ambientBySlug: Record<string, { slug: string; alt: string }> = {
  vocoorder: {
    slug: "kitchen-rush",
    alt: "Kitchen rush during service, tickets piling on a printer.",
  },
  vococoncierge: {
    slug: "restaurant-host",
    alt: "Front-of-house host scene in a dim restaurant.",
  },
  vocodrive: {
    slug: "coffee-window",
    alt: "Café service window at morning, warm amber light.",
  },
};

// Per-feature illustration mapping. Caps the family at six icons.
const featureIcon = (productSlug: string, idx: number) => {
  const map: Record<string, Array<"phone-wave" | "calendar-tick" | "pin-au" | "shield" | "ticket" | "clock-247">> = {
    vocotable: ["phone-wave", "calendar-tick", "pin-au", "shield"],
    vocoorder: ["phone-wave", "ticket", "clock-247"],
    vococoncierge: ["phone-wave", "calendar-tick", "shield"],
    vocodrive: ["clock-247", "pin-au", "ticket"],
  };
  return map[productSlug]?.[idx] ?? "phone-wave";
};

const stepIcons = ["phone-wave", "clock-247", "calendar-tick", "ticket"] as const;

export async function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props { product: Product }
const { product } = Astro.props;

const isLive = product.status === "live";
const isConcept = product.status === "concept";
---

<ProductLayout product={product}>
  {/* ── Hero visual ─────────────────────────────────────────────── */}
  <section class="p-section p-hero-visual">
    <div class="wrap">
      <div class="reveal">
        {product.slug === "vocotable" ? (
          <Composite
            name="vocotable-hero"
            alt="A dim restaurant interior with two VocoTable cards floating: an incoming call from 0411 234 567 with Bella answering, and a confirmed booking for Friday 8:00pm, four guests, Sarah."
            priority
          />
        ) : (
          ambientBySlug[product.slug] && (
            <ImageBlock
              slug={ambientBySlug[product.slug].slug}
              alt={ambientBySlug[product.slug].alt}
              aspect="16 / 10"
              priority
            />
          )
        )}
      </div>
    </div>
  </section>

  {/* ── Features (every product) ────────────────────────────────── */}
  <section class="p-section">
    <div class="wrap">
      <div class="p-feats reveal">
        {product.features.map((f, i) => (
          <article class="p-feat">
            <div class="p-feat-head">
              <Illustration name={featureIcon(product.slug, i)} size={40} />
              <div class="p-feat-n" aria-hidden="true">0{i + 1}</div>
            </div>
            <h3>{f.title}</h3>
            {f.body && <p>{f.body}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── How it works (VocoTable only for now) ───────────────────── */}
  {product.slug === "vocotable" && (
    <section class="p-section p-how">
      <div class="wrap">
        <div class="p-how-head reveal">
          <span class="eyebrow">How Bella works</span>
          <h2 class="p-h2">Four steps from a missed call to a confirmed booking.</h2>
        </div>
        <ol class="p-how-list reveal reveal-stagger">
          <li>
            <div class="p-how-row">
              <div class="p-how-num">1</div>
              <Illustration name={stepIcons[0]} size={36} />
            </div>
            <h3>Forward your number</h3>
            <p>Point your venue's phone to your VocoTable number. Takes five minutes with your provider.</p>
          </li>
          <li>
            <div class="p-how-row">
              <div class="p-how-num">2</div>
              <Illustration name={stepIcons[1]} size={36} />
            </div>
            <h3>Bella answers, every time</h3>
            <p>Calls land in a warm Australian voice — no menus, no hold music, no missed Friday nights.</p>
          </li>
          <li>
            <div class="p-how-row">
              <div class="p-how-num">3</div>
              <Illustration name={stepIcons[2]} size={36} />
            </div>
            <h3>Live availability check</h3>
            <p>Bella checks your diary in real time and offers a table that actually exists.</p>
          </li>
          <li>
            <div class="p-how-row">
              <div class="p-how-num">4</div>
              <Illustration name={stepIcons[3]} size={36} />
            </div>
            <h3>Booking written to your screen</h3>
            <p>Confirmed reservation appears on your dashboard, no copy-paste, no clashes.</p>
          </li>
        </ol>
      </div>
    </section>
  )}

  {/* ── Metrics row ─────────────────────────────────────────────── */}
  {product.metrics && product.metrics.length > 0 && (
    <section class="p-section p-metrics">
      <div class="wrap">
        <div class="p-metrics-grid reveal">
          {product.metrics.map((m) => (
            <div class="p-metric">
              <div class="p-metric-v tabular">
                {m.value === "$80/mo" ? (
                  <>
                    $<span
                      data-counter
                      data-counter-to="80"
                      data-counter-format="plain"
                      data-counter-duration="1100"
                    >0</span><span class="p-metric-cad">/mo</span>
                  </>
                ) : (
                  m.value
                )}
              </div>
              <div class="p-metric-l">{m.label}</div>
              {m.hint && <div class="p-metric-hint">{m.hint}</div>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── Pricing (tiered) ────────────────────────────────────────── */}
  {product.pricing && (
    <section class="p-section p-pricing" id="pricing">
      <div class="wrap">
        <div class="p-pricing-head reveal">
          <div class="eyebrow">{product.pricing.eyebrow ?? "Pricing"}</div>
          <h2 class="p-h2">{product.pricing.headline}</h2>
          {product.pricing.lede && (
            <p class="p-pricing-lede lede">{product.pricing.lede}</p>
          )}
        </div>
        <div class:list={["p-tiers reveal", `cols-${product.pricing.tiers.length}`]}>
          {product.pricing.tiers.map((t) => (
            <article class:list={["p-tier", { "is-featured": t.featured }]}>
              {t.badge && <div class="p-tier-badge">{t.badge}</div>}
              <header class="p-tier-head">
                <h3 class="p-tier-name">{t.name}</h3>
                <p class="p-tier-desc">{t.description}</p>
              </header>
              <div class="p-tier-amount">
                <span class="p-tier-n">{t.amount}</span>
                {t.cadence && <span class="p-tier-cad">{t.cadence}</span>}
              </div>
              <ul class="p-tier-features">
                {t.features.map((f) => {
                  const isHeader = /^Everything in /.test(f);
                  return (
                    <li class:list={{ "is-step": isHeader }}>
                      {!isHeader && <span class="check" aria-hidden="true">✓</span>}
                      <span>{f}</span>
                    </li>
                  );
                })}
              </ul>
              <a
                class:list={["p-tier-cta", t.featured ? "btn" : "btn-ghost"]}
                href={t.cta.href}
                rel={t.cta.href.startsWith("http") ? "noopener" : undefined}
                target={t.cta.href.startsWith("http") ? "_blank" : undefined}
              >
                {t.cta.label}
              </a>
              {t.footer && <div class="p-tier-foot">{t.footer}</div>}
            </article>
          ))}
        </div>
        {product.pricing.footnote && (
          <p class="p-pricing-footnote reveal">{product.pricing.footnote}</p>
        )}
      </div>
    </section>
  )}

  {/* ── Testimonial (VocoTable) ─────────────────────────────────── */}
  {product.slug === "vocotable" && (
    <section class="p-section p-quote">
      <div class="wrap">
        <div class="reveal">
          <PullQuote
            quote={vocoProof.testimonials[0].quote}
            author={vocoProof.testimonials[0].author}
            role={vocoProof.testimonials[0].role}
            variant="compact"
          />
        </div>
      </div>
    </section>
  )}

  {/* ── Your data, plainly (VocoTable) — surfaces the privacy facts
       already published at /legal/privacy/ where buyers actually look */}
  {product.slug === "vocotable" && (
    <section class="p-section p-data">
      <div class="wrap">
        <div class="p-data-head reveal">
          <span class="eyebrow">Your data, plainly</span>
          <h2 class="p-h2">Your calls stay in Australia. Your bookings stay yours.</h2>
        </div>
        <div class="p-data-grid reveal reveal-stagger">
          <div class="p-data-card">
            <Illustration name="pin-au" size={40} />
            <h3>Processed &amp; stored in Australia</h3>
            <p>Call audio is processed onshore and never leaves the country.</p>
          </div>
          <div class="p-data-card">
            <Illustration name="shield" size={40} />
            <h3>Never used to train outside models</h3>
            <p>Your recordings and bookings are yours — not training data.</p>
          </div>
          <div class="p-data-card">
            <Illustration name="calendar-tick" size={40} />
            <h3>Kept only as long as needed</h3>
            <p>Audio is retained just long enough to confirm the booking.</p>
          </div>
        </div>
        <p class="p-data-link reveal">
          The fine print, in plain English: <a href="/legal/privacy/">our privacy policy</a>.
        </p>
      </div>
    </section>
  )}

  {/* ── In-development / Concept body ──────────────────────────── */}
  {!isLive && (
    <section class="p-section p-dev">
      <div class="wrap">
        <div class="p-dev-card reveal">
          <div class="eyebrow">
            {isConcept ? "Concept stage" : "In development"}
          </div>
          <h2 class="p-h2">
            {isConcept
              ? `${product.name} is a concept we're testing aloud.`
              : `${product.name} is being built right now.`}
          </h2>
          <p class="p-dev-body">
            {isConcept
              ? "There's no code yet — just the shape of a problem we keep hearing. If you'd find it useful, tell us. We'll bring you in when there's something to see."
              : "We're working with a small group of venues to shape it. Join the waitlist and you'll be among the first to try it when it ships."}
          </p>
        </div>
      </div>
    </section>
  )}

  {/* ── FAQ (every product that has one) ────────────────────────── */}
  {product.faq && product.faq.length > 0 && (
    <section class="p-section p-faq">
      <div class="wrap">
        <div class="p-faq-head reveal">
          <span class="eyebrow">Common questions</span>
          <h2 class="p-h2">Answered plainly.</h2>
        </div>
        <div class="reveal" style="margin-top:40px">
          <FAQ items={product.faq} />
        </div>
      </div>
    </section>
  )}
</ProductLayout>

<style>
  .p-section {
    padding-block: clamp(72px, 8vw, 120px);
    border-top: 1px solid var(--line);
  }
  .p-h2 {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: -0.025em;
    color: var(--white);
    margin-top: 16px;
  }

  /* Features grid */
  .p-feats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }
  .p-feat {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--ink-1);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .p-feat:hover { border-color: color-mix(in srgb, var(--gold) 30%, var(--line)); }
  .p-feat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .p-feat-n {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--gold);
    font-weight: 700;
  }
  .p-how-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .p-hero-visual {
    padding-block: clamp(40px, 5vw, 72px);
    border-top: 0;
  }
  .p-feat h3 {
    font-size: 19px;
    color: var(--white);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .p-feat p {
    margin-top: 10px;
    color: var(--text);
    line-height: 1.6;
    font-size: 14.5px;
  }

  /* How it works — a gold thread draws across the four beats once the
     list reveals, in the Illustration stroke-trace language. */
  .p-how-list {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    position: relative;
  }
  .p-how-list::before {
    content: "";
    position: absolute;
    top: -22px;
    left: 2%;
    right: 2%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold) 12%, var(--gold) 88%, transparent);
    opacity: 0.55;
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .p-how-list.is-in::before {
      transform: scaleX(1);
      transition: transform 1.1s var(--ease-out) 150ms;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .p-how-list::before { transform: scaleX(1); }
  }
  .p-how-list li {
    padding: 32px 24px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--gold-fill) 4%, transparent), transparent 60%),
      var(--ink-1);
  }
  .p-how-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gold-fill);
    color: var(--gold-fill-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
  }
  .p-how-list h3 { margin-top: 18px; font-size: 17px; color: var(--white); font-weight: 700; }
  .p-how-list p { margin-top: 8px; color: var(--text); font-size: 14.5px; line-height: 1.55; }

  /* Metrics */
  .p-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    text-align: center;
  }
  .p-metric-v {
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 800;
    color: var(--gold);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .p-metric-cad {
    font-size: 0.45em;
    font-weight: 700;
    letter-spacing: 0;
  }
  .p-metric-l {
    margin-top: 14px;
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--mist);
    font-weight: 600;
  }
  .p-metric-hint {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--mist-2);
  }

  /* Pricing — tiered grid */
  .p-pricing-head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 56px;
  }
  .p-pricing-lede {
    margin-inline: auto;
    margin-top: 20px;
    text-align: center;
  }
  .p-tiers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    align-items: stretch;
  }
  .p-tier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background:
      linear-gradient(160deg, var(--fill-subtle), transparent 60%),
      var(--ink-1);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .p-tier:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--gold) 22%, var(--line));
    box-shadow: var(--shadow-card-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .p-tier:hover { transform: none; }
  }
  .p-tier.is-featured {
    border-color: color-mix(in srgb, var(--gold) 36%, var(--line));
    background:
      radial-gradient(80% 60% at 50% 0%, color-mix(in srgb, var(--gold-fill) 10%, transparent), transparent 70%),
      linear-gradient(160deg, color-mix(in srgb, var(--gold-fill) 4%, transparent), transparent 60%),
      var(--ink-1);
    box-shadow: var(--shadow-card-hover);
  }
  .p-tier-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 5px 14px;
    border-radius: var(--r-pill);
    font-size: 10.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    font-weight: 700;
    background: var(--gold-fill);
    color: var(--gold-fill-text);
    white-space: nowrap;
  }
  .p-tier-head { min-height: 86px; }
  .p-tier-name {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .p-tier.is-featured .p-tier-name { color: var(--gold); }
  .p-tier-desc {
    margin-top: 8px;
    font-size: 14px;
    color: var(--mist-2);
    line-height: 1.5;
    min-height: 42px;
  }
  .p-tier-amount {
    margin-top: 18px;
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 22px;
    width: 100%;
  }
  .p-tier-n {
    font-size: clamp(34px, 3.4vw, 44px);
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .p-tier-cad {
    font-size: 14px;
    color: var(--mist);
  }
  .p-tier-features {
    list-style: none;
    padding: 0;
    margin: 22px 0 28px;
    display: grid;
    gap: 11px;
    flex: 1;
  }
  .p-tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text);
    font-size: 14px;
    line-height: 1.45;
  }
  .p-tier-features li.is-step {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    color: var(--mist-2);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  .p-tier-features .check {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--gold-soft);
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 11px;
    margin-top: 2px;
  }
  .p-tier-cta {
    margin-top: auto;
    width: 100%;
    justify-content: center;
    padding: 13px 18px;
    font-size: 14px;
  }
  .p-tier-foot {
    margin-top: 14px;
    text-align: center;
    font-size: 12.5px;
    color: var(--mist);
    letter-spacing: 0.3px;
  }
  .p-pricing-footnote {
    margin: 40px auto 0;
    text-align: center;
    color: var(--mist);
    font-size: 13.5px;
    max-width: 640px;
  }

  @media (max-width: 1100px) {
    .p-tiers { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .p-tiers { grid-template-columns: 1fr; }
    .p-tier-head { min-height: auto; }
    .p-tier-desc { min-height: auto; }
  }

  /* Your data, plainly */
  .p-data-head { text-align: center; max-width: 720px; margin: 0 auto; }
  .p-data-grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .p-data-card {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--ink-1);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .p-data-card:hover { border-color: color-mix(in srgb, var(--gold) 26%, var(--line)); }
  .p-data-card h3 {
    margin-top: 16px;
    font-size: 16.5px;
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.01em;
  }
  .p-data-card p {
    margin-top: 8px;
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
  }
  .p-data-link {
    margin-top: 32px;
    text-align: center;
    color: var(--mist-2);
    font-size: 14px;
  }
  .p-data-link a {
    color: var(--gold);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* In-development / Concept */
  .p-dev-card {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 32px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--ink-1);
  }
  .p-dev-body {
    margin-top: 18px;
    color: var(--text);
    line-height: 1.65;
    font-size: 16px;
  }

  /* FAQ */
  .p-faq-head { text-align: center; }
</style>
