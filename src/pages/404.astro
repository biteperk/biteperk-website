---
import Base from "@/layouts/Base.astro";
import AuBase from "@/layouts/AuBase.astro";
// NB: this one file serves both hosts, so the global build's 404.html also
// inlines the AU chrome CSS that AuBase pulls into the import graph (~20 KB,
// no markup, no NAP). Every page did until 6 Sep 2026; the locale trees no
// longer do. Tolerated here rather than splitting the route per target.
import StarMark from "@/components/StarMark.astro";
import { currentTarget, u, localesForTarget, ORIGIN } from "@/data/locales";
import { chrome } from "@/data/intl/copy";

// Firebase serves ONE 404.html for the whole site — this global one, which
// merge-dist places at the root (the AU build's copy lands at /au-en/404.html
// and is never served). So it must work for a visitor from ANY of the six
// trees: until 13 Sep 2026 it offered only /en and /fr, in English, so an
// /au-en typo landed on a page with no AU link at all and a /gb-en or /be-*
// one was sent to a tree that was not theirs.
//
// No-JS: bilingual EN/FR text plus every tree's home, each link in its own
// language. With JS: the inline script below matches the path prefix, swaps
// the copy to that tree's language and sets <html lang> to match.
const trees = [...localesForTarget("au"), ...localesForTarget("global")];
const notFoundByBase = Object.fromEntries(
  trees.map((l) => [l.base, { lang: l.lang, ...chrome[l.copyLang].notFound, contactHref: `${l.base}/contact/` }]),
);

// The global (biteperk.com) build gets its own 404: the AU version's chrome
// carries the AU footer (NAP + phone) and links to routes pruned from that
// host — both forbidden on the international surfaces (PLAN.md §8).
const isGlobal = currentTarget() === "global";

const title = isGlobal ? "Not found — BitePerk" : "Not found — Biteperk";
const description = "We couldn't find that page. Here are a few useful places to go.";
---

{isGlobal ? (
  <Base title={title} description={description} path="/404" lang="en" noindex={true}>
    <section class="nf">
      <div class="nf-glow" aria-hidden="true"></div>
      <div class="wrap">
        <div class="nf-inner">
          <div class="nf-mark"><StarMark size={56} /></div>
          <p class="eyebrow nf-eyebrow" data-nf-eyebrow>404 · Page not found / page introuvable</p>
          <h1 class="nf-h" data-nf-title>This page is having a quiet night.</h1>
          <p class="nf-sub" data-nf-body>
            We couldn't find what you were looking for. · Nous n'avons pas trouvé la page demandée.
          </p>
          <div class="nf-cta" data-nf-primary hidden>
            <a class="btn" data-nf-home href="/en/">Home</a>
            <a class="btn-ghost" data-nf-contact href="/en/contact/">Contact</a>
          </div>
          <ul class="nf-trees" role="list">
            {trees.map((l) => (
              <li>
                {/* The AU tree is another Firebase base from this build's point
                    of view: absolute, like IntlLayout's footer link, so
                    check-links (global) does not read it as a root-relative
                    escape from the locale bases. */}
                <a class="btn-ghost" href={l.target === "au" ? `${ORIGIN}${l.base}/` : `${l.base}/`} hreflang={l.hreflang[0]} lang={l.lang} data-nf-tree={l.base}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
          <script type="application/json" data-nf-copy set:html={JSON.stringify(notFoundByBase)} />
          <script is:inline>
            (function () {
              try {
                var data = JSON.parse(document.querySelector("[data-nf-copy]").textContent || "{}");
                var seg = "/" + (location.pathname.split("/")[1] || "");
                var t = data[seg];
                if (!t) return;
                document.documentElement.lang = t.lang;
                var set = function (sel, text) { var el = document.querySelector(sel); if (el) el.textContent = text; };
                set("[data-nf-eyebrow]", t.eyebrow);
                set("[data-nf-title]", t.title);
                set("[data-nf-body]", t.body);
                var home = document.querySelector("[data-nf-home]");
                var contact = document.querySelector("[data-nf-contact]");
                if (home) { home.textContent = t.home; home.href = seg + "/"; }
                if (contact) { contact.textContent = t.contact; contact.href = t.contactHref; }
                var primary = document.querySelector("[data-nf-primary]");
                if (primary) primary.hidden = false;
                var own = document.querySelector('[data-nf-tree="' + seg + '"]');
                if (own) own.parentElement.hidden = true;
              } catch (e) {}
            })();
          </script>
        </div>
      </div>
    </section>
  </Base>
) : (
  <AuBase title={title} description={description} path="/404">
    <section class="nf">
      <div class="nf-glow" aria-hidden="true"></div>
      <div class="wrap">
        <div class="nf-inner">
          <div class="nf-mark"><StarMark size={56} /></div>
          <p class="eyebrow nf-eyebrow">404 · Page not found</p>
          <h1 class="nf-h">This page is having a quiet night.</h1>
          <p class="nf-sub">
            We couldn't find what you were looking for. Try one of these instead — or call us if you'd
            rather hear an Australian voice.
          </p>
          <div class="nf-cta">
            <a class="btn" href={u("/")}>Back to home</a>
            <a class="btn-ghost" href={u("/products/")}>See the products</a>
            <a class="btn-ghost" href={u("/contact/")}>Get in touch</a>
          </div>
        </div>
      </div>
    </section>
  </AuBase>
)}

<style>
  .nf-trees {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .nf {
    min-height: 80vh;
    min-height: 80svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 140px 0 100px;
    position: relative;
    overflow: hidden;
  }
  .nf-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(50% 60% at 50% 30%, rgba(245, 196, 24, 0.18), transparent 70%);
  }
  .nf-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .nf-mark { display: flex; justify-content: center; margin-bottom: 24px; }
  .nf-eyebrow { display: block; }
  .nf-h {
    margin-top: 22px;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--white);
  }
  .nf-sub {
    margin-top: 22px;
    color: var(--text);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }
  .nf-cta {
    margin-top: 36px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
