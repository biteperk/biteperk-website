---
/**
 * Base layout — every page on both trees extends this (AU pages via
 * AuBase.astro, which adds the AU chrome; international pages via IntlLayout).
 *
 * Responsibilities:
 *   - <head>: charset, viewport, theme-color, font preload, favicon, SEO
 *   - Skip-link for keyboard users
 *   - `nav` / `footer` named slots + <main> default slot
 *   - Astro View Transitions wired sitewide
 *   - Loads the scripts BOTH trees use as deferred modules
 *
 * Pages pass `title`, optional `description`, optional `path` (canonical
 * override), optional `preloadImage` (push critical hero image on home),
 * optional `ogImage` (per-page Open Graph card).
 */
// Self-hosted fonts: src/styles/fonts.css declares the four faces the site
// actually uses (Inter latin + latin-ext, Source Serif 4 latin 400/500) and
// nothing else — see the note there for why the fontsource index CSS is NOT
// imported. The latin Inter file is preloaded below; `?url` and the CSS
// url() resolve to the same hashed asset, and check-assets.mjs verifies the
// preload href exists in the build.
import "@/styles/fonts.css";
import "@/styles/global.css";
import interLatinUrl from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import SEO from "@/components/SEO.astro";
import ConsentBanner from "@/components/ConsentBanner.astro";
import { siteGraphWith } from "@/data/schema";
import { u, buildHreflang, currentTarget, stripBase, isSharedPage, localeFromPath, INTL_LAUNCHED } from "@/data/locales";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  path?: string;
  /** `<html lang>` — defaults to en-AU (AU build); global locales pass en / fr. */
  lang?: string;
  /** Skip-link text, in the page's language. Defaults to English (AU). */
  skipLabel?: string;
  /** Organization.description for the sitewide graph, in the page's language. */
  orgDescription?: string;
  /** og:locale — defaults to en_AU. */
  ogLocale?: string;
  /** Emit robots noindex (used by the international staging scaffold). */
  noindex?: boolean;
  /** hreflang cluster for this page (international builds only; AU emits none). */
  alternates?: { hreflang: string; href: string }[];
  /** x-default href for the hreflang cluster. */
  xDefaultHref?: string;
  /** Absolute path under /public to preload (e.g. "/bella/portrait.png") */
  preloadImage?: string;
  /** Responsive LCP-image preload (ImageBlock slug + its `sizes` value).
      Emits <link rel=preload imagesrcset> for the AVIF chain so the
      request starts before the (large, fully-inlined-CSS) HTML finishes
      parsing. */
  preloadSlug?: { slug: string; sizes: string };
  /** Preload a Composite's AVIF pair (media-split desktop/mobile). */
  preloadComposite?: string;
  /** Per-page OG image, defaults to /og/default.png */
  ogImage?: string;
}

const {
  title,
  description,
  path,
  lang = "en-AU",
  skipLabel = "Skip to content",
  orgDescription,
  ogLocale = "en_AU",
  noindex = false,
  alternates,
  xDefaultHref,
  preloadImage,
  preloadSlug,
  preloadComposite,
  ogImage,
} = Astro.props;

// Which locale tree this page belongs to — drives the per-locale manifest.
const manifestLoc = localeFromPath(Astro.url.pathname).base.replace(/^\//, "");

// Cross-domain hreflang for AU shared pages (home, about, contact, legal) is
// emitted automatically once the international site launches. The intl /en+/fr
// pages compute their own cluster in [...intl].astro. Pages that pass explicit
// `alternates` keep control. Pre-launch (INTL_LAUNCHED=false) the AU build emits
// no hreflang — byte-identical to today.
let hreflangAlternates = alternates;
let hreflangXDefault = xDefaultHref;
if (!alternates && INTL_LAUNCHED && currentTarget() === "au") {
  const baseLess = stripBase(path ?? new URL(Astro.request.url).pathname);
  if (isSharedPage(baseLess)) {
    const cluster = buildHreflang(baseLess.replace(/^\//, ""), ["au", "global"] as const);
    hreflangAlternates = cluster.alternates;
    hreflangXDefault = cluster.xDefault;
  }
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0b0d" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    {/* Pre-paint theme: explicit localStorage choice wins, else follow the
        OS. Inline so it runs before first paint — prevents theme flash.
        Storage contract shared with src/scripts/theme.ts. */}
    <script is:inline>
      (function () {
        // Pre-paint: mark that JS is running so the image fade-in can start
        // below-the-fold photos hidden. No JS → no `.js` → images render fully
        // visible (see ImageBlock.astro / image-fade.ts).
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("bp-theme");
          if (t !== "light" && t !== "dark") {
            t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    {/* Pre-paint consent state: mark whether a stored choice exists so the
        banner never flashes for returning visitors (CSS shows it only under
        [data-consent="unset"]). Version-agnostic on purpose — the authoritative
        version check lives in src/scripts/consent.ts, which re-opens the
        banner if the stored choice is stale. Storage key shared with it. */}
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem("bp-consent");
          var ok = false;
          if (raw) { var c = JSON.parse(raw); ok = !!(c && typeof c === "object" && "v" in c); }
          document.documentElement.dataset.consent = ok ? "set" : "unset";
        } catch (e) { document.documentElement.dataset.consent = "unset"; }
      })();
    </script>
    <meta name="format-detection" content="telephone=no" />
    <!-- Bing Webmaster Tools site verification -->
    <meta name="msvalidate.01" content="C717E1E48BD4B561E0F2F3B5F733838D" />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    {/* iOS ignores SVG touch icons — this must stay a PNG (npm run brand). */}
    <link rel="apple-touch-icon" sizes="180x180" href={u("/apple-touch-icon.png")} />
    {/* Per-locale manifest so an install from /gb-en/ opens on the UK site,
        not the international one. See src/pages/manifest/[loc].webmanifest.ts */}
    <link rel="manifest" href={u(`/manifest/${manifestLoc}.webmanifest`)} />

    {preloadImage && <link rel="preload" as="image" href={u(preloadImage)} fetchpriority="high" />}
    {preloadSlug && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={`${u(`/images/${preloadSlug.slug}-768.avif`)} 768w, ${u(`/images/${preloadSlug.slug}-1280.avif`)} 1280w, ${u(`/images/${preloadSlug.slug}-1920.avif`)} 1920w`}
        imagesizes={preloadSlug.sizes}
        fetchpriority="high"
      />
    )}
    {preloadComposite && (
      <>
        <link rel="preload" as="image" type="image/avif" href={u(`/images/composites/${preloadComposite}-mobile.avif?v2`)} media="(max-width: 767px)" fetchpriority="high" />
        <link rel="preload" as="image" type="image/avif" href={u(`/images/composites/${preloadComposite}-desktop.avif?v2`)} media="(min-width: 768px)" fetchpriority="high" />
      </>
    )}
    {/* Inter latin is the body face on every page and the LCP element on the
        international trees is TEXT. Without this hint the browser only
        discovers the woff2 after it has parsed the (fully inlined) stylesheet;
        measured on /fr/ (Lighthouse mobile, 5 runs): FCP 2.78s → 1.88s, LCP
        3.15s → 2.55s from this one line. Only the latin file — latin-ext loads
        on demand for the rare glyph that needs it, the serif is one span.
        NOT on pages that preload an LCP IMAGE (AU home, city pages, the
        VoxTable product page): there the font contributes nothing to LCP —
        the metric-matched fallback paints identically — while its 48 KB
        shares the throttled link with the hero. On CI (5-run medians) the AU
        home sat at 2519.7 with the font preload first and 2516–2526 with it
        placed after the image preload; the budget is 2500. Pages with a text
        LCP get the hint, pages with an image LCP keep the bandwidth. */}
    {!preloadImage && !preloadSlug && !preloadComposite && (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={interLatinUrl} />
    )}

    <SEO title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} ogLocale={ogLocale}>
      <slot name="jsonld" slot="jsonld" />
    </SEO>

    {/* hreflang cluster — international builds only; the AU build passes none,
        so its <head> is unchanged. */}
    {hreflangAlternates?.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {hreflangXDefault && <link rel="alternate" hreflang="x-default" href={hreflangXDefault} />}

    {/* Sitewide brand graph (Organization + WebSite), linked by @id. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteGraphWith({ orgDescription }))} />

    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    {/* Chrome is a SLOT, not a prop. Astro inlines the CSS of every component
        in a page's import graph — a `{!hideNav && <Nav />}` still shipped the
        AU nav, mega-menu, mobile menu and footer styles (~20 KB) into every
        international page that never rendered them. AU pages go through
        AuBase.astro, which fills these slots; IntlLayout fills neither and
        renders its own header/footer inside the default slot. */}
    <slot name="nav" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    {/* Persisted across View Transitions so its shown/animated state never
        replays on soft navigation. */}
    <ConsentBanner transition:persist />


    {/* Scripts shared by BOTH trees. AU-only behaviour (sticky nav, mega
        menu, mobile menu, counters, call simulation) is imported by
        AuBase.astro so the international bundle doesn't carry it. */}
    <script>
      import "@/scripts/theme.ts";
      import "@/scripts/reveal.ts";
      // Fades below-the-fold catalogue images up from their LQIP blur as they
      // decode (ImageBlock marks them data-fade). Eager + deprioritized heroes
      // are excluded, so LCP is untouched.
      import "@/scripts/image-fade.ts";
      // Shared since 6 Sep 2026: the international trees have a slide-over
      // drawer too (IntlMobileMenu), driven by exactly this script. ~4.5KB.
      import "@/scripts/mobile-menu.ts";
      // Shared since 6 Sep 2026: the locale homes carry the call
      // simulation too. The transcript is server-rendered either way —
      // this only adds the timed playback.
      import "@/scripts/call-sim.ts";
      import "@/scripts/locale-picker.ts";
      import "@/scripts/city-nav.ts";
      import "@/scripts/locale-suggest.ts";
      import "@/scripts/card-glow.ts";
      import "@/scripts/attribution.ts";
      import "@/scripts/consent.ts";
      import "@/scripts/analytics.ts";
    </script>
  </body>
</html>
