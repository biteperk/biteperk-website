---
/**
 * Shared chrome for /solutions/[slug] pages (Phase 1C).
 * Mirrors ProductLayout patterns: Base + breadcrumbs + JSON-LD + hero CTAs + bottom Cta.
 */
import Base from "@/layouts/AuBase.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Cta from "@/components/Cta.astro";
import ConversionTrust from "@/components/conversion/ConversionTrust.astro";
import type { Solution } from "@/data/solutions";
import { bookDemoHref, CTA_LABELS, defaultCtaActions } from "@/data/conversion";
import { site } from "@/data/site";
import { u, abs } from "@/data/locales";

interface Props {
  solution: Solution;
}
const { solution } = Astro.props;
const path = `/solutions/${solution.slug}/`;
const demoHref = bookDemoHref({ product: solution.primaryProduct });
const cta = defaultCtaActions({ product: solution.primaryProduct });

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
    { "@type": "ListItem", position: 2, name: "Solutions", item: abs("/solutions/") },
    { "@type": "ListItem", position: 3, name: solution.name, item: abs(path) },
  ],
};

const faqJsonLd =
  solution.page.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: solution.page.faq.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : null;

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: solution.page.seo.title,
  description: solution.page.seo.description,
  url: abs(path),
  isPartOf: { "@type": "WebSite", name: site.name, url: abs("/") },
};
---

<Base
  title={solution.page.seo.title}
  description={solution.page.seo.description}
  path={path}
>
  <Fragment slot="jsonld">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
    {faqJsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <header class="sol-hero">
    <div class="wrap">
      <Breadcrumbs
        items={[
          { label: "Home", href: u("/") },
          { label: "Solutions", href: u("/solutions/") },
          { label: solution.name },
        ]}
      />
      <span class="eyebrow sol-eyebrow">{solution.page.hero.eyebrow}</span>
      <h1 class="sol-h">{solution.page.hero.headline}</h1>
      <p class="sol-sub">{solution.page.hero.sub}</p>
      <div class="sol-cta">
        <a class="btn" href={demoHref} data-cta="book-demo">{CTA_LABELS.bookDemo}</a>
        <a class="btn-ghost" href={u(`/products/${solution.primaryProduct}/`)}>{CTA_LABELS.howItWorks}</a>
      </div>
      <ConversionTrust />
    </div>
  </header>

  <slot />

  <Cta
    eyebrow="Book a demo"
    headline={`Talk through ${solution.name.toLowerCase()} on your line.`}
    lede="Fifteen minutes is enough to hear Vox, map your overflow, and decide if BitePerk fits — no slide deck required."
    primary={cta.primary}
    secondary={cta.secondary}
  />
</Base>

<style>
  .sol-hero {
    padding: clamp(120px, 16vw, 180px) 0 clamp(56px, 7vw, 88px);
    border-bottom: 1px solid var(--line);
  }
  .sol-eyebrow {
    display: inline-block;
    margin-top: 28px;
  }
  .sol-h {
    margin-top: 18px;
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: -0.025em;
    max-width: 18ch;
    color: var(--white);
  }
  .sol-sub {
    margin-top: 22px;
    color: var(--text);
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
    max-width: 62ch;
  }
  .sol-cta {
    margin-top: 36px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .sol-trust {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    color: var(--mist);
    font-size: var(--fs-small);
  }
  .sol-trust a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
