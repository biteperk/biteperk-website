---
/**
 * Layout for the international (biteperk.com) pages — /en/ and /fr/.
 *
 * Wraps Base with the AU Nav + Footer hidden and provides its own slim chrome:
 * the AU chrome carries the AU phone number and links to routes (/products/,
 * cities, blog) that are pruned from the global build — both are forbidden on
 * these pages (PLAN.md §8). Everything visual reuses the design tokens and
 * shared classes (.wrap, .btn, .btn-ghost, .pill, .brand-name) so the two
 * properties read as one brand.
 */
import Base from "@/layouts/Base.astro";
import { resolveCopy } from "@/data/intl";
import {
  localesForTarget, buildHreflang, localeSwitchUrl, INTL_LAUNCHED, AU_HOME,
  type BuildTarget, type Locale,
} from "@/data/locales";
import LocalePicker from "@/components/LocalePicker.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import StarMark from "@/components/StarMark.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import LocaleSuggest from "@/components/LocaleSuggest.astro";
import CityNav from "@/components/intl/CityNav.astro";
import IntlMobileMenu from "@/components/intl/IntlMobileMenu.astro";
import { INTL_NAV } from "@/data/intl/nav";
import { products } from "@/data/products";
import { entities, ukEmail } from "@/data/site";
import { ukEntityGraph } from "@/data/schema";
import { intlCitiesForBase } from "@/data/intl/cities";

interface Props {
  /** The locale this page belongs to — everything derives from it. */
  locale: Locale;
  /** Page path within the locale ("" for home, "about", "legal/privacy", …). */
  page: string;
  title: string;
  description: string;
  ogImage: string;
  noindex?: boolean;
  /** Responsive LCP preload, forwarded to Base. Home only — that is the one
      page whose hero image is the LCP element. */
  preloadSlug?: { slug: string; sizes: string };
}

const { locale, page, title, description, ogImage, noindex = !INTL_LAUNCHED, preloadSlug } = Astro.props;
const c = resolveCopy(locale).chrome;

const pagePath = page ? `${page}/` : "";
// Paths come from the BASE ("/gb-en/…"), never from lang ("en-GB" → 404).
const canonicalPath = `${locale.base}/${pagePath}`;
// Once launched, shared pages (home/about/contact/legal) join the AU site in
// the full cross-locale cluster; /how-it-works stays global-only. Pre-launch:
// global locales only.
// buildHreflang drops any locale that doesn't emit the page, so "au" can be
// offered unconditionally here — it joins on the shared pages and is filtered
// out everywhere else. (This used to repeat the isSharedPage test itself; two
// copies of one rule is one too many.)
const targets: readonly BuildTarget[] = INTL_LAUNCHED ? ["au", "global"] : ["global"];
const { alternates, xDefault } = buildHreflang(pagePath, targets);

// Footer language/region alternates — derived from the locale array (no
// per-language link copy to maintain; labels are already locale-appropriate)
// and page-carrying via localeSwitchUrl, so /gb-en/about/ → /fr/about/.
const alternateLocales = localesForTarget("global").filter((l) => l.base !== locale.base);
const p = (seg: string) => `${locale.base}/${seg ? `${seg}/` : ""}`;
// This locale's published city pages — empty on trees without cities, so the
// footer and nav stay identical there (no locale branching, no dead links).
const footerCities = intlCitiesForBase(locale.base);
const hasCities = footerCities.length > 0;
const year = new Date().getFullYear();
// Only /gb-en carries market "gb". Biteperk Ltd is a UK company; its statutory
// website disclosure belongs on the UK tree, not on /fr or /be-*.
const isUk = locale.market === "gb";
---

<Base
  title={title}
  description={description}
  path={canonicalPath}
  lang={locale.lang}
  ogLocale={locale.ogLocale}
  ogImage={ogImage}
  noindex={noindex}
  alternates={alternates}
  xDefaultHref={xDefault}
  preloadSlug={preloadSlug}
>
  {/* Forward page-level structured data through to Base's <head>. Without
      this the intl pages could only ever carry the sitewide graph — which is
      why they had no BreadcrumbList/FAQPage until the product pages landed. */}
  <slot name="jsonld" slot="jsonld" />

  {/* Biteperk Ltd, on the UK tree only. Structured data mirrors the visible
      footer disclosure exactly — a London postal address on /fr or /be-* would
      be true and still wrong, because a market page must never carry a presence
      signal for a country there is no presence in. */}
  {isUk && (
    <script
      is:inline
      type="application/ld+json"
      slot="jsonld"
      set:html={JSON.stringify(ukEntityGraph)}
    />
  )}

  <div class="intl">
    <header class="intl-nav" data-has-cities={hasCities}>
      <div class="wrap intl-nav-row">
        <a class="brand" href={p("")} aria-label="BitePerk home">
          <StarMark size={30} />
          <span class="brand-name">bite<span class="perk">perk</span></span>
        </a>
        <nav class="intl-links" aria-label="Site">
          {INTL_NAV.map((item) => (
            <a href={p(item.path)}>{c.nav[item.key]}</a>
          ))}
        </nav>
        <div class="intl-actions">
          {/* Gated HERE, not only inside the component: an is:inline style
              renders wherever its component is INVOKED, conditionals around
              the sibling markup notwithstanding — invoking CityNav on /fr
              shipped 27 dead selectors there (caught by the build grep).
              Deliberately NOT inside .intl-links: chrome.spec counts
              `.intl-links a` against INTL_NAV.length, and this menu's 8
              anchors would break it. */}
          {hasCities && (
            <CityNav locale={locale} page={page} label={c.cities} title={c.citiesTitle} />
          )}
          <LocalePicker title={c.regionTitle} />
          <ThemeToggle />
          <a class="btn intl-cta-btn" href={p("contact")}>{c.cta}</a>
          {/* ≤720px only. Placed after the picker so the tab order in the bar
              reads brand → picker → menu, and OUTSIDE the drawer so the
              picker's fixed bottom sheet never sits inside a transformed
              ancestor. aria-controls/-expanded are the contract
              src/scripts/mobile-menu.ts drives. */}
          <button
            class="intl-burger"
            type="button"
            data-mobile-menu-trigger
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label={c.menu}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    {/* Sibling of the header, not a child: the panel is position:fixed and a
        future filter/transform on the bar would otherwise trap it. */}
    <IntlMobileMenu locale={locale} page={page} chrome={c} nav={INTL_NAV} cities={footerCities} />

    <slot />

    <footer class="intl-footer">
      <div class="wrap">
        <div class="intl-footer-grid">
          <div>
            <span class="intl-footer-brand">
              <StarMark size={26} />
              <span class="brand-name">bite<span class="perk">perk</span></span>
            </span>
            <p class="intl-footer-blurb">{c.footerBlurb}</p>
            {/* Its own class, NOT intl-footer-links: that class is a test
                locator (chrome.spec walks it asserting a 44px height on every
                link and picks the cookie href off the first match). The icons
                are 44px anyway, but coupling a decorative row to a nav
                assertion would make both harder to change. Title is a <p> for
                the same reason as the columns below — the a11y sweep counts
                every heading on all 60 global routes. */}
            <nav class="intl-social" aria-labelledby="ifc-follow">
              <p class="intl-footer-col-title" id="ifc-follow">{c.footerFollow}</p>
              <SocialLinks label={c.footerFollow} />
            </nav>
          </div>
          {/* Labeled columns, each its own <nav> with a distinct accessible
              name ("Explore", never "Site" — the header nav landmark already
              carries that name and duplicate landmark names trip axe).
              Column titles are <p> + aria-labelledby, NEVER headings: the
              a11y sweep counts every heading in DOM order. Every column
              keeps class intl-footer-links so chrome.spec's 44px-target and
              cookie-href locators keep their teeth. */}
          <div class="intl-footer-cols">
            {/* Product links are brand nouns (VoxTable, …) shared across every
                language, sourced from the AU catalogue's slug+name — every
                locale emits /products/ and every product page. */}
            <nav class="intl-footer-links" aria-labelledby="ifc-products">
              <p class="intl-footer-col-title" id="ifc-products">{c.footerProducts}</p>
              {products.map((prod) => (
                <a href={p(`products/${prod.slug}`)}>{prod.name}</a>
              ))}
            </nav>
            <nav class="intl-footer-links" aria-labelledby="ifc-explore">
              <p class="intl-footer-col-title" id="ifc-explore">{c.footerExplore}</p>
              {INTL_NAV.map((item) => (
                <a href={p(item.path)}>{c.nav[item.key]}</a>
              ))}
              {/* The UK entity's published contact address (already in the
                  statutory line below) — email only, never a phone: there is
                  no European line and check-truthful bans inventing one. */}
              {isUk && <a href={ukEmail.href}>{ukEmail.display}</a>}
            </nav>
            <nav class="intl-footer-links" aria-labelledby="ifc-legal">
              <p class="intl-footer-col-title" id="ifc-legal">{c.footerLegal}</p>
              <a href={p("legal/privacy")}>{c.privacy}</a>
              <a href={p("legal/terms")}>{c.terms}</a>
              <a href={p("legal/cookies")}>{c.cookies}</a>
              {/* Withdrawal must be as easy as consent (GDPR art. 7(3)) — this
                  re-opens the consent modal from any page, mirroring the AU
                  footer's control. Styled to match the links around it. */}
              <button type="button" class="intl-footer-btn" data-cookie-settings>
                {c.cookieSettings}
              </button>
            </nav>
            {/* Derived per locale — the whole column vanishes on trees
                without published cities, so /fr keeps a two-column footer. */}
            {hasCities && (
              <nav class="intl-footer-links" aria-labelledby="ifc-cities">
                <p class="intl-footer-col-title" id="ifc-cities">{c.cities}</p>
                {footerCities.map((x) => (
                  <a href={p(x.slug)}>{x.name}</a>
                ))}
              </nav>
            )}
            <nav class="intl-footer-links" aria-labelledby="ifc-regions">
              <p class="intl-footer-col-title" id="ifc-regions">{c.footerRegions}</p>
              <a href={AU_HOME + "/"}>{c.auSite} ↗</a>
              {alternateLocales.map((l) => (
                <a
                  href={new URL(localeSwitchUrl(canonicalPath, l)).pathname}
                  rel="alternate"
                  hreflang={l.hreflang[0]}
                  lang={l.lang}
                >
                  {l.label}
                </a>
              ))}
            </nav>
          </div>
        </div>
        {/* The UK tree carries a statutory disclosure the other four don't.
            SI 2015/17 reg 25 (Companies Act 2006 s.82) requires a company to
            disclose its registered name, the part of the UK it is registered
            in, its registered number and its registered office ON ITS WEBSITE
            — and the footer is the only surface guaranteed to appear on every
            page, which is why it lives here and not only on the legal pages.
            `market === "gb"` because only /gb-en carries that value. */}
        {isUk ? (
          <p class="intl-footer-legal">
            {`© ${year} ${entities.uk.legalName} · Registered in ${entities.uk.placeOfRegistration}, ${entities.uk.registerLabel.toLowerCase()} ${entities.uk.registerNumber} · Registered office: ${entities.uk.office.street}, ${entities.uk.office.locality} ${entities.uk.office.postalCode} · `}
            <a href={p("legal/company-details")}>Company details</a>
            {" · "}
            <a href={ukEmail.href}>{ukEmail.display}</a>
            {` · ${c.rights}`}
          </p>
        ) : (
          <p class="intl-footer-legal">
            © {year} {entities.au.legalName} · <a href={`mailto:${c.email}`}>{c.email}</a> ·{" "}
            {c.rights}
          </p>
        )}
      </div>
    </footer>

    {/* Offers the visitor's own market if they landed on another one. Never
        redirects; see the component + scripts/locale-suggest.ts. */}
    <LocaleSuggest />
  </div>
</Base>

<style is:global>
  /* Chrome + shared section styling for the international pages. Global (not
     scoped) because it styles content rendered by the page inside the slot;
     everything is namespaced under .intl so nothing can leak into AU pages
     (which never render this layout). */
  .intl-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--ink-0) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .intl-nav-row {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 64px;
  }
  .intl-links {
    display: flex;
    gap: var(--space-5);
    margin-inline-start: auto;
  }
  .intl-links a {
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  /* Never wrap a nav label. Without this, flex-shrink squeezed each link to
     three lines in the band where the bar is too narrow for the full row —
     visible on every tree, worst in French ("Comment ça marche"). */
  .intl-links a { white-space: nowrap; }
  .intl-links a:hover { color: var(--gold); }
  .intl-actions { display: flex; align-items: center; gap: var(--space-4); }
  .intl-lang {
    color: var(--mist);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 6px 14px;
  }
  .intl-lang:hover { color: var(--gold); border-color: var(--line-gold); }
  .intl-cta-btn { white-space: nowrap; }

  /* ── Shared section building blocks ── */
  .intl section { padding-block: var(--space-9); }
  /* Viewport-relative, not fixed. This was `calc(var(--space-10) * 1.2)` —
     154px of dead space at every height — which at a 900px-tall laptop put the
     hero CTA at y=939, entirely below the fold, with the pill starting 219px
     down. 8vh keeps proportion on tall screens; the clamp floors it on phones
     and caps it on very tall displays. Measured after: CTA at ~740 on 900h. */
  .intl .intl-hero { padding-block: clamp(40px, 8vh, 104px) var(--space-9); }

  /* Hero: text beside a constrained 4:5 image, mirroring the AU hero. Not
     full-bleed — at this rendered size the existing 1920 tier is retina-sharp,
     so no new image width is needed. */
  .intl .intl-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-8);
    align-items: center;
  }
  .intl .intl-hero-visual { max-width: 460px; width: 100%; justify-self: end; }
  .intl .intl-pill { margin-bottom: var(--space-4); }
  /* Single column below the 2-up breakpoint. The image follows the text so the
     headline and CTA stay first on a phone; it keeps `priority` because it is
     still the LCP element once it scrolls in. */
  @media (max-width: 980px) {
    .intl .intl-hero-grid { grid-template-columns: 1fr; gap: var(--space-7); }
    /* Capped rather than full-bleed. A 4:5 portrait at 100vw is both very tall
       on a phone and the heaviest thing on the page: at 360px CSS × DPR 2-3 the
       browser was fetching the 1280 variant as the LCP resource, which put /fr
       at 2779ms against a 2500ms budget. Capping at 460 keeps it on the 768
       variant and reads better besides. `sizes` below must match this cap. */
    .intl .intl-hero-visual { max-width: 460px; justify-self: center; }
  }
  /* Short viewports — phone landscape, split-screen tablets, small laptops.
     At 844×390 the hero measured 681px tall: the headline ran past the fold
     and the CTAs sat ~200px below it, so a visitor turning their phone
     sideways saw no call to action at all. The generous top padding is a
     desktop luxury; compress it rather than letting the fold eat the CTA. */
  @media (max-height: 620px) {
    .intl .intl-hero { padding-block: var(--space-4) var(--space-6); }
    .intl h1 {
      font-size: clamp(1.5rem, 1rem + 2.2vw, 2.1rem);
      margin-bottom: var(--space-3);
    }
    .intl .intl-hero .lede {
      font-size: var(--fs-body);
      margin-bottom: var(--space-3);
      max-width: 60ch;
    }
    .intl .intl-hero .eyebrow { margin-bottom: var(--space-1); }
  }
  .intl .eyebrow {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .intl h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
    max-width: 21ch;
  }
  /* Hero-only: cap the display size exactly as the AU hero does
     (Hero.astro min(var(--fs-h1), 76px)) and let the line run slightly
     longer. Uncapped, the 84px top of the clamp wrapped the UK headline to
     FIVE lines — a 423px h1 that pushed the CTA below a 900px fold. 24ch
     wraps the long UK/FR headlines to four lines; sub-page h1s keep the
     sitewide rule above. */
  .intl .intl-hero h1 {
    font-size: min(var(--fs-h1), 68px);
    max-width: 24ch;
  }
  .intl h2 {
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-4);
    max-width: 26ch;
  }
  .intl h3 { font-size: var(--fs-h3); margin: 0 0 var(--space-2); }
  /* The contact aside's heading is semantically an h2 (see the comment at its
     markup — an h3 there skipped a level from the page h1) but must still read
     as a card heading, not a section one. Level and scale are separate
     concerns; this keeps the fix invisible. */
  .intl .contact-aside h2 {
    font-size: var(--fs-h3);
    margin: 0 0 var(--space-2);
    max-width: none;
  }
  .intl .lede {
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
    color: var(--mist-2);
    max-width: 58ch;
  }
  .intl p { line-height: var(--lh-body); }
  .intl .muted { color: var(--mist); }
  .intl .intl-ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-6); }

  .intl .intl-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: var(--space-7);
  }
  .intl .intl-card {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--space-6);
  }
  .intl .intl-card p { color: var(--mist-2); margin: 0; }

  .intl .intl-points { list-style: none; padding: 0; margin: var(--space-5) 0 0; display: grid; gap: var(--space-3); }
  .intl .intl-points li { padding-inline-start: 1.6em; position: relative; color: var(--mist-2); }
  .intl .intl-points li::before { content: "✓"; position: absolute; inset-inline-start: 0; color: var(--gold); font-weight: 700; }

  /* Five products: the core capability spans the row, the four add-ons sit
     2x2 beneath it. An auto-fit grid laid them 3+2 and orphaned one card.
     NOTE: this style block is `is:global`, so a bare `> :first-child` works —
     the AU equivalent needed `:global()` because its styles are scoped and the
     cards are a child component. */
  .intl .intl-caps-grid { grid-template-columns: repeat(2, 1fr); }
  .intl .intl-caps-grid > :first-child { grid-column: 1 / -1; }
  @media (max-width: 760px) {
    .intl .intl-caps-grid { grid-template-columns: 1fr; }
  }

  .intl .intl-band {
    background: var(--ink-1);
    border-block: 1px solid var(--line);
  }
  /* Attributed quote — its own breathing room, no band. PullQuote's serif and
     scale are the visual break; a band here would collide with the proof band
     immediately above it. */
  .intl .intl-quote { padding-block: var(--space-8); }

  /* FAQ sits on the DEFAULT surface deliberately. FAQ.astro gives its items
     background: var(--ink-1), which is exactly what .intl-band sets on a
     section — banding this would make every item disappear. */
  .intl .intl-faq .faq { margin-inline: auto; }
  .intl .intl-faq h2 { margin-inline: auto; text-align: center; max-width: 22ch; }

  /* Sub-page supporting photo — sits under the intro, breaking the prose run
     on pages that were text-only on every tree until now. */
  .intl .intl-page-image { margin-block: var(--space-6) var(--space-7); }
  /* The /en supporting photo — sits inside the steps section, after the grid,
     so it closes that block rather than reading as a section of its own. */
  .intl .intl-support-image { margin-block-start: var(--space-7); }


  .intl .intl-closing { text-align: center; }
  .intl .intl-closing h2 { margin-inline: auto; }
  .intl .intl-closing p { max-width: 52ch; margin-inline: auto; color: var(--mist-2); }

  .intl .intl-prose { max-width: 68ch; }
  .intl .intl-prose section { padding-block: var(--space-6) 0; }
  .intl .intl-prose p + p { margin-top: var(--space-4); }

  /* ── Footer ── */
  .intl-footer { border-top: 1px solid var(--line); padding-block: var(--space-8); margin-top: var(--space-9); }
  /* AU-like ratio: the brand cell holds a short blurb; the link columns are
     the footer's substance. The old 1.2fr/1fr split gave the BLURB more room
     than all columns combined — with only two columns that produced the big
     dead patch on the right that made the intl footer read as unfinished. */
  .intl-footer-grid { display: grid; gap: var(--space-7); grid-template-columns: minmax(200px, 1fr) 2.2fr; }
  .intl-footer-brand { display: inline-flex; align-items: center; gap: 8px; }
  .intl-footer-blurb { color: var(--mist); max-width: 44ch; margin-top: var(--space-3); font-size: var(--fs-small); }
  /* Negative inline start cancels the icon's own 12px tap padding so the first
     glyph optically aligns with the blurb and the wordmark above it. */
  .intl-social { margin-top: var(--space-4); margin-inline-start: -12px; }
  .intl-social .intl-footer-col-title { margin-inline-start: 12px; }
  /* Column layout inside the labeled columns. auto-fit handles the 2-vs-3
     column trees with no locale branching (the Cities column simply isn't
     rendered where there are no cities). */
  .intl-footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-6);
    align-items: start;
  }
  .intl-footer-col-title {
    margin: 0 0 var(--space-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mist-2);
  }
  .intl-footer-links { display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
  /* 44px targets: these are navigation, not links inside a sentence, so the
     WCAG 2.5.8 inline-text exception does NOT apply — and on phones the footer
     is a primary way to move around the site. */
  .intl-footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--mist-2);
    text-decoration: none;
    font-size: var(--fs-small);
  }
  .intl-footer-links a:hover { color: var(--gold); }
  /* Matches .intl-footer-links a exactly — it's a control, not a link, but it
     sits in the same row and must read and tap identically. */
  .intl-footer-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
