---
/**
 * Shared chrome for /products/[slug] pages.
 *
 * Provides:
 *   - Base layout
 *   - Per-product JSON-LD (Product / SoftwareApplication + BreadcrumbList
 *     + FAQPage when FAQ items are present)
 *   - Hero with status pill + dual CTA
 *   - Slot for the bespoke page body
 *   - Universal Cta at the bottom
 *
 * Pages don't have to render the hero themselves — they fill the
 * `<slot />` with whatever sections suit the product's status.
 */
import Base from "@/layouts/AuBase.astro";
import StatusPill from "@/components/StatusPill.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Cta from "@/components/Cta.astro";
import { bookDemoHref, defaultCtaActions, CTA_LABELS } from "@/data/conversion";
import type { Product } from "@/data/products";
import { solutionsForProduct, solutionPath } from "@/data/solutions";
import { site, pageTitle } from "@/data/site";
import { VOX_ID, voxEditionId, ORG_ID, buildFaqPage } from "@/data/schema";
import { u } from "@/data/locales";

interface Props {
  product: Product;
}
const { product } = Astro.props;
const path = `/products/${product.slug}/`;
// Derived back-reference: the verticals sold on this product (solutions.ts).
const productSolutions = solutionsForProduct(product.slug);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": voxEditionId(product.slug),
  name: product.name,
  description: product.summary,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Phone",
  // This capability page is an edition of the one Vox product.
  isPartOf: { "@id": VOX_ID },
  brand: { "@id": ORG_ID },
  publisher: { "@id": ORG_ID },
  // Cross-link to the running app (same entity, its live location) so the
  // marketing page and the product subdomain resolve to one entity. Only
  // for capabilities that actually have an app to launch.
  ...(product.externalUrl
    ? { url: product.externalUrl, sameAs: [product.externalUrl] }
    : {}),
  ...(product.pricing && product.pricing.tiers.length > 0 && (() => {
    const priced = product.pricing.tiers
      .map((t) => Number(t.amount.replace(/[^0-9.]/g, "")))
      .filter((n) => Number.isFinite(n) && n > 0);
    if (priced.length === 0) return {};
    return {
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "AUD",
        lowPrice: Math.min(...priced).toString(),
        highPrice: Math.max(...priced).toString(),
        offerCount: product.pricing.tiers.length.toString(),
        availability: "https://schema.org/InStock",
      },
    };
  })()),
};

const faqJsonLd = product.faq && product.faq.length > 0 ? buildFaqPage(product.faq, "en-AU") : null;
---

<Base
  title={pageTitle(product.seo.title)}
  description={product.seo.description}
  path={path}
  ogImage={`/og/${product.slug}.png`}
  preloadComposite={product.slug === "voxtable" ? "voxtable-hero" : undefined}
>
  <Fragment slot="jsonld">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
    {faqJsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <header class="prod-hero">
    <div class="prod-hero-glow" aria-hidden="true" style={`--accent:${product.accent}`}></div>
    <div class="wrap">
      <Breadcrumbs items={[
        { label: "Home", href: u("/") },
        { label: "Products", href: u("/products/") },
        { label: product.name },
      ]} />
      <div class="prod-hero-row">
        <div class="prod-hero-name" transition:name={`product-title-${product.slug}`}>
          <span class="prefix">{product.wordmark.prefix}</span><span class="suffix">{product.wordmark.suffix}</span>
        </div>
        <span transition:name={`product-pill-${product.slug}`}>
          <StatusPill status={product.status} />
        </span>
      </div>
      <h1 class="prod-hero-h">{product.hero.headline}</h1>
      <p class="prod-hero-sub">{product.hero.sub}</p>
      <div class="prod-hero-cta">
        <a
          class="btn"
          href={product.hero.primaryCta.href}
          rel={product.hero.primaryCta.href.startsWith("http") ? "noopener" : undefined}
          target={product.hero.primaryCta.href.startsWith("http") ? "_blank" : undefined}
        >{product.hero.primaryCta.label}</a>
        {product.hero.secondaryCta && (
          <a
            class="btn-ghost"
            href={product.hero.secondaryCta.href}
            rel={product.hero.secondaryCta.href.startsWith("http") ? "noopener" : undefined}
            target={product.hero.secondaryCta.href.startsWith("http") ? "_blank" : undefined}
          >
            {product.hero.secondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </header>

  <slot />

  {productSolutions.length > 0 && (
    <section class="prod-solutions cv-auto">
      <div class="wrap">
        <span class="eyebrow">Solutions using {product.name}</span>
        <h2 class="prod-solutions-h">Tuned for how your venue takes calls.</h2>
        <ul class="prod-solutions-list" role="list">
          {productSolutions.map((s) => (
            <li><a class="pressable" href={u(solutionPath(s.slug))}>{s.name} →</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Cta
    eyebrow={product.status === "live" ? "Book a demo" : `Try ${product.name}`}
    headline={product.status === "live"
      ? `Bring ${product.name} to your venue.`
      : `Want to be first to use ${product.name}?`}
    lede={product.status === "live"
      ? "Most venues are live within a week. Book a 15-minute walkthrough — or open the product if you already know you want it."
      : "Join the waitlist and we'll bring you in early. We'd rather start with a small group of venues that genuinely need the product than open the gates."}
    primary={
      product.status === "live" && product.externalUrl
        ? { label: `Open ${product.name} →`, href: product.externalUrl }
        : product.status === "live"
          ? defaultCtaActions({ product: product.slug }).primary
          : { label: "Join the waitlist", href: bookDemoHref({ product: product.slug }) }
    }
    secondary={
      product.status === "live" && product.externalUrl
        ? { label: CTA_LABELS.bookDemo, href: bookDemoHref({ product: product.slug }) }
        : defaultCtaActions({ product: product.slug }).secondary
    }
  />
</Base>

<style>
  .prod-solutions { padding-block: var(--space-section); border-top: 1px solid var(--line); }
  .prod-solutions-h { margin-top: 12px; font-size: var(--fs-h2); font-weight: 800; letter-spacing: -0.02em; line-height: var(--lh-display); color: var(--white); max-width: 22ch; }
  .prod-solutions-list { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .prod-solutions-list a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--white); font-weight: 600; }
  .prod-hero {
    position: relative;
    padding: clamp(120px, 16vw, 200px) 0 clamp(64px, 8vw, 96px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .prod-hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 60% at 80% 0%, var(--accent), transparent 70%),
      radial-gradient(40% 50% at 0% 100%, rgba(26, 77, 26, 0.25), transparent 70%);
  }
  .prod-hero .wrap { position: relative; z-index: 1; }
  .prod-hero-row {
    margin-top: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .prod-hero-name {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .prod-hero-name .prefix { color: var(--white); }
  .prod-hero-name .suffix { color: var(--mist); font-weight: 300; }
  .prod-hero-h {
    margin-top: 28px;
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: -0.025em;
    max-width: 18ch;
    color: var(--white);
  }
  .prod-hero-sub {
    margin-top: 22px;
    color: var(--text);
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
    max-width: 60ch;
  }
  .prod-hero-cta {
    margin-top: 36px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
