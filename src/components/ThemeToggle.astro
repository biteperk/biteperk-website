---
/**
 * Light/dark theme toggle. Progressive enhancement: hidden until JS runs
 * (no-JS visitors get the OS-preference theme via CSS, so a dead button
 * would only mislead). aria-pressed reflects "light theme on".
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Switch theme"
  hidden
>
  <!-- Sun (shown in dark mode: "switch to light") -->
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
  </svg>
  <!-- Moon (shown in light mode: "switch to dark") -->
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
</button>

<script>
  // Reveal the toggle only when JS is available. Runs on every page load
  // (idempotent) so toggles arriving via View Transitions un-hide too.
  const show = () =>
    document
      .querySelectorAll("[data-theme-toggle][hidden]")
      .forEach((el) => el.removeAttribute("hidden"));
  show();
  document.addEventListener("astro:page-load", show);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: var(--fill-subtle);
    color: var(--white);
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    background: var(--fill-hover);
    border-color: var(--line-strong);
  }
  .theme-toggle[hidden] {
    display: none;
  }

  /* Show the icon for the theme you'd switch TO. */
  .icon-moon { display: none; }
  :global([data-theme="light"]) .icon-sun { display: none; }
  :global([data-theme="light"]) .icon-moon { display: block; }
</style>
