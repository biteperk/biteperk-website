---
/**
 * Page-end CTA block. Eyebrow + headline + dual action.
 *
 * Phase 1E defaults: Book Demo (primary) + See How It Works (secondary).
 * Override per page when the commercial intent differs (waitlist, external trial).
 */
import { defaultCtaActions } from "@/data/conversion";

const phase1Defaults = defaultCtaActions();

interface Props {
  eyebrow?: string;
  headline?: string;
  lede?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  eyebrow = "Book a demo",
  headline = "Let's put Vox on your line.",
  lede = "Fifteen minutes is enough to hear it, map your overflow, and decide if BitePerk fits — no slide deck required.",
  primary = phase1Defaults.primary,
  secondary = phase1Defaults.secondary,
} = Astro.props;
---

<section class="cta-block grain cv-auto">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="reveal cta-inner">
      <span class="pill">
        <span class="dot"></span>
        {eyebrow}
      </span>
      <h2 class="cta-h">{headline}</h2>
      {lede && <p class="cta-lede lede">{lede}</p>}
      <div class="cta-actions">
        <a
          class="btn"
          href={primary.href}
          data-cta={primary.href.includes("intent=demo") ? "book-demo" : undefined}
        >{primary.label}</a>
        <a class="btn-ghost" href={secondary.href}>{secondary.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-block {
    padding-block: var(--space-section);
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .cta-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(50% 60% at 50% 30%, rgba(245, 196, 24, 0.22), transparent 70%);
    pointer-events: none;
  }
  .cta-block .wrap { position: relative; z-index: 1; }
  .cta-inner { max-width: 720px; margin: 0 auto; }
  .cta-h {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: -0.025em;
    margin-top: 22px;
    color: var(--white);
  }
  .cta-lede {
    margin: 22px auto 0;
    color: var(--text);
  }
  .cta-actions {
    margin-top: 36px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
