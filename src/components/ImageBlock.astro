---
/**
 * Responsive picture for the photo catalogue.
 *
 * Renders AVIF → WebP → JPG fallback chain at three widths, with the
 * LQIP base64 thumbnail behind every image until the full asset loads.
 *
 * Props:
 *   - slug      The catalogue slug (must match a file in /public/images/)
 *   - alt       Alt text (required; '' for purely decorative photos)
 *   - aspect    CSS aspect-ratio (e.g. "4 / 5", "16 / 10"). Reserves
 *               space so there's zero CLS.
 *   - priority  When true: loading=eager, fetchpriority=high, no lazy.
 *               Use on the LCP candidate of the page only.
 *   - widths    Comma-separated CSS `sizes` value. Default: "(min-width:1024px) 50vw, 100vw"
 *   - rounded   If true, applies the standard r-lg radius + overflow:hidden
 *   - scrim     If true, layers --overlay-scrim gradient over the photo
 */
import placeholders from "@/data/image-placeholders.json";
import { u } from "@/data/locales";

interface Props {
  slug: string;
  alt: string;
  aspect: string;
  priority?: boolean;
  /** Fetch at LOW priority. For images in the initial viewport on pages whose
      LCP is text — see the fetchpriority note below. Mutually exclusive with
      `priority`. */
  deprioritize?: boolean;
  widths?: string;
  rounded?: boolean;
  scrim?: boolean;
  class?: string;
}

const {
  slug,
  alt,
  aspect,
  priority = false,
  deprioritize = false,
  widths = "(min-width: 1024px) 50vw, 100vw",
  rounded = true,
  scrim = false,
  class: extraClass,
} = Astro.props;

const map = placeholders as Record<string, string>;
const lqip = map[slug];
const base = u(`/images/${slug}`);
const loading = priority ? "eager" : "lazy";
// `deprioritize` exists for exactly one shape of image: in the initial
// viewport, but on a page whose LCP element is TEXT. `loading="lazy"` does
// NOT defer an in-viewport image — the browser fetches it immediately at
// normal priority, racing the webfont the text paint waits on. Measured on
// the intl homes when the hero moved up into the mobile viewport: /be-en
// (141KB hero) went 2103 → 2931ms LCP, /en (86KB) 2030 → 2478, ordered
// exactly by image weight. fetchpriority="low" lets the font win the race.
const fetchpriority = priority ? "high" : deprioritize ? "low" : "auto";
// Always async: sync decode blocks the main thread at exactly the moment
// the LCP paint is due (measured +ve on throttled-mobile Lighthouse).
const decoding = "async";
---

<figure
  class:list={["image-block", { rounded, scrim }, extraClass]}
  style={`aspect-ratio: ${aspect}; ${lqip ? `background-image:url(${lqip});` : ""}`}
>
  <picture>
    <source
      type="image/avif"
      srcset={`${base}-768.avif 768w, ${base}-1280.avif 1280w, ${base}-1920.avif 1920w`}
      sizes={widths}
    />
    <source
      type="image/webp"
      srcset={`${base}-768.webp 768w, ${base}-1280.webp 1280w, ${base}-1920.webp 1920w`}
      sizes={widths}
    />
    <img
      src={`${base}-1280.jpg`}
      srcset={`${base}-768.jpg 768w, ${base}-1280.jpg 1280w, ${base}-1920.jpg 1920w`}
      sizes={widths}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-fade={!priority && !deprioritize ? "" : undefined}
    />
  </picture>
  {scrim && <span class="image-block-scrim" aria-hidden="true"></span>}
</figure>

<style>
  .image-block {
    position: relative;
    width: 100%;
    margin: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--ink-1);
    overflow: hidden;
  }
  .image-block.rounded {
    border-radius: var(--r-lg);
  }
  .image-block picture,
  .image-block img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .image-block img {
    object-fit: cover;
    object-position: center;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  /* Fade below-the-fold catalogue images up from their LQIP blur once they
     decode (image-fade.ts adds .is-loaded). Gated on `html.js` so a no-JS
     visitor always sees the image; `data-fade` is set only for non-priority,
     non-deprioritized images, so the eager LCP hero and the near-LCP
     deprioritized heroes paint immediately (LCP untouched).
     NB: the reveal rule carries `html.js` too (specificity 0,4,2) so it
     out-ranks the hidden rule (0,3,2) — otherwise .is-loaded would lose and
     the image would stay invisible. */
  html.js .image-block img[data-fade] {
    opacity: 0;
  }
  html.js .image-block img[data-fade].is-loaded {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .image-block img[data-fade] {
      opacity: 1;
    }
    .image-block img {
      transition: none;
    }
  }
  .image-block-scrim {
    position: absolute;
    inset: 0;
    background: var(--overlay-scrim);
    pointer-events: none;
  }
</style>
