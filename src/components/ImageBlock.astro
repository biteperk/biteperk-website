---
/**
 * Responsive picture for the photo catalogue.
 *
 * Renders AVIF → WebP → JPG fallback chain at three widths, with the
 * LQIP base64 thumbnail behind every image until the full asset loads.
 *
 * Props:
 *   - slug      The catalogue slug (must match a file in /public/images/)
 *   - alt       Alt text (required; '' for purely decorative photos)
 *   - aspect    CSS aspect-ratio (e.g. "4 / 5", "16 / 10"). Reserves
 *               space so there's zero CLS.
 *   - priority  When true: loading=eager, fetchpriority=high, no lazy.
 *               Use on the LCP candidate of the page only.
 *   - widths    Comma-separated CSS `sizes` value. Default: "(min-width:1024px) 50vw, 100vw"
 *   - rounded   If true, applies the standard r-lg radius + overflow:hidden
 *   - scrim     If true, layers --overlay-scrim gradient over the photo
 */
import placeholders from "@/data/image-placeholders.json";

interface Props {
  slug: string;
  alt: string;
  aspect: string;
  priority?: boolean;
  widths?: string;
  rounded?: boolean;
  scrim?: boolean;
  class?: string;
}

const {
  slug,
  alt,
  aspect,
  priority = false,
  widths = "(min-width: 1024px) 50vw, 100vw",
  rounded = true,
  scrim = false,
  class: extraClass,
} = Astro.props;

const map = placeholders as Record<string, string>;
const lqip = map[slug];
const base = `/images/${slug}`;
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : "auto";
const decoding = priority ? "sync" : "async";
---

<figure
  class:list={["image-block", { rounded, scrim }, extraClass]}
  style={`aspect-ratio: ${aspect}; ${lqip ? `background-image:url(${lqip});` : ""}`}
>
  <picture>
    <source
      type="image/avif"
      srcset={`${base}-768.avif 768w, ${base}-1280.avif 1280w, ${base}-1920.avif 1920w`}
      sizes={widths}
    />
    <source
      type="image/webp"
      srcset={`${base}-768.webp 768w, ${base}-1280.webp 1280w, ${base}-1920.webp 1920w`}
      sizes={widths}
    />
    <img
      src={`${base}-1280.jpg`}
      srcset={`${base}-768.jpg 768w, ${base}-1280.jpg 1280w, ${base}-1920.jpg 1920w`}
      sizes={widths}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  </picture>
  {scrim && <span class="image-block-scrim" aria-hidden="true"></span>}
</figure>

<style>
  .image-block {
    position: relative;
    width: 100%;
    margin: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--ink-1);
    overflow: hidden;
  }
  .image-block.rounded {
    border-radius: var(--r-lg);
  }
  .image-block picture,
  .image-block img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .image-block img {
    object-fit: cover;
    object-position: center;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .image-block-scrim {
    position: absolute;
    inset: 0;
    background: var(--overlay-scrim);
    pointer-events: none;
  }
</style>
