---
/**
 * SEO meta tags + Open Graph + canonical + JSON-LD slot.
 *
 * Every page renders <SEO> inside Base.astro's head. The canonical URL
 * is derived from `Astro.url`, falling back to the `path` prop.
 *
 * Per-page Open Graph image: pass `ogImage="/og/<slug>.png"`. Cards are
 * 1200×630 PNGs generated by scripts/brand/generate-og.mjs.
 */
import { site } from "@/data/site";
import { abs, stripBase } from "@/data/locales";

interface Props {
  title: string;
  description?: string;
  /** Path relative to site root, e.g. "/pricing". Builds the canonical URL. */
  path?: string;
  /** OG image absolute path (default /og/default.png). */
  ogImage?: string;
  /** Type override for og:type. Default "website". */
  type?: "website" | "article";
  /** When true, emits robots:noindex. Use for /__kitchen-sink etc. */
  noindex?: boolean;
  /** og:locale value. Defaults to en_AU (the AU build); global locales pass en / fr. */
  ogLocale?: string;
}

const {
  title,
  description = site.description,
  path,
  ogImage = "/og/default.png",
  type = "website",
  noindex = false,
  ogLocale = "en_AU",
} = Astro.props;

// Single-domain canonical/OG: everything lives on biteperk.com under the
// current locale's base path. `path` props are base-less app paths ("/products/…");
// abs() joins origin + locale base + path. The Astro.url fallback may already
// carry the base, so stripBase() normalises it before abs() re-adds it.
const canonicalPath = path ?? stripBase(new URL(Astro.request.url).pathname);
const canonical = abs(canonicalPath);
const ogImageAbs = abs(ogImage);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />
<meta name="twitter:image:alt" content={title} />

<slot name="jsonld" />
