---
/**
 * Section header — eyebrow + headline + optional lede.
 *
 * Used at the top of every major section to enforce typographic rhythm
 * site-wide. Headline supports a `<slot name="headline">` override for
 * mixed-colour or multi-line phrasing.
 */
interface Props {
  eyebrow?: string;
  headline?: string;
  lede?: string;
  align?: "start" | "center";
  /** Whether to mark this header as a `.reveal` so it animates in. */
  reveal?: boolean;
  /** Heading level for the headline. Use "h1" when this is the page's
   * primary heading (e.g. a page hero); defaults to "h2" for sections. */
  as?: "h1" | "h2";
}

const { eyebrow, headline, lede, align = "start", reveal = true, as: Heading = "h2" } = Astro.props;
const classes = ["section-header", `align-${align}`, reveal && "reveal"]
  .filter(Boolean)
  .join(" ");
---

<header class={classes}>
  {eyebrow && (
    <div class="section-header-eyebrow">
      <span class="eyebrow">{eyebrow}</span>
    </div>
  )}
  <Heading class="section-header-h">
    {headline ? headline : <slot name="headline" />}
  </Heading>
  {(lede || Astro.slots.has("lede")) && (
    <p class="section-header-lede lede">
      {lede ? lede : <slot name="lede" />}
    </p>
  )}
</header>

<style>
  .section-header { max-width: 880px; }
  .align-center { margin-inline: auto; text-align: center; }
  .section-header-eyebrow { margin-bottom: 20px; }
  .section-header-h {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: -0.025em;
    color: var(--white);
  }
  .section-header-h :global(.gold) { color: var(--gold); }
  .section-header-h :global(.mist) { color: var(--mist); }
  .section-header-lede {
    margin-top: 22px;
    color: var(--text);
  }
</style>
