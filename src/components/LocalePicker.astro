---
/**
 * Country / region picker — the Accenture-style globe.
 *
 * Collapsed it is a 44px pill (globe + a 2-char region chip) that matches the
 * ThemeToggle / phone control idiom in the nav. The spelled-out labels live
 * inside the menu ONLY: the bar carries a mega-menu, six links and four right-
 * hand controls, and a ~200px "Australia — English" trigger overflowed the
 * centre track and painted the links over the wordmark. See Nav.astro's
 * width-budget comment — the chip is what keeps the bar inside it.
 *
 * Rendered by Nav.astro (AU build) and IntlLayout.astro (global build). The
 * active locale is derived from the served path, so one component covers both.
 *
 * Progressive enhancement, deliberately: this stays a native <details>, so it
 * works with no JS (unlike the mega-menu's button+div). scripts/locale-picker.ts
 * layers on Escape, outside-click, arrow-key roving and View-Transition resets.
 * A region picker is international-navigation surface — it should never depend
 * on JS to be usable or crawlable.
 */
import { locales, localeFromPath, localeSwitchUrl } from "@/data/locales";

interface Props {
  /** Menu heading, localised. Defaults to English for the AU chrome. */
  title?: string;
}
const { title = "Choose your region" } = Astro.props;

const path = Astro.url.pathname;
const current = localeFromPath(path);

// Market indicator (Pillar 1 closeout, 7 Sep 2026): append the language to the
// chip ONLY where another locale shares the same `short` — i.e. the Belgium
// pair, where "BE" alone doesn't say which tree you are on. Everywhere else
// the language would be redundant ("EN · EN", "FR · FR") and the extra width
// is what the AU desktop bar's budget cannot afford (see the width comment
// below). Derived from locales.ts — never a hardcoded list.
const shortIsShared = locales.some((l) => l.short === current.short && l.base !== current.base);
const chip = shortIsShared ? `${current.short} · ${current.copyLang.toUpperCase()}` : current.short;
---

<details class="lp" data-locale-picker>
  <summary class="lp-trigger" data-locale-picker-trigger>
    <svg class="lp-globe" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"></path>
    </svg>
    <span class="lp-chip">{chip}</span>
    <svg class="lp-caret" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
    <span class="sr-only">Region and language — currently {current.label}</span>
  </summary>

  <div class="lp-scrim" data-locale-picker-scrim aria-hidden="true"></div>

  <div class="lp-menu" data-locale-picker-menu>
    <span class="lp-grabber" aria-hidden="true"></span>
    <div class="lp-menu-header">
      <p class="lp-menu-title">{title}</p>
      <button type="button" class="lp-menu-close" data-locale-picker-close aria-label="Close region picker">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <ul class="lp-list" role="list">
      {locales.map((l) => (
        <li>
          <a
            class:list={["lp-item", { "is-current": l.base === current.base }]}
            href={localeSwitchUrl(path, l)}
            hreflang={l.hreflang[0]}
            lang={l.lang}
            aria-current={l.base === current.base ? "true" : undefined}
            data-locale-picker-item
          >
            <span class="lp-item-chip" aria-hidden="true">{l.short}</span>
            <span class="lp-item-label">{l.label}</span>
            <svg class="lp-check" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.2 5.2L20 7"></path></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>

<style>
  .lp {
    position: relative;
    line-height: 1;
  }

  /* Mobile-sheet-only affordances (grabber, close button). Hidden here
     unconditionally so they never show on the desktop dropdown even while
     it's open — the ≤720px block below re-enables them. Safe to gate on
     plain display:none/block because both live nested inside .lp-menu,
     whose own visibility already comes for free from the native
     details:not([open]) > :not(summary) rule; a display:none ancestor hides
     this whole subtree regardless of their own display value. */
  .lp-grabber { display: none; }
  .lp-menu-close { display: none; }

  /* .lp-scrim is a SIBLING of .lp-menu (not nested inside it), so it does
     NOT inherit .lp-menu's free open/close hiding once its own display is
     authored. Hide it above the phone breakpoint here; below it, in the
     ≤720px block, its display is deliberately left unset so it shares the
     exact same native <details> toggle .lp-menu already relies on. Setting
     display:block unconditionally inside the mobile block instead would
     fight that native toggle and leave the scrim stuck visible at all
     times, open or closed — see the comment on the mobile block. */
  @media (min-width: 721px) {
    .lp-scrim { display: none; }
  }

  /* ── Trigger: matches the 44px pill idiom of ThemeToggle / .nav-phone ── */
  .lp-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 44px;
    padding: 0 9px 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--fill-subtle);
    color: var(--white);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .lp-trigger::-webkit-details-marker { display: none; }
  /* Hover-capable pointers ONLY. On iOS a :hover rule on a control makes the
     first tap apply the hover state and only the second activate it — the
     picker measurably needed two taps on a real iPhone before this guard. */
  @media (hover: hover) {
    .lp-trigger:hover {
      background: var(--fill-hover);
      border-color: var(--line-strong);
    }
  }
  .lp[open] > .lp-trigger {
    background: var(--fill-hover);
    border-color: var(--line-strong);
  }
  .lp-globe { color: var(--gold); }
  .lp-chip {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.055em;
    font-variant-numeric: tabular-nums;
  }
  .lp-caret {
    opacity: 0.55;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .lp[open] .lp-caret { transform: rotate(180deg); }

  /* ── Menu: the house floating-panel surface (see NavDropdown) ──
     --ink-1 + --white/--mist-2 are all theme-scoped and already declared in
     tokens.css's contrast-manifest. The previous `var(--surface, #14151a)`
     resolved to the hardcoded fallback in BOTH themes (--surface is not a
     token), so light mode rendered a dark slab with ~1.6:1 text. */
  .lp-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 60;
    min-width: 17.25rem;
    padding: 6px;
    background: color-mix(in srgb, var(--ink-1) 96%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow:
      0 18px 44px -12px rgba(0, 0, 0, 0.5),
      0 2px 8px -2px rgba(0, 0, 0, 0.28);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lp[open] .lp-menu {
      animation: lp-in 180ms var(--ease-soft) backwards;
    }
  }
  @keyframes lp-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .lp-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .lp-menu-title {
    margin: 0;
    padding: 7px 10px 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mist-2);
  }
  .lp-list { margin: 0; padding: 0; list-style: none; }

  .lp-item {
    display: flex;
    align-items: center;
    gap: 10px;
    /* 44px minimum touch target — this menu is reachable on tablets. */
    min-height: 44px;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--text);
    font-size: 14px;
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .lp-item:focus-visible {
    background: var(--fill-hover);
    color: var(--white);
    border-color: color-mix(in srgb, var(--gold) 18%, transparent);
  }
  @media (hover: hover) {
    .lp-item:hover {
      background: var(--fill-hover);
      color: var(--white);
      border-color: color-mix(in srgb, var(--gold) 18%, transparent);
    }
  }
  .lp-item.is-current {
    color: var(--white);
    font-weight: 600;
  }

  .lp-item-chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 22px;
    border-radius: 6px;
    background: var(--fill-subtle);
    border: 1px solid var(--line);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--mist-2);
  }
  .lp-item.is-current .lp-item-chip {
    background: color-mix(in srgb, var(--gold) 14%, transparent);
    border-color: color-mix(in srgb, var(--gold) 34%, transparent);
    color: var(--gold);
  }
  /* One line per region — "International — Français" wrapping to two lines
     made the rows ragged and uneven. */
  .lp-item-label { flex: 1 1 auto; white-space: nowrap; }

  .lp-check {
    flex: none;
    color: var(--gold);
    opacity: 0;
  }
  .lp-item.is-current .lp-check { opacity: 1; }

  /* ── Phones: a true edge-to-edge bottom sheet, with a scrim ──────────
     The trigger sits mid-bar in the intl chrome (brand · picker · toggle), so
     NEITHER anchor fits a floating menu: `right:0` overflows the left edge
     and `left:0` overflows the right edge. Anchoring to the viewport instead
     of the trigger avoids that entirely, and going edge-to-edge (flush to
     the bottom, rounded top corners only) plus a scrim behind it reads as a
     deliberate iOS-style sheet instead of a stray floating card glued mid-page.

     Requires no backdrop-filter on any ancestor: a filtered element becomes
     the containing block for fixed descendants (IntlLayout drops its filter
     at this breakpoint for exactly this reason). The AU chrome never hits
     this rule — below 1180px its picker lives in the overlay menu instead.

     Every hardcoded value below (scrim color/blur, upward shadow, the
     translateY(100%) slide, the inset:auto 0 0 0 anchor) is lifted from
     ConsentBanner.astro's .consent-bar/.consent-backdrop/consent-slide,
     not invented — that's this codebase's own precedent for a real
     bottom-anchored sheet with a scrim. */
  @media (max-width: 720px) {
    /* No `display` here on purpose — see the note above the desktop-only
       hiding rule. Visibility comes entirely from the native <details>
       open/close toggle this element shares with .lp-menu (same DOM level,
       same UA default); only its look, once shown, is authored here. */
    .lp-scrim {
      position: fixed;
      inset: 0;
      z-index: var(--z-overlay);
      background: rgba(10, 11, 13, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    @media (prefers-reduced-motion: no-preference) {
      .lp[open] .lp-scrim {
        animation: lp-scrim-in var(--dur-base) var(--ease-out) backwards;
      }
    }
    @keyframes lp-scrim-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    .lp-menu {
      position: fixed;
      inset: auto 0 0 0;
      z-index: calc(var(--z-overlay) + 1);
      min-width: 0;
      max-height: min(60vh, 420px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 10px 16px calc(16px + env(safe-area-inset-bottom));
      border: 0;
      border-top: 1px solid var(--line);
      border-radius: var(--r-xl) var(--r-xl) 0 0;
      box-shadow: 0 -12px 40px -20px rgba(0, 0, 0, 0.6);
    }
    @media (prefers-reduced-motion: no-preference) {
      .lp[open] .lp-menu {
        animation: lp-sheet-in var(--dur-base) var(--ease-out) backwards;
      }
    }
    @keyframes lp-sheet-in {
      from { transform: translateY(100%); opacity: 0; }
      to   { transform: translateY(0); opacity: 1; }
    }

    .lp-grabber {
      display: block;
      width: 36px;
      height: 4px;
      margin: 2px auto 10px;
      border-radius: var(--r-pill);
      background: var(--line-strong);
    }

    .lp-menu-header { padding: 0 0 4px; }
    .lp-menu-title { padding: 0; }

    .lp-menu-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 30px;
      height: 30px;
      border: 1px solid var(--line);
      border-radius: var(--r-pill);
      background: var(--fill-subtle);
      color: var(--mist-2);
      cursor: pointer;
    }
    @media (hover: hover) {
      .lp-menu-close:hover {
        background: var(--fill-hover);
        color: var(--white);
        border-color: var(--line-strong);
      }
    }
    .lp-menu-close:focus-visible {
      outline: none;
      box-shadow: var(--ring-focus);
    }

    .lp-item { min-height: 48px; }
  }
</style>
