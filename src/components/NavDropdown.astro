---
/**
 * Products mega-menu.
 *
 * Rebuilt on a conventional WAI-ARIA pattern:
 *   <div data-megamenu>
 *     <button data-megamenu-trigger aria-haspopup="menu" aria-expanded="false">
 *     <div data-megamenu-panel role="menu" hidden>
 *
 * Control logic lives in src/scripts/megamenu.ts (deferred, typed).
 * Critical layout (position: absolute, etc.) lives in
 * src/styles/megamenu.css as Layer 1 GLOBAL — survives cache drift.
 *
 * This component's <style> block is Layer 2 — polish only (animation,
 * gold accents, hover micro-states, status pills). If it ever fails
 * to load, the menu still works because Layer 1 carries the layout.
 */
import { products, statusLabel, productUrl } from "@/data/products";
import { site } from "@/data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string): boolean {
  const n = href.replace(/\/$/, "") || "/";
  return pathname === n || pathname.startsWith(n + "/");
}
const onProducts = pathname === "/products" || pathname.startsWith("/products/");
---

<div class="megamenu" data-megamenu>
  <button
    type="button"
    class:list={["lnk", "megamenu-trigger", { active: onProducts }]}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="megamenu-products-panel"
    data-megamenu-trigger
  >
    Products
    <svg class="megamenu-chev" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
      <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div
    id="megamenu-products-panel"
    class="megamenu-panel"
    role="menu"
    aria-label="Products"
    hidden
    data-megamenu-panel
  >
    <div class="megamenu-head">
      <span class="megamenu-eyebrow">One AI phone host</span>
      <p class="megamenu-head-lede">
        Voco answers every call in a warm Australian voice. Bookings and takeaway are live — concierge and drive-thru switch on as you grow.
      </p>
    </div>

    <div class="megamenu-grid">
      {products.map((p) => (
        <a
          class:list={["megamenu-card", `is-${p.status}`, { active: isActive(productUrl(p)) }]}
          href={productUrl(p)}
          role="menuitem"
          tabindex="-1"
          aria-current={isActive(productUrl(p)) ? "page" : undefined}
        >
          <div class="megamenu-card-head">
            <span class="megamenu-card-name">
              <span class="kicker">{p.wordmark.prefix}</span>
              <span class="cap">{p.wordmark.suffix}</span>
            </span>
            <span class:list={["megamenu-pill", `is-${p.status}`]}>{statusLabel(p.status)}</span>
          </div>
          <p class="megamenu-card-tag">{p.outcome ?? p.tagline}</p>
          <span class="megamenu-card-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <footer class="megamenu-foot">
      <a class="megamenu-foot-link" href="/products/" role="menuitem" tabindex="-1">
        <span>See how Voco works</span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="megamenu-foot-link" href={site.phone.href} role="menuitem" tabindex="-1">
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <path d="M3.4 2.5C3 2.9 2.9 3.6 3.2 4.2c1.4 3 3.6 5.2 6.6 6.6.6.3 1.3.2 1.7-.2l.9-.9c.3-.3.3-.8 0-1.1l-1.5-1.5c-.3-.3-.8-.3-1.1 0l-.6.6c-1.5-.7-2.7-1.9-3.4-3.4l.6-.6c.3-.3.3-.8 0-1.1L4.9 1.1c-.3-.3-.8-.3-1.1 0z" fill="currentColor"/>
        </svg>
        <span>Talk to us · {site.phone.display}</span>
      </a>
    </footer>
  </div>
</div>

<style>
  /* Layer 2 — polish only. Layer 1 (src/styles/megamenu.css) carries
     the survival-critical position/display rules. */

  .megamenu-trigger {
    font-size: 14px;
    font-weight: 500;
    color: var(--mist-2);
    padding: 8px 13px;
    border-radius: var(--r-md);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .megamenu-trigger:hover,
  .megamenu-trigger.active {
    color: var(--white);
    background: var(--fill-hover);
  }
  .megamenu-chev {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .megamenu.is-open .megamenu-chev { transform: rotate(180deg); }

  .megamenu-panel {
    background: color-mix(in srgb, var(--ink-1) 96%, transparent);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border-color: var(--line);
    box-shadow:
      var(--shadow-card),
      0 0 0 1px color-mix(in srgb, var(--gold-fill) 4%, transparent);
    opacity: 0;
    transform: translate(-50%, -8px);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .megamenu.is-open .megamenu-panel {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .megamenu-panel {
      transition: none;
      transform: translate(-50%, 0);
    }
  }

  /* Header — establishes Voco as the one product above the capabilities */
  .megamenu-head {
    padding: 0 10px 14px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--line);
  }
  .megamenu-eyebrow {
    font-size: 10.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
  }
  .megamenu-head-lede {
    margin-top: 7px;
    color: var(--mist-2);
    font-size: 12.5px;
    line-height: 1.5;
    max-width: 56ch;
  }

  /* Cards */
  .megamenu-card {
    border: 1px solid transparent;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .megamenu-card:hover,
  .megamenu-card.active,
  .megamenu-card:focus-visible {
    background: var(--fill-hover);
    border-color: color-mix(in srgb, var(--gold) 18%, transparent);
  }
  .megamenu-card:hover .megamenu-card-arrow {
    transform: translateX(3px);
    opacity: 1;
  }
  .megamenu-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .megamenu-card-name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .megamenu-card-name .kicker {
    font-size: 10px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
  }
  .megamenu-card-name .cap {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--white);
  }
  .megamenu-card-tag {
    margin-top: 9px;
    color: var(--text);
    font-size: 12.5px;
    line-height: 1.5;
    max-width: 30ch;
  }
  .megamenu-card-arrow {
    position: absolute;
    right: 18px;
    bottom: 16px;
    color: var(--gold);
    font-size: 16px;
    opacity: 0;
    transition:
      transform var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  /* Status pills */
  .megamenu-pill {
    font-size: 9.5px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }
  .megamenu-pill.is-live { background: var(--gold-fill); color: var(--gold-fill-text); }
  .megamenu-pill.is-in-development {
    color: var(--gold);
    background: color-mix(in srgb, var(--gold-fill) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--gold) 32%, transparent);
  }
  .megamenu-pill.is-concept {
    color: var(--mist-2);
    background: var(--fill-subtle);
    border: 1px solid var(--line);
  }

  /* Footer */
  .megamenu-foot-link {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--mist-2);
    letter-spacing: 0.2px;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .megamenu-foot-link:first-child { color: var(--gold); }
  .megamenu-foot-link:hover,
  .megamenu-foot-link:focus-visible {
    color: var(--white);
    background: var(--fill-hover);
  }
  .megamenu-foot-link svg { color: var(--gold); }
</style>
