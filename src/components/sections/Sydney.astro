---
/**
 * Sydney block — the brand's soul. Two-column narrative on the left, a
 * framed Sydney-harbour photo on the right with a single-line caption.
 */
import ImageBlock from "@/components/ImageBlock.astro";
---

<section class="sydney">
  <div class="sydney-bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="sydney-grid">
      <div class="reveal">
        <div class="eyebrow">Sydney, end to end</div>
        <h2>
          Built here.
          <br />
          <span class="gold">Answered here.</span>
        </h2>
        <p class="sydney-body">
          Every line of Biteperk code is written, deployed and supported from Sydney. Our
          servers live in Australian data centres, the phone numbers are Australian, and the
          voice that greets your guests sounds like one of them. We're an AI company that
          behaves like a neighbourhood business — because the restaurants we serve are
          neighbourhood businesses too.
        </p>
        <div class="sydney-meta">
          <div>
            <div class="meta-n">100%</div>
            <div class="meta-l">made in Sydney</div>
          </div>
          <div>
            <div class="meta-n">AU</div>
            <div class="meta-l">data residency</div>
          </div>
          <div>
            <div class="meta-n">9 am – 9 pm</div>
            <div class="meta-l">human support, AEST</div>
          </div>
        </div>
        <a class="sydney-link" href="/sydney/">
          AI phone answering for Sydney restaurants →
        </a>
      </div>
      <div class="reveal sydney-photo-col">
        <div class="sydney-photo">
          <ImageBlock
            slug="sydney-harbour-dusk"
            alt="Sydney harbour at dusk, with the harbour bridge in silhouette against a golden sky."
            aspect="4 / 5"
            widths="(min-width: 1024px) 40vw, 100vw"
          />
          <figcaption class="sydney-photo-cap">
            <span class="sydney-photo-tag">Sydney · AEST</span>
            <span class="sydney-photo-line">Where every Biteperk call lands.</span>
          </figcaption>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sydney {
    padding-block: var(--space-section);
    position: relative;
    background: var(--ink-0);
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .sydney-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(50% 60% at 50% 40%, rgba(26, 77, 26, 0.32), transparent 70%);
  }
  .sydney .wrap { position: relative; z-index: 1; }
  .sydney-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 72px;
    align-items: center;
  }
  .sydney h2 {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: -0.025em;
    margin-top: 16px;
    color: var(--white);
  }
  .sydney h2 .gold { color: var(--gold); }
  .sydney-body {
    margin-top: 28px;
    color: var(--text);
    line-height: 1.7;
  }
  .sydney-meta {
    margin-top: 38px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 22px;
  }
  .meta-n {
    font-size: 28px;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .meta-l {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--mist);
    margin-top: 8px;
    font-weight: 500;
  }
  .sydney-link {
    display: inline-block;
    margin-top: 32px;
    color: var(--gold);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2px;
  }
  .sydney-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sydney-photo-col { position: relative; }
  .sydney-photo {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow:
      0 32px 80px -20px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .sydney-photo :global(.image-block) {
    border-radius: 0;
  }
  .sydney-photo-cap {
    position: absolute;
    left: 20px;
    bottom: 20px;
    right: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: rgba(10, 11, 13, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .sydney-photo-tag {
    font-size: 10.5px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
  }
  .sydney-photo-line {
    font-size: 14px;
    color: var(--white);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  @media (max-width: 980px) {
    .sydney-grid { grid-template-columns: 1fr; gap: 56px; }
  }
</style>
