---
/**
 * Home hero — preserved cinematic dark + gold treatment.
 *
 * The Bella portrait is preloaded by Base.astro on the home route.
 * Below the hero copy + stats sits the HeroMarquee — a row of venue
 * thumbnails that anchors the visitor in hospitality context before
 * they scroll into the rest of the page.
 */
import HeroMarquee from "@/components/HeroMarquee.astro";
import ImageBlock from "@/components/ImageBlock.astro";
---

<header class="hero">
  {/* No .grain here: a full-viewport mix-blend layer at first paint costs
      real LCP on throttled mobile; grain stays on below-fold sections. */}
  <div class="hero-stage sm-exit-fade" aria-hidden="true">
    <div class="hero-stage-grid"></div>
    <div class="hero-stage-glow"></div>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <span class="pill">
        <span class="dot"></span>
        Sydney, Australia
      </span>
      <h1 class="hero-title">
        <span class="hero-title-line">We build</span>
        <span class="hero-title-line gold">voice + AI</span>
        <span class="hero-title-line">for hospitality.</span>
      </h1>
      <p class="sub">
        Restaurants and venues lose bookings every day to a phone that nobody can pick up.
        Voco — our AI phone host — answers every call, books the table and takes the order.
        Made in Sydney, answering calls Australia-wide.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/products/">Meet Voco →</a>
        <a class="btn-ghost" href="/contact/">Get in touch</a>
      </div>
    </div>
    <div class="hero-visual">
      <figure class="hero-card">
        <div class="hero-card-halo" aria-hidden="true"></div>
        <ImageBlock
          slug="restaurant-host"
          alt="A restaurant host taking a booking by phone at the stand, warm evening service light behind."
          aspect="4 / 5"
          widths="(min-width: 1024px) 38vw, 100vw"
          priority
        />
        <figcaption class="hero-card-caption">
          <span class="hero-card-caption-dot" aria-hidden="true"></span>
          Live · 24/7
        </figcaption>
      </figure>
    </div>
  </div>
  <HeroMarquee />
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 140px 0 0;
    overflow: hidden;
  }
  .hero-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-stage-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 60% at 80% 40%, color-mix(in srgb, var(--gold-fill) 16%, transparent), transparent 70%),
      radial-gradient(40% 50% at 20% 70%, color-mix(in srgb, var(--green) 32%, transparent), transparent 70%);
  }
  .hero-stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--fill-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--fill-subtle) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
    opacity: 0.4;
  }
  .hero .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .hero-text { max-width: 720px; }
  .hero-title {
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 22px 0 26px;
    color: var(--white);
  }
  .hero-title-line {
    display: block;
    white-space: nowrap;
  }
  .hero-title .gold { color: var(--gold); }

  /* ── Entrance choreography (one-shot, load-time) ──────────────
     LCP rule: the h1 lines animate transform-only from opacity: 1 —
     an element that starts transparent hasn't painted, which pushes
     LCP out. Only the pill, sub, CTAs, halo and caption may fade. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title-line {
      animation: hero-line-rise var(--dur-slow) var(--ease-soft) backwards;
    }
    .hero-title-line:nth-child(2) { animation-delay: 90ms; }
    .hero-title-line:nth-child(3) { animation-delay: 180ms; }
    .hero-text .pill {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 150ms backwards;
    }
    .sub {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 280ms backwards;
    }
    .hero-cta {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 400ms backwards;
    }
    .hero-card-halo {
      animation: hero-halo-bloom 900ms var(--ease-soft) 200ms backwards;
    }
    .hero-card-caption {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 550ms backwards;
    }
    @media (max-width: 980px) {
      /* Portrait sits above the text on mobile — the value prop is
         already below the fold, so it must not wait on long delays. */
      .hero-title-line:nth-child(2) { animation-delay: 60ms; }
      .hero-title-line:nth-child(3) { animation-delay: 120ms; }
      .hero-text .pill { animation-delay: 80ms; }
      .sub { animation-delay: 140ms; }
      .hero-cta { animation-delay: 200ms; }
      .hero-card-caption { animation-delay: 200ms; }
    }
  }
  @keyframes hero-line-rise {
    from { transform: translateY(0.35em); }
    to { transform: translateY(0); }
  }
  @keyframes hero-fade-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-halo-bloom {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .sub {
    font-size: var(--fs-lede);
    line-height: 1.6;
    color: var(--text);
    max-width: 540px;
    font-weight: 400;
  }
  .hero-cta {
    margin-top: 38px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-1);
    box-shadow:
      var(--shadow-card),
      inset 0 1px 0 var(--line);
    transition:
      transform 0.5s var(--ease-soft),
      box-shadow 0.5s ease;
    isolation: isolate;
  }
  .hero-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-card:hover { transform: none; }
  }
  .hero-card-halo {
    position: absolute;
    inset: -22%;
    z-index: -1;
    background:
      radial-gradient(45% 45% at 60% 50%, color-mix(in srgb, var(--gold-fill) 32%, transparent), transparent 65%),
      radial-gradient(50% 50% at 30% 70%, color-mix(in srgb, var(--green) 42%, transparent), transparent 70%);
    filter: blur(34px);
  }
  .hero-card :global(.image-block) {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .hero-card :global(.image-block img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-card-caption {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: rgba(10, 11, 13, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    font-size: 11.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--on-image);
  }
  .hero-card-caption-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-fill);
    box-shadow: 0 0 14px var(--gold-glow);
    animation: bp-pulse 2.4s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-card-caption-dot { animation: none; }
  }

  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; gap: 56px; }
    .hero-visual { order: -1; }
    .hero-card { max-width: 340px; aspect-ratio: 4 / 4.6; }
    /* Mobile paint diet: the masked grid and the 34px-blur halo are
       barely perceptible at this size but cost real main-thread time
       during the LCP window on throttled devices. */
    .hero-stage-grid { display: none; }
    .hero-card-halo { filter: blur(18px); inset: -12%; }
  }
  @media (max-width: 560px) {
    .hero { padding: 120px 0 80px; }
  }
</style>
