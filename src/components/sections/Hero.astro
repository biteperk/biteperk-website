---
/**
 * Home hero — preserved cinematic dark + gold treatment.
 *
 * The Bella portrait is preloaded by Base.astro on the home route.
 * Below the hero copy + stats sits the HeroMarquee — a row of venue
 * thumbnails that anchors the visitor in hospitality context before
 * they scroll into the rest of the page.
 */
import HeroMarquee from "@/components/HeroMarquee.astro";
import ImageBlock from "@/components/ImageBlock.astro";
import { site } from "@/data/site";
import { u } from "@/data/locales";
---

<header class="hero">
  {/* No .grain here: a full-viewport mix-blend layer at first paint costs
      real LCP on throttled mobile; grain stays on below-fold sections. */}
  <div class="hero-stage sm-exit-fade" aria-hidden="true">
    <div class="hero-stage-grid"></div>
    <div class="hero-stage-glow"></div>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <span class="pill">
        <span class="dot"></span>
        Sydney, Australia
      </span>
      <h1 class="hero-title">
        <span class="hero-title-line">Never miss</span>
        <span class="hero-title-line gold">another booking.</span>
      </h1>
      <p class="sub">
        Bella, our AI phone host, answers every call your venue can't — checks real
        availability and writes the booking straight to your dashboard. Made in Sydney,
        answering calls Australia-wide.
      </p>
      <div class="hero-cta">
        <a class="btn" href={u("/contact/?intent=demo")} data-cta="book-demo">Book a demo →</a>
        <a class="btn-ghost" href={u("/technology/")}>See how it works</a>
      </div>
      <p class="hero-phone">
        or call <a href={site.phone.href} data-cta="call-hero">{site.phone.display}</a> — Bella will pick up.
      </p>
      <ul class="hero-proof" aria-label="Why venues choose Vox">
        <li>Answers in under a second</li>
        <li>$80/month flat</li>
        <li>Records stay in Australia</li>
      </ul>
    </div>
    <div class="hero-visual">
      <figure class="hero-card">
        <div class="hero-card-halo" aria-hidden="true"></div>
        <ImageBlock
          slug="table-set-candles"
          alt="A shared restaurant table from above, plates and coffee being passed mid-service."
          aspect="4 / 5"
          widths="(min-width: 1024px) 38vw, 100vw"
          priority
        />
        {/* One-shot "live call" story: three chips land at 0.7s / 1.5s /
            2.6s then rest — the product demonstrated in the first frame.
            Decorative fiction (aria-hidden) with a truthful sr-only line;
            under reduced motion all chips are simply visible. */}
        <div class="hero-call-story" aria-hidden="true">
          <span class="hero-chip hero-chip-ring">
            <span class="hero-chip-dot"></span>
            Incoming call · 7:42pm
          </span>
          <span class="hero-chip hero-chip-answer">Answered &lt;1s</span>
          <span class="hero-chip hero-chip-booked">
            <span class="hero-chip-tick">
              <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                <path d="M2.5 8.5l3.5 3.5 7-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            Booked · Tonight 8:30 · 4 guests
          </span>
        </div>
        <p class="sr-only">
          Bella answers the phone in under a second and books the table — live, 24 hours a day.
        </p>
      </figure>
    </div>
  </div>
  <HeroMarquee />
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-stage-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 60% at 80% 40%, color-mix(in srgb, var(--gold-fill) 16%, transparent), transparent 70%),
      radial-gradient(40% 50% at 20% 70%, color-mix(in srgb, var(--green) 32%, transparent), transparent 70%);
  }
  .hero-stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--fill-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--fill-subtle) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(60% 70% at 30% 50%, #000 0%, transparent 70%);
    opacity: 0.4;
  }
  .hero .wrap {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero-grid {
    /* The grid IS the first viewport: exactly 100svh with the content
       centred, so the marquee (and everything after) only appears on
       scroll — one clean section per screen. */
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
    align-content: center;
    padding-top: 96px; /* clears the fixed nav */
    padding-bottom: 32px;
  }
  .hero-text { max-width: 720px; }
  .hero-title {
    /* Fit cap (measured): "another booking." at the 84px --fs-h1 cap is
       665px vs a 653px column — nowrap + the hero's overflow:hidden
       would clip it silently. 76px renders 602px with margin. */
    font-size: min(var(--fs-h1), 76px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 22px 0 26px;
    color: var(--white);
  }
  .hero-title-line {
    display: block;
    white-space: nowrap;
  }
  .hero-title .gold { color: var(--gold); }

  /* ── Entrance choreography (one-shot, load-time) ──────────────
     LCP rule: the h1 lines animate transform-only from opacity: 1 —
     an element that starts transparent hasn't painted, which pushes
     LCP out. Only the pill, sub, CTAs, halo and caption may fade. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title-line {
      animation: hero-line-rise var(--dur-slow) var(--ease-soft) backwards;
    }
    .hero-title-line:nth-child(2) { animation-delay: 90ms; }
    .hero-text .pill {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 150ms backwards;
    }
    .sub {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 280ms backwards;
    }
    .hero-cta {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 400ms backwards;
    }
    .hero-phone {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 460ms backwards;
    }
    .hero-proof {
      animation: hero-fade-rise var(--dur-slow) var(--ease-soft) 520ms backwards;
    }
    .hero-card-halo {
      animation: hero-halo-bloom 900ms var(--ease-soft) 200ms backwards;
    }
    @media (max-width: 980px) {
      /* Portrait sits above the text on mobile — the value prop is
         already below the fold, so it must not wait on long delays. */
      .hero-title-line:nth-child(2) { animation-delay: 60ms; }
      .hero-text .pill { animation-delay: 80ms; }
      .sub { animation-delay: 140ms; }
      .hero-cta { animation-delay: 200ms; }
      .hero-phone { animation-delay: 240ms; }
      .hero-proof { animation-delay: 280ms; }
    }
  }
  @keyframes hero-line-rise {
    from { transform: translateY(0.35em); }
    to { transform: translateY(0); }
  }
  @keyframes hero-fade-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-halo-bloom {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .sub {
    font-size: var(--fs-lede);
    line-height: 1.6;
    color: var(--text);
    max-width: 540px;
    font-weight: 400;
  }
  .hero-cta {
    margin-top: 38px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-phone {
    margin-top: 14px;
    font-size: 13.5px;
    color: var(--mist);
    letter-spacing: 0.2px;
  }
  .hero-phone a {
    color: var(--gold);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    /* tap target (isolated standalone link) */
    padding-block: 12px;
    margin-block: -12px;
    display: inline-block;
  }
  .hero-phone a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hero-proof {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 0;
    font-size: 13px;
    color: var(--mist);
    letter-spacing: 0.2px;
  }
  .hero-proof li {
    display: inline-flex;
    align-items: center;
  }
  .hero-proof li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold-fill);
    margin: 0 12px;
    flex: none;
  }

  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-1);
    box-shadow:
      var(--shadow-card),
      inset 0 1px 0 var(--line);
    transition:
      transform 0.5s var(--ease-soft),
      box-shadow 0.5s ease;
    isolation: isolate;
  }
  .hero-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-card:hover { transform: none; }
  }
  .hero-card-halo {
    position: absolute;
    inset: -22%;
    z-index: -1;
    background:
      radial-gradient(45% 45% at 60% 50%, color-mix(in srgb, var(--gold-fill) 32%, transparent), transparent 65%),
      radial-gradient(50% 50% at 30% 70%, color-mix(in srgb, var(--green) 42%, transparent), transparent 70%);
    filter: blur(34px);
  }
  .hero-card :global(.image-block) {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .hero-card :global(.image-block img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* ── Live-call chip story ──────────────────────────────────────── */
  .hero-call-story {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .hero-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: rgba(10, 11, 13, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--on-image);
    white-space: nowrap;
  }
  .hero-chip-ring { top: 18px; left: 18px; }
  .hero-chip-answer {
    top: 58px;
    left: 34px;
    border-color: color-mix(in srgb, var(--gold) 35%, var(--line));
    font-weight: 700;
  }
  .hero-chip-booked { left: 18px; bottom: 18px; }
  .hero-chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-fill);
    box-shadow: 0 0 14px var(--gold-glow);
    animation: bp-pulse 2.4s ease-in-out infinite;
    flex: none;
  }
  .hero-chip-tick {
    display: inline-flex;
    color: var(--success);
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-chip {
      animation: hero-chip-in 400ms var(--ease-soft) backwards;
    }
    .hero-chip-ring { animation-delay: 700ms; }
    .hero-chip-answer { animation-delay: 1500ms; }
    .hero-chip-booked { animation-delay: 2600ms; }
    @media (max-width: 980px) {
      .hero-chip-booked { animation-delay: 1600ms; }
    }
  }
  @keyframes hero-chip-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-chip-dot { animation: none; }
  }

  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; gap: 56px; }
    .hero-visual { order: -1; }
    .hero-card { max-width: 340px; aspect-ratio: 4 / 4.6; }
    /* Tablets get a roomier card — 340px on a 768px canvas reads
       phone-stretched (iPad-portrait screenshot-verified). */
    @media (min-width: 561px) {
      .hero-card { max-width: 430px; }
    }
    /* Mobile paint diet: the masked grid and the 34px-blur halo are
       barely perceptible at this size but cost real main-thread time
       during the LCP window on throttled devices. */
    .hero-stage-grid { display: none; }
    .hero-card-halo { filter: blur(18px); inset: -12%; }
    /* Chips on the 340px card: two beats, smaller. The "answered fast"
       claim is carried by the proof line directly below the portrait. */
    .hero-chip { font-size: 10.5px; padding: 6px 10px; letter-spacing: 1.1px; }
    .hero-chip-ring { top: 12px; left: 12px; }
    .hero-chip-answer { display: none; }
    .hero-chip-booked { left: 12px; bottom: 12px; }
  }
  @media (max-width: 560px) {
    .hero-grid { padding-top: 88px; padding-bottom: 56px; }
  }

  /* Short-screen fit insurance: on compact laptop viewports, tighten the
     composition so the full hero (through the proof line) sits inside
     the exact-viewport grid with room to breathe. */
  @media (min-width: 981px) and (max-height: 860px) {
    .hero-grid { padding-top: 84px; }
    .hero-card { max-width: 410px; }
    .hero-title { margin: 18px 0 20px; }
    .hero-cta { margin-top: 30px; }
  }
</style>
