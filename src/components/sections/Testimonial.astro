---
/**
 * Testimonial section. Serif pull-quote sitting over a wide ambient
 * restaurant photo with a heavy scrim so the quote stays AA-readable.
 * Mobile drops the bg photo (line measure crowds at narrow widths).
 */
import PullQuote from "@/components/PullQuote.astro";
import ImageBlock from "@/components/ImageBlock.astro";
import { voxProof } from "@/data/products";

const t = voxProof.testimonials[0];
---

<section class="testimonial cv-auto">
  <div class="testimonial-bg" aria-hidden="true">
    <ImageBlock
      slug="empty-tables-evening"
      alt="Empty restaurant tables set for evening service."
      aspect="21 / 9"
      widths="(min-width: 1280px) 1280px, 100vw"
      rounded={false}
    />
    <div class="testimonial-bg-scrim"></div>
  </div>
  <div class="wrap">
    <div class="reveal">
      <PullQuote quote={t.quote} author={t.author} role={t.role} />
    </div>
  </div>
</section>

<style>
  .testimonial {
    position: relative;
    padding-block: var(--space-section);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--ink-1);
    overflow: hidden;
  }
  .testimonial-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .testimonial-bg :global(.image-block) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    background-position: center;
  }
  .testimonial-bg :global(.image-block img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .testimonial-bg-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--ink-0) 65%, transparent), color-mix(in srgb, var(--ink-0) 92%, transparent) 80%),
      linear-gradient(180deg, color-mix(in srgb, var(--ink-0) 60%, transparent) 0%, color-mix(in srgb, var(--ink-0) 80%, transparent) 100%);
  }
  .testimonial .wrap {
    position: relative;
    z-index: 1;
  }

  /* Mobile: drop the photo for tighter type. */
  @media (max-width: 768px) {
    .testimonial-bg { display: none; }
  }
</style>
