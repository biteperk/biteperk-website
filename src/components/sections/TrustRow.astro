---
/**
 * Trust row — three credibility chips below the hero.
 *
 * We don't yet have hard numbers to put in a counter (calls answered,
 * venues live). Until then, these stay as static chips. When the
 * numbers arrive, swap the cells for <MetricStat>.
 */
---

<section class="trust">
  <div class="wrap">
    <div class="trust-row reveal">
      <div class="trust-cell">
        <span class="dot" aria-hidden="true"></span>
        <div>
          <div class="trust-l">Sydney-based</div>
          <div class="trust-h">Designed, built and supported locally</div>
        </div>
      </div>
      <span class="trust-divider" aria-hidden="true"></span>
      <div class="trust-cell">
        <span class="dot" aria-hidden="true"></span>
        <div>
          <div class="trust-l">Australian data</div>
          <div class="trust-h">Hosted in AU, Privacy Act compliant</div>
        </div>
      </div>
      <span class="trust-divider" aria-hidden="true"></span>
      <div class="trust-cell">
        <span class="dot" aria-hidden="true"></span>
        <div>
          <div class="trust-l">24/7 on the line</div>
          <div class="trust-h">Every call answered, every night</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(255,255,255,0.015) 60%, transparent);
  }
  .trust-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    column-gap: 32px;
    row-gap: 24px;
  }
  .trust-cell {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .trust-cell .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 12px var(--gold);
    flex-shrink: 0;
  }
  .trust-l {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }
  .trust-h {
    margin-top: 4px;
    color: var(--text);
    font-size: 14.5px;
  }
  .trust-divider {
    width: 1px;
    height: 36px;
    background: var(--line);
  }
  @media (max-width: 860px) {
    .trust-row {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }
    .trust-divider { display: none; }
  }
</style>
