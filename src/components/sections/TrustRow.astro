---
/**
 * Trust strip — three credibility cards under the hero marquee.
 *
 * Each card shows a real venue moment (Sydney café morning,
 * candle-lit empty tables before service, a phone on a bar) with the
 * promise on top of the scrim. Photo first, words second — the room
 * does the talking.
 */
import ImageBlock from "@/components/ImageBlock.astro";

const cards = [
  {
    slug: "sydney-cafe-morning",
    eyebrow: "Sydney-based",
    headline: "Designed, built and supported locally",
    alt: "Sydney café interior at morning, warm light through the windows.",
  },
  {
    slug: "empty-tables-evening",
    eyebrow: "Australian data",
    headline: "Hosted in AU, Privacy Act compliant",
    alt: "Empty restaurant tables set for evening service, candles lit.",
  },
  {
    slug: "phone-on-bar",
    eyebrow: "24/7 on the line",
    headline: "Every call answered, every night",
    alt: "Mobile phone resting on a timber bar at service time.",
  },
] as const;
---

<section class="trust">
  <div class="wrap">
    <div class="trust-row reveal reveal-stagger">
      {cards.map((c) => (
        <article class="trust-card">
          <div class="trust-card-photo">
            <ImageBlock slug={c.slug} alt={c.alt} aspect="4 / 5" widths="(min-width:1024px) 28vw, 88vw" />
          </div>
          <div class="trust-card-body">
            <span class="trust-card-eyebrow">
              <span class="dot" aria-hidden="true"></span>
              {c.eyebrow}
            </span>
            <h3 class="trust-card-h">{c.headline}</h3>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(64px, 7vw, 96px);
    border-top: 1px solid var(--line);
    background: var(--ink-0);
  }
  .trust-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .trust-card {
    position: relative;
    -webkit-tap-highlight-color: transparent;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-1);
    isolation: isolate;
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .trust-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--gold) 22%, var(--line));
    box-shadow: var(--shadow-card-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .trust-card:hover { transform: none; }
  }

  .trust-card-photo {
    position: relative;
  }
  .trust-card-photo :global(.image-block) {
    border-radius: 0;
  }
  /* Scrim baked over the photo so the body text remains AA-readable */
  .trust-card-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--overlay-scrim);
    pointer-events: none;
  }

  .trust-card-body {
    position: absolute;
    inset: auto 24px 24px 24px;
    z-index: 1;
  }
  .trust-card-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--gold-fill);
    font-weight: 700;
  }
  .trust-card-eyebrow .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold-fill);
    box-shadow: 0 0 12px var(--gold-glow);
  }
  .trust-card-h {
    margin-top: 8px;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.25;
    font-weight: 700;
    color: var(--on-image);
    letter-spacing: -0.01em;
    max-width: 22ch;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 860px) {
    .trust-row { grid-template-columns: 1fr; }
  }
</style>
