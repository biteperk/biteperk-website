---
/**
 * Homepage strip linking every published city landing page. Feeds the
 * city-engine internal-link mesh (home → cities, cities ↔ cities,
 * footer → cities) that tells crawlers these pages matter.
 *
 * Each card carries its city's real establishing photo (the same
 * cityscape used on the city page's band) under a theme-invariant dark
 * scrim, so the strip reads as places, not just labels.
 */
import ImageBlock from "@/components/ImageBlock.astro";
import { publishedCities, cityUrl } from "@/data/cities";
---

<section class="citystrip section cv-auto" aria-labelledby="citystrip-h">
  <div class="wrap">
    <div class="reveal citystrip-head">
      <span class="eyebrow">Across Australia</span>
      <h2 id="citystrip-h">One phone host. Every city.</h2>
      <p class="lede">
        Voco answers for venues Australia-wide, with local pages for the cities
        our callers ring from most.
      </p>
    </div>
    <ul class="citystrip-list reveal-stagger">
      {publishedCities.map((c) => (
        <li>
          <a class="citystrip-card pressable" href={cityUrl(c)}>
            <div class="citystrip-photo">
              <ImageBlock
                slug={c.cityscapeImage}
                alt={c.cityscapeImageAlt}
                aspect="16 / 10"
                widths="(min-width: 981px) 30vw, (min-width: 561px) 45vw, 90vw"
                rounded={false}
              />
            </div>
            <div class="citystrip-scrim" aria-hidden="true"></div>
            <div class="citystrip-label">
              <span class="citystrip-name">
                {c.name}
                <span class="citystrip-state">{c.state}</span>
              </span>
              <span class="citystrip-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .citystrip {
    border-top: 1px solid var(--line);
  }
  .citystrip-head h2 {
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: var(--lh-display);
    color: var(--white);
    margin-top: 14px;
  }
  .citystrip-head .lede { margin-top: 16px; }

  .citystrip-list {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .citystrip-card {
    position: relative;
    display: block;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-1);
    box-shadow: var(--shadow-card);
    isolation: isolate;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .citystrip-card:hover,
  .citystrip-card:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--gold) 35%, var(--line));
    box-shadow: var(--shadow-card-hover);
  }

  .citystrip-photo :global(.image-block) {
    border-radius: 0;
  }
  .citystrip-photo :global(img) {
    transition: transform var(--dur-slow) var(--ease-soft);
  }
  .citystrip-card:hover .citystrip-photo :global(img) {
    transform: scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .citystrip-card:hover,
    .citystrip-card:focus-visible { transform: none; }
    .citystrip-card:hover .citystrip-photo :global(img) { transform: none; }
  }

  /* Theme-invariant dark scrim — the label is --on-image (near-white)
     in both themes, so the gradient must stay dark in both. */
  .citystrip-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(10, 11, 13, 0.05) 35%,
      rgba(10, 11, 13, 0.62) 78%,
      rgba(10, 11, 13, 0.85) 100%
    );
  }

  .citystrip-label {
    position: absolute;
    left: 18px;
    right: 16px;
    bottom: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .citystrip-name {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--on-image);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
  }
  .citystrip-state {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.6px;
    color: var(--gold-fill);
  }
  .citystrip-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: rgba(10, 11, 13, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    color: var(--gold-fill);
    font-size: 15px;
    transition:
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .citystrip-card:hover .citystrip-arrow {
    transform: translateX(3px);
    border-color: color-mix(in srgb, var(--gold) 45%, var(--line));
  }
  @media (prefers-reduced-motion: reduce) {
    .citystrip-card:hover .citystrip-arrow { transform: none; }
  }

  @media (max-width: 900px) {
    .citystrip-list { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }
  @media (max-width: 560px) {
    .citystrip-list { grid-template-columns: 1fr 1fr; gap: 10px; }
    .citystrip-name { font-size: 15px; gap: 6px; }
    .citystrip-state { font-size: 10.5px; letter-spacing: 1.2px; }
    .citystrip-label { left: 12px; right: 10px; bottom: 10px; }
    .citystrip-arrow { width: 28px; height: 28px; font-size: 13px; }
  }
</style>
