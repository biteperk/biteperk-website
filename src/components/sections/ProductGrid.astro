---
/**
 * Home page product grid — PerkTable spotlighted as the feature, then
 * the upcoming products in a 3-up row.
 *
 * A 3-image context strip sits above the section header so the
 * catalogue lands on a photographic floor instead of plain ink.
 */
import SectionHeader from "@/components/SectionHeader.astro";
import ProductCard from "@/components/ProductCard.astro";
import ImageBlock from "@/components/ImageBlock.astro";
import { products, getProduct } from "@/data/products";

const perktable = getProduct("perktable");
const upcoming = products.filter((p) => p.slug !== "perktable");

const stripPhotos = [
  { slug: "restaurant-evening", alt: "A dim restaurant interior with candlelit tables." },
  { slug: "busy-service-night", alt: "A busy restaurant dining room during a night-time service." },
  { slug: "bar-cocktail-action", alt: "A bartender mixing cocktails behind a busy bar." },
] as const;
---

<section class="grid-section cv-auto" id="products">
  <div class="grid-strip" aria-hidden="true">
    {stripPhotos.map((p) => (
      <div class="grid-strip-cell">
        <ImageBlock slug={p.slug} alt={p.alt} aspect="16 / 9" widths="34vw" rounded={false} />
      </div>
    ))}
    <div class="grid-strip-scrim"></div>
  </div>
  <div class="wrap">
    <SectionHeader
      eyebrow="The catalogue"
      lede="Four products. One mission — keep restaurant teams on the floor while the phone, the bookings, and the no-shows quietly handle themselves."
    >
      <Fragment slot="headline">
        Two products live today.
        <br />
        <span class="gold">More on the way.</span>
      </Fragment>
    </SectionHeader>

    <div class="feature-wrap reveal">
      {perktable && <ProductCard product={perktable} variant="feature" />}
    </div>

    <div class="grid-tiles reveal reveal-stagger">
      {upcoming.map((p) => <ProductCard product={p} variant="tile" />)}
    </div>

    <div class="grid-foot reveal">
      <a class="lnk-arrow" href="/products/">
        See the full product catalogue
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .grid-section {
    padding-block: var(--space-section);
    background: linear-gradient(180deg, var(--ink-0) 0%, var(--ink-1) 100%);
    border-top: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .grid-strip {
    position: relative;
    height: clamp(160px, 18vw, 240px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-bottom: clamp(48px, 6vw, 80px);
    overflow: hidden;
  }
  .grid-strip-cell {
    position: relative;
    overflow: hidden;
    height: 100%;
  }
  .grid-strip-cell :global(.image-block) {
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0;
  }
  .grid-strip-cell :global(.image-block img) {
    height: 100%;
    object-fit: cover;
  }
  .grid-strip-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ink-0) 40%, transparent) 0%, color-mix(in srgb, var(--ink-0) 20%, transparent) 30%, var(--ink-0) 95%),
      linear-gradient(90deg, color-mix(in srgb, var(--ink-0) 50%, transparent) 0%, transparent 50%, color-mix(in srgb, var(--ink-0) 50%, transparent) 100%);
    pointer-events: none;
  }
  @media (max-width: 760px) {
    .grid-strip { grid-template-columns: repeat(3, 1fr); height: 140px; }
  }
  .feature-wrap {
    margin-top: 64px;
  }
  .grid-tiles {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 980px) {
    .grid-tiles { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .grid-tiles { grid-template-columns: 1fr; }
  }
  .grid-foot {
    margin-top: 56px;
    text-align: center;
  }
  .lnk-arrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--gold);
    font-weight: 600;
    font-size: 15px;
    padding: 8px 4px;
    transition: gap var(--dur-base) var(--ease-out);
  }
  .lnk-arrow:hover { gap: 14px; }
</style>
