---
/**
 * Brand illustration system. Six bespoke SVGs that share stroke weight,
 * corner radius, and accent rules so they read as one family.
 *
 * Set `name` to one of the registered keys. `size` controls box width
 * (height auto from viewBox aspect). `accent` overrides the gold focal
 * colour. `trace` enables a one-shot stroke-dash reveal when the icon
 * enters the viewport (gated by `prefers-reduced-motion`).
 *
 * The SVGs are inlined so there's no extra HTTP request. Inline SVG
 * also means `currentColor` works for the stroke, letting parents
 * tint the muted lines via plain CSS.
 */

interface Props {
  name:
    | "phone-wave"
    | "calendar-tick"
    | "pin-au"
    | "shield"
    | "ticket"
    | "clock-247";
  size?: number;
  accent?: string;
  trace?: boolean;
  ariaLabel?: string;
}

const {
  name,
  size = 56,
  accent = "var(--gold)",
  trace = true,
  ariaLabel,
} = Astro.props;

// All SVGs use a 56×56 viewBox, stroke-width 1.5, round caps + joins,
// `currentColor` for the muted lines, `var(--accent)` for the focal hit.
const stroke = "1.5";
const mist = "var(--mist, #9aa1ad)";
---

<span
  class:list={["illu", { traceable: trace }]}
  style={`--ilu-size:${size}px; --ilu-accent:${accent};`}
  role={ariaLabel ? "img" : undefined}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : "true"}
>
  {name === "phone-wave" && (
    <svg viewBox="0 0 56 56" fill="none" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round">
      <rect x="16" y="6" width="24" height="44" rx="5" stroke={mist} />
      <line x1="22" y1="11" x2="34" y2="11" stroke={mist} />
      <circle cx="28" cy="44" r="1.2" fill={mist} stroke="none" />
      <path d="M44 22 Q49 28 44 34" class="accent" />
      <path d="M48 18 Q56 28 48 38" class="accent" stroke-dasharray="0.1,4" />
    </svg>
  )}

  {name === "calendar-tick" && (
    <svg viewBox="0 0 56 56" fill="none" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="12" width="40" height="36" rx="4" stroke={mist} />
      <line x1="8" y1="22" x2="48" y2="22" stroke={mist} />
      <line x1="18" y1="8" x2="18" y2="16" stroke={mist} />
      <line x1="38" y1="8" x2="38" y2="16" stroke={mist} />
      <path d="M20 34 L26 40 L38 28" class="accent" />
    </svg>
  )}

  {name === "pin-au" && (
    <svg viewBox="0 0 56 56" fill="none" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round">
      <path d="M28 50 C40 38 44 30 44 22 A16 16 0 0 0 12 22 C12 30 16 38 28 50 Z" stroke={mist} />
      <circle cx="28" cy="22" r="6" class="accent" />
      <path d="M25 22 L27 24 L31 19" class="accent" />
    </svg>
  )}

  {name === "shield" && (
    <svg viewBox="0 0 56 56" fill="none" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round">
      <path d="M28 6 L46 14 V28 C46 38 38 46 28 50 C18 46 10 38 10 28 V14 Z" stroke={mist} />
      <circle cx="28" cy="26" r="3" class="accent" />
      <line x1="28" y1="29" x2="28" y2="36" class="accent" />
    </svg>
  )}

  {name === "ticket" && (
    <svg viewBox="0 0 56 56" fill="none" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round">
      <rect x="12" y="6" width="32" height="14" rx="2" stroke={mist} />
      <line x1="16" y1="12" x2="40" y2="12" stroke={mist} />
      <path d="M14 20 L14 48 L18 44 L22 48 L26 44 L30 48 L34 44 L38 48 L42 44 L42 20" class="accent" />
      <line x1="20" y1="28" x2="36" y2="28" stroke={mist} />
      <line x1="20" y1="34" x2="32" y2="34" stroke={mist} />
    </svg>
  )}

  {name === "clock-247" && (
    <svg viewBox="0 0 56 56" fill="none" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round">
      <circle cx="28" cy="28" r="20" stroke={mist} />
      <text x="28" y="33" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="12" fill="currentColor" stroke="none" style="fill:var(--ilu-accent)">24/7</text>
      <line x1="28" y1="8" x2="28" y2="11" stroke={mist} />
      <line x1="28" y1="45" x2="28" y2="48" stroke={mist} />
      <line x1="8" y1="28" x2="11" y2="28" stroke={mist} />
      <line x1="45" y1="28" x2="48" y2="28" stroke={mist} />
    </svg>
  )}
</span>

<style>
  .illu {
    display: inline-flex;
    width: var(--ilu-size);
    height: var(--ilu-size);
    color: var(--mist);
  }
  .illu svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .illu :global(.accent) {
    stroke: var(--ilu-accent);
  }

  /* Stroke-dash trace, fired once on viewport entry. */
  .illu.traceable :global(path),
  .illu.traceable :global(line),
  .illu.traceable :global(rect),
  .illu.traceable :global(circle) {
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    transition: stroke-dashoffset 0.9s var(--ease-out, ease-out);
  }
  .illu.traceable.is-in :global(path),
  .illu.traceable.is-in :global(line),
  .illu.traceable.is-in :global(rect),
  .illu.traceable.is-in :global(circle) {
    stroke-dashoffset: 0;
  }
  .illu :global(text) {
    stroke-dasharray: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .illu.traceable :global(path),
    .illu.traceable :global(line),
    .illu.traceable :global(rect),
    .illu.traceable :global(circle) {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script>
  // Add .is-in once the illustration crosses the viewport.
  (() => {
    function init() {
      const els = document.querySelectorAll<HTMLElement>(".illu.traceable");
      if (els.length === 0 || !("IntersectionObserver" in window)) {
        els.forEach((e) => e.classList.add("is-in"));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.35 }
      );
      els.forEach((el) => {
        if (!el.classList.contains("is-in")) io.observe(el);
      });
    }
    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
