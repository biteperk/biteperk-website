---
/**
 * Locale suggestion chip — "there's a site for your region".
 *
 * Shown when the visitor's browser languages point at a market OTHER than the
 * page they landed on (typically a UK/FR/BE visitor arriving on /en, the
 * x-default). Deliberate constraints:
 *
 *   - NEVER auto-redirects. Auto-redirecting by language is the single most
 *     hated pattern in international web: it traps people who deliberately
 *     chose a locale, and it hides content from crawlers. This only offers.
 *   - navigator.languages ONLY — no IP geolocation, no third-party service,
 *     no request for the Geolocation permission. Nothing leaves the browser.
 *   - Dismissible, and the dismissal sticks (localStorage).
 *   - Rendered `hidden` and position:fixed, so it can never move layout or
 *     cost CLS; the script only ever unhides it.
 *   - Copy is in the TARGET locale's language — we're speaking to someone who
 *     reads that language, so the offer should too.
 *
 * Visitors who arrive via a ccTLD front door (biteperk.uk → /gb-en/) are
 * already on their market, so the suggestion self-suppresses: the matched
 * locale equals the current one.
 *
 * Matching derives from each locale's `hreflang` codes in locales.ts, so a
 * new market is offered the day it ships, with no mapping table to maintain.
 */
import { localesForTarget, localeFromPath, ORIGIN } from "@/data/locales";
import { resolveCopy } from "@/data/intl";

const current = localeFromPath(Astro.url.pathname);

// Candidates + the copy for each, resolved at build time so the client script
// needs no copy bundle. `home` is absolute-path (not URL) to keep it same-origin.
const candidates = localesForTarget("global").map((l) => {
  const chrome = resolveCopy(l).chrome;
  return {
    base: l.base,
    home: `${l.base}/`,
    label: l.label,
    lang: l.lang,
    hreflang: l.hreflang,
    suggest: chrome.suggest,
    dismiss: chrome.suggestDismiss,
  };
});
---

<div class="ls" id="locale-suggest" data-locale-suggest data-current={current.base} hidden>
  <p class="ls-text" data-ls-text></p>
  <a class="ls-go" data-ls-go href={`${ORIGIN}/`}>
    <span class="ls-chip" data-ls-chip aria-hidden="true"></span>
    <span data-ls-label></span>
    <span aria-hidden="true">→</span>
  </a>
  <button type="button" class="ls-dismiss" data-ls-dismiss>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</div>

<script type="application/json" data-locale-suggest-data set:html={JSON.stringify(candidates)} />

<style>
  .ls {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: var(--z-overlay);
    /* Grid, not wrap: with flex-wrap the dismiss dropped onto a third row on
       narrow phones and the chip grew taller than the CTA it sits over. */
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "text dismiss"
      "go   go";
    align-items: center;
    gap: var(--space-3);
    max-width: 34rem;
    margin-inline: auto;
    padding: 12px 12px 12px 16px;
    background: color-mix(in srgb, var(--ink-1) 97%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: 0 18px 44px -12px rgba(0, 0, 0, 0.5);
  }
  .ls[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .ls { animation: ls-in 220ms var(--ease-soft) backwards; }
  }
  @keyframes ls-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ls-text {
    grid-area: text;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text);
  }
  .ls-go {
    grid-area: go;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-inline: 14px;
    border: 1px solid color-mix(in srgb, var(--gold) 34%, transparent);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--gold) 12%, transparent);
    color: var(--white);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .ls-go:hover { background: color-mix(in srgb, var(--gold) 20%, transparent); }
  .ls-chip {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--gold);
  }
  .ls-dismiss {
    grid-area: dismiss;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--mist-2);
    cursor: pointer;
  }
  .ls-dismiss:hover { color: var(--white); background: var(--fill-hover); }
</style>
