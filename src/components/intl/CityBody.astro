---
/**
 * The market city page body — every section between IntlLayout's chrome for
 * a published entry in src/data/intl/cities.ts. The JSON-LD (Service,
 * BreadcrumbList, FAQPage) stays in [...intl].astro: it is head-slot data
 * with no CSS, and the meta/OG derivation there needs the city anyway.
 *
 * This lives outside [...intl].astro so its CSS ships only on city pages —
 * and that exclusion hangs entirely on the `is:inline` style at the bottom.
 * Astro collects processed component CSS by import graph (dynamic imports
 * included — measured, not assumed), not by what renders, so with
 * inlineStylesheets "always" a normal scoped <style> here would be inlined
 * on every page [...intl].astro emits, city or not. `is:inline` opts out of
 * that pipeline: the tag renders in place, only on pages that render this
 * component. Removing it silently leaks the CSS back onto all ~100 pages.
 *
 * All text fields are hand-written per city; the section furniture comes
 * from the language core (c.cityPage, "{city}" → this city's name). No
 * geo/address/hours anywhere — the service is NAMED for the city, never
 * located in it (PLAN.md §8, enforced by check-truthful + check-schema).
 */
import { resolveCopy, resolveHero } from "@/data/intl";
import { intlCitiesForBase, type IntlCity } from "@/data/intl/cities";
import type { Locale } from "@/data/locales";
import ImageBlock from "@/components/ImageBlock.astro";
import FAQ from "@/components/FAQ.astro";
import PullQuote from "@/components/PullQuote.astro";
import Illustration from "@/components/Illustration.astro";
import CityLinks from "@/components/intl/CityLinks.astro";

interface Props {
  locale: Locale;
  city: IntlCity;
}
const { locale, city } = Astro.props;

// Links must come from the BASE ("/gb-en/…"), never the lang ("en-GB" → 404).
const p = (seg: string) => `${locale.base}/${seg ? `${seg}/` : ""}`;

const c = resolveCopy(locale);
const hero = resolveHero(locale);
const h = c.home;

// "{city}" in the shared labels → this city's name.
const cl = (s: string) => s.replaceAll("{city}", city.name);
// Illustration.astro has no "pin"; "pin-au" is its geography-neutral pin+check
// (the -au suffix is historical, the drawing carries no Australia motif).
const cityIcon = (i: "pin" | "calendar-tick" | "phone-wave" | "shield") =>
  i === "pin" ? ("pin-au" as const) : i;
const otherCities = intlCitiesForBase(locale.base).filter((x) => x.slug !== city.slug);
---

{/* ── City hero — TEXT-ONLY on purpose: the LCP element on the intl
    trees is text, and the market pill does the honest geographic work
    (names the market and the pilot programme, never a premises). ── */}
<section class="intl-hero">
  <div class="wrap">
    <nav class="intl-crumbs" aria-label="Breadcrumb">
      <a href={p("")}>{c.chrome.nav.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{city.name}</span>
    </nav>
    {hero?.pill && <span class="pill intl-pill">{hero.pill}</span>}
    <h1>{city.heroHeadline}</h1>
    <p class="lede">{city.intro[0]}</p>
    <div class="intl-ctas">
      <a class="btn" href={p("contact")}>{c.chrome.cta}</a>
      <a class="btn-ghost" href={p("how-it-works")}>{h.ctaSecondary}</a>
    </div>
  </div>
</section>

{/* ── The local story: the rest of the hand-written intro, beside the
    market's shared hospitality shot. Lazy, never priority. ── */}
<section class="intl-band">
  <div class="wrap">
    <div class="intl-city-split">
      <div>
        <p class="eyebrow">{cl(c.cityPage.storyEyebrow)}</p>
        <h2>{cl(c.cityPage.storyHeading)}</h2>
        {city.intro.slice(1).map((para) => <p class="intl-city-body">{para}</p>)}
      </div>
      <div class="intl-city-split-photo">
        <ImageBlock
          slug={city.storyImage}
          alt={city.storyImageAlt}
          aspect="4 / 3"
          widths="(min-width: 981px) 46vw, 100vw"
          rounded
        />
      </div>
    </div>
  </div>
</section>

{/* ── Scenarios — per-city, hand-written. ── */}
<section>
  <div class="wrap">
    <p class="eyebrow">{cl(c.cityPage.scenariosEyebrow)}</p>
    <h2>{cl(c.cityPage.scenariosHeading)}</h2>
    <div class="intl-grid">
      {city.scenarios.map((s) => (
        <div class="intl-card">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ── The AI, tuned for this city. ── */}
<section class="intl-band">
  <div class="wrap">
    <p class="eyebrow">{cl(c.cityPage.aiEyebrow)}</p>
    <h2>{cl(c.cityPage.aiHeading)}</h2>
    <p class="lede">{city.aiLocal.lead}</p>
    <div class="intl-grid">
      {city.aiLocal.points.map((pt) => (
        <div class="intl-card">
          <Illustration name={cityIcon(pt.icon)} size={40} trace />
          <h3>{pt.title}</h3>
          <p>{pt.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ── Cityscape + districts. No on-image overlay tag: the AU band's
    "Answering for venues across {city}, 24/7" would claim live UK
    service, and the scrim/axe interaction is a known trap besides. ── */}
<section>
  <div class="wrap">
    <div class="intl-city-scape">
      <ImageBlock
        slug={city.cityscapeImage}
        alt={city.cityscapeImageAlt}
        aspect="16 / 9"
        widths="(min-width: 981px) 1120px, 100vw"
        rounded
      />
    </div>
    <p class="eyebrow">{cl(c.cityPage.districtsEyebrow)}</p>
    <h2>{cl(c.cityPage.districtsHeading)}</h2>
    <ul class="intl-city-chips">
      {city.districts.map((d) => <li>{d}</li>)}
    </ul>
    <p class="muted intl-city-note">{c.cityPage.districtsNote}</p>
  </div>
</section>

{/* ── Proof, honestly Australian: the role line says Sydney. Evidence
    that Vox is real, never a claim it is live here. ── */}
<section class="intl-quote">
  <div class="wrap">
    <PullQuote
      quote={h.testimonial.quote}
      author={h.testimonial.author}
      role={h.testimonial.role}
    />
  </div>
</section>

{/* ── Per-city FAQ (also the FAQPage JSON-LD, emitted by the page). Default
    surface, never .intl-band — the accordion items are var(--ink-1). ── */}
<section class="intl-faq">
  <div class="wrap">
    <p class="eyebrow intl-faq-eyebrow">{cl(c.cityPage.faqEyebrow)}</p>
    <h2>{cl(c.cityPage.faqHeading)}</h2>
    <FAQ items={[...city.faqs]} stagger />
  </div>
</section>

{/* ── Cross-links to the market's other city pages. ── */}
{otherCities.length > 0 && (
  <section class="intl-band">
    <div class="wrap">
      <p class="eyebrow">{cl(c.cityPage.othersEyebrow)}</p>
      <h2>{cl(c.cityPage.othersHeading)}</h2>
      <CityLinks items={otherCities.map((x) => ({ href: p(x.slug), name: x.name }))} />
    </div>
  </section>
)}

<section class="intl-closing">
  <div class="wrap">
    <h2>{cl(c.cityPage.closingHeading)}</h2>
    <p>{c.cityPage.closingBody}</p>
    <div class="intl-ctas" style="justify-content: center;">
      <a class="btn" href={p("contact")}>{c.chrome.cta}</a>
    </div>
  </div>
</section>

<style is:inline>
  /* These rules are UNSCOPED (is:inline skips the scoping pass) — keep the
     intl-city-* namespace on any selector added here. */
  /* Mirrors .intl-crumbs in [...intl].astro's scoped block (the product
     pages' breadcrumb). Scoped styles don't cross files, so the rule is
     restated here — only city pages pay for the duplicate. */
  .intl-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    font-size: var(--fs-small);
    margin-bottom: 1rem;
    color: var(--mist);
  }
  .intl-crumbs a { color: var(--mist); text-decoration: none; }
  @media (hover: hover) {
    .intl-crumbs a:hover { color: var(--gold); }
  }
  .intl-crumbs a:focus-visible { outline: none; box-shadow: var(--ring-focus); border-radius: 4px; }

  .intl-city-split {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
  }
  @media (max-width: 860px) {
    .intl-city-split { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  .intl-city-body { color: var(--mist-2); max-width: 60ch; }
  .intl-city-body + .intl-city-body { margin-top: var(--space-4); }

  .intl-city-scape { margin-block-end: var(--space-7); }

  /* District chips: same pill language as the AU .city-chips, rebuilt on the
     shared tokens (no new pairs — text is --mist-2 on --ink-1, both in the
     contrast manifest). The cross-link pills live in CityLinks.astro. */
  .intl-city-chips {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .intl-city-chips li {
    padding: 9px 16px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: var(--ink-1);
    color: var(--mist-2);
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .intl-city-note { margin-top: var(--space-5); font-size: var(--fs-small); max-width: 60ch; }

  /* The city FAQ centres its h2 (shared .intl-faq rule); centre the eyebrow
     with it so the pair reads as one heading block. */
  .intl-faq-eyebrow { text-align: center; }
</style>
