---
/**
 * Marketing composite — photo + UI-overlay card, rendered at build time
 * by scripts/generate-images.mjs.
 *
 * Routes between desktop and mobile variants via <picture media="…">.
 * Each variant ships as PNG + AVIF + WebP so the live site stays light.
 *
 * Props:
 *   - name      Composite name: home-in-the-wild / voxtable-hero / footer-mood-band
 *   - alt       Required alt text
 *   - priority  Eager + fetchpriority=high (for LCP candidate)
 */
import { u } from "@/data/locales";

interface Props {
  name: "home-in-the-wild" | "voxtable-hero" | "footer-mood-band";
  alt: string;
  priority?: boolean;
  class?: string;
}

const { name, alt, priority = false, class: extraClass } = Astro.props;

// Bump this when re-generating composites so browsers fetch fresh AVIFs
// past the 1y immutable cache. Cheaper than renaming files; only this
// one file changes.
const v = "v2";
const desktop = u(`/images/composites/${name}-desktop`);
const mobile = u(`/images/composites/${name}-mobile`);
const qs = `?${v}`;
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : "auto";
// Always async: sync decode blocks the main thread right at LCP paint.
const decoding = "async";

// Intrinsic pixel dims per variant (from generate-images.mjs output).
// width/height on each <source>/<img> reserve layout space before the
// image loads — without them the composite shifts the page (CLS ~0.078
// measured on /products/voxtable/). Keep in sync when regenerating.
const DIMS: Record<Props["name"], { d: [number, number]; m: [number, number] }> = {
  "voxtable-hero": { d: [1800, 1200], m: [800, 1200] },
  "home-in-the-wild": { d: [1600, 1000], m: [800, 1000] },
  "footer-mood-band": { d: [1920, 360], m: [800, 360] },
};
const dims = DIMS[name];
---

<!--
  Only AVIF/WebP are referenced — never the .png. The PNGs are build
  intermediates and are gitignored (see .gitignore), so a CI checkout has no
  copy of them: referencing one made the built HTML depend on a file that
  exists on a dev machine but not in CI, so what CI validated was not what got
  deployed. WebP is the universal fallback here. Don't add a .png source back.
-->
<figure class:list={["composite", `is-${name}`, extraClass]}>
  <picture>
    <source media="(min-width: 768px)" type="image/avif" srcset={`${desktop}.avif${qs}`} width={dims.d[0]} height={dims.d[1]} />
    <source media="(min-width: 768px)" type="image/webp" srcset={`${desktop}.webp${qs}`} width={dims.d[0]} height={dims.d[1]} />
    <source type="image/avif" srcset={`${mobile}.avif${qs}`} width={dims.m[0]} height={dims.m[1]} />
    <img
      src={`${mobile}.webp${qs}`}
      alt={alt}
      width={dims.m[0]}
      height={dims.m[1]}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  </picture>
</figure>

<style>
  .composite {
    margin: 0;
    width: 100%;
    display: block;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--ink-1);
    box-shadow: var(--shadow-card);
    isolation: isolate;
  }
  .composite picture,
  .composite img {
    display: block;
    width: 100%;
    height: auto;
  }
  .composite img {
    object-fit: cover;
  }
  .composite.is-footer-mood-band {
    border-radius: 0;
    box-shadow: none;
  }
</style>
