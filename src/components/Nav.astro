---
import { bookDemoHref } from "@/data/conversion";
/**
 * Sticky top nav — modern three-section layout.
 *
 *   ┌────────────────────────────────────────────────────────────────┐
 *   │ [★ biteperk]   Products▾  Pricing  Contact   📞 +61 2…  [CTA]  │
 *   └────────────────────────────────────────────────────────────────┘
 *
 * Left: logo + wordmark.
 * Centre: Products mega-menu, then headerNav centre links (Solutions is one).
 * Right: a discreet phone link + a small filled "Book a demo" CTA.
 *
 * Glassy translucent backdrop, gold hairline on scroll. Active link
 * marked with an animated underline pill.
 *
 * Mobile/tablet (<= 1180px): the whole desktop bar is hidden and the shared
 * overlay. The threshold is set by what actually fits: the bar carries the
 * Products mega-menu + five centre links + region picker + theme + phone + Sign in + CTA,
 * and below ~1180px they cannot coexist without the centre cluster
 * overflowing its track and painting over the wordmark. Everything in the bar
 * number + Sign in ride along in the drawer's foot slot.
 */
import StarMark from "@/components/StarMark.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LocalePicker from "@/components/LocalePicker.astro";
import NavDropdown from "@/components/NavDropdown.astro";
import { site } from "@/data/site";
import { headerNav, isNavActive } from "@/data/nav";
import { u, localeFromPath } from "@/data/locales";
import MobileBar from "@/components/chrome/MobileBar.astro";
import MobileDrawer from "@/components/chrome/MobileDrawer.astro";
import { products, statusLabel, productUrl, getProduct } from "@/data/products";
import { liveSolutions, solutionPath } from "@/data/solutions";
import { publishedCities, cityUrl } from "@/data/cities";
import type { DrawerSection, DrawerStatus } from "@/data/chrome";

const pathname = Astro.url.pathname;

// Centre cluster = headerNav minus Products (which is the <NavDropdown />
// mega-menu). Single source shared with the drawer — see data/nav.ts.
const centreLinks = headerNav.filter((l) => l.desktop !== false);
const currentRegion = localeFromPath(pathname);

// Compact drawer sections (shared MobileDrawer). Same catalogue the old
// the old MobileMenu rendered: Products + Solutions with status pills, Company
// pages, and the Locations chips.
const drawerCurrent = (href: string) => isNavActive(pathname, { label: "", href });
const drawerSections: DrawerSection[] = [
  {
    id: "products",
    title: "Products",
    lede: "Vox is one AI phone host. Bookings and takeaway are live; concierge, hotel stays and drive-thru roll out as add-ons.",
    links: products.map((p) => ({
      label: p.name,
      href: productUrl(p),
      current: drawerCurrent(productUrl(p)),
      pill: { text: statusLabel(p.status), status: p.status as DrawerStatus },
    })),
    more: {
      label: "See the Vox overview →",
      href: u("/products/"),
      current: isNavActive(pathname, { label: "", href: "/products/", activeMatch: "exact" }),
    },
  },
  {
    id: "solutions",
    title: "Solutions",
    lede: "Industry pages for commercial intent — restaurants, hotels, takeaway, and more.",
    links: liveSolutions().map((sol) => ({
      label: sol.name,
      href: u(solutionPath(sol.slug)),
      current: drawerCurrent(u(solutionPath(sol.slug))),
      pill: { text: statusLabel(getProduct(sol.primaryProduct)!.status), status: getProduct(sol.primaryProduct)!.status as DrawerStatus },
    })),
    more: {
      label: "All solutions →",
      href: u("/solutions/"),
      current: isNavActive(pathname, { label: "", href: "/solutions/", activeMatch: "exact" }),
    },
  },
  {
    id: "pages",
    title: "Company",
    links: headerNav.filter((l) => l.mobile !== false).map((link) => ({
      label: link.label,
      href: link.href,
      current: isNavActive(pathname, link),
    })),
  },
  {
    id: "cities",
    title: "Locations",
    layout: "chips",
    links: publishedCities.map((c) => ({
      label: c.name,
      href: cityUrl(c),
      current: drawerCurrent(cityUrl(c)),
    })),
  },
];
---

<nav class="nav" id="nav" aria-label="Primary" transition:persist>
  <div class="wrap nav-inner">
    <a class="brand nav-brand" href={u("/")} aria-label="Biteperk home">
      <StarMark size={34} />
      <span class="brand-name">bite<span class="perk">perk</span></span>
    </a>

    <div class="nav-centre">
      <NavDropdown />
      {centreLinks.map((link) => (
        <a
          class:list={["lnk", { active: isNavActive(pathname, link) }]}
          href={link.href}
          aria-current={isNavActive(pathname, link) ? "page" : undefined}
          data-nav-link={link.href.includes("#") ? undefined : link.href}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="nav-right">
      <LocalePicker />
      <ThemeToggle />
      <a
        class="nav-phone"
        href={site.phone.href}
        aria-label={`Call Biteperk on ${site.phone.display}`}
        title={site.phone.display}
        data-cta="call-nav"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3.4 2.5C3 2.9 2.9 3.6 3.2 4.2c1.4 3 3.6 5.2 6.6 6.6.6.3 1.3.2 1.7-.2l.9-.9c.3-.3.3-.8 0-1.1l-1.5-1.5c-.3-.3-.8-.3-1.1 0l-.6.6c-1.5-.7-2.7-1.9-3.4-3.4l.6-.6c.3-.3.3-.8 0-1.1L4.9 1.1c-.3-.3-.8-.3-1.1 0z" fill="currentColor"/>
        </svg>
        <span class="nav-phone-text">{site.phone.display}</span>
      </a>
      <a
        class="nav-signin"
        href={site.voxtableUrl}
        target="_blank"
        rel="noopener"
        data-cta="sign-in"
      >
        Sign in
        <span class="nav-ext" aria-hidden="true">↗</span>
        <span class="sr-only">(opens the VoxTable app in a new tab)</span>
      </a>
      <a class="btn nav-cta" href={bookDemoHref()} data-cta="book-demo">
        Book a demo
        <span class="nav-cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</nav>

{/* Shared compact chrome — identical bar + drawer to the international trees,
    ≤1180. Siblings of the persisted <nav>, so they re-mount per page (fresh
    region hrefs) and are never trapped by a transformed ancestor. */}
<MobileBar
  homeHref={u("/")}
  brandLabel="Biteperk home"
  cta={{ label: "Book a demo", href: bookDemoHref(), dataCta: "book-demo" }}
  menuLabel="Open menu"
  picker={{ title: "Choose your region", currentLabel: "Region and language — currently {label}", closeLabel: "Close region picker" }}
/>
<MobileDrawer
  homeHref={u("/")}
  brandLabel="Biteperk home"
  closeLabel="Close menu"
  navLabel="Site navigation"
  sections={drawerSections}
  languageRegion={{ label: "Language & region", current: currentRegion.label }}
  cta={{ label: "Book a demo", href: bookDemoHref(), dataCta: "book-demo" }}
  theme={{ label: "Switch theme", toLight: "Switch to light theme", toDark: "Switch to dark theme" }}
>
  <Fragment slot="foot">
    <a class="btn-ghost mdrawer-foot-call" href={site.phone.href} data-cta="call-menu">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
        <path d="M3.4 2.5C3 2.9 2.9 3.6 3.2 4.2c1.4 3 3.6 5.2 6.6 6.6.6.3 1.3.2 1.7-.2l.9-.9c.3-.3.3-.8 0-1.1l-1.5-1.5c-.3-.3-.8-.3-1.1 0l-.6.6c-1.5-.7-2.7-1.9-3.4-3.4l.6-.6c.3-.3.3-.8 0-1.1L4.9 1.1c-.3-.3-.8-.3-1.1 0z" fill="currentColor"/>
      </svg>
      Call {site.phone.display}
    </a>
    <a class="mdrawer-foot-email" href={site.email.href}>Email {site.email.display}</a>
    <a class="mdrawer-foot-email" href={site.voxtableUrl} target="_blank" rel="noopener" data-cta="sign-in">
      Sign in to VoxTable ↗
    </a>
  </Fragment>
</MobileDrawer>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    background: color-mix(in srgb, var(--ink-0) 55%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
    padding-top: env(safe-area-inset-top);
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--ink-0) 88%, transparent);
    border-bottom: 1px solid var(--line-gold);
    box-shadow: 0 8px 32px -16px rgba(0, 0, 0, 0.35);
  }
  /* One-shot entrance on full page load. Fixed position → no CLS; the
     nav is transition:persist'ed so this never replays on soft navs. */
  @media (prefers-reduced-motion: no-preference) {
    .nav {
      animation: nav-in 280ms var(--ease-soft) backwards;
    }
  }
  @keyframes nav-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    height: var(--nav-h);
    gap: 20px;
    min-width: 0;
    /* The bar carries more than the article column (Products mega-menu + five
       centre links + theme toggle + region picker + the always-on phone number
       + Sign in + Book a demo), so it needs more room than --container-max
       (1180). Widen it here or the centre cluster overflows its 1fr track and
       — being centred — spills left over the wordmark.
       NB: .wrap's own horizontal padding comes out of this, so the usable
       content box is ~64px narrower than the number below. */
    max-width: 1360px;
  }
  /* Bar compresses slightly once scrolled — fixed position, so no CLS. */
  .nav.scrolled .nav-inner {
    height: var(--nav-h-scrolled);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-inner {
      transition: height var(--dur-base) var(--ease-out);
    }
  }

  /* Left — brand */
  .nav-brand {
    display: inline-flex;
    align-items: center;
    /* Extend the tap target into the bar's height without moving layout
       (the nav-inner grid centres it either way). */
    padding-block: 8px;
    margin-block: -8px;
    gap: 10px;
  }
  .nav-brand .brand-name {
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  /* Centre — links */
  .nav-centre {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex-wrap: nowrap;
    min-width: 0;
  }
  .lnk {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--mist-2);
    padding: 11px 13px;
    border-radius: var(--r-md);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
    position: relative;
    white-space: nowrap;
  }
  .lnk:hover {
    color: var(--white);
    background: var(--fill-subtle);
  }
  .lnk.active,
  .lnk[aria-current="page"] {
    color: var(--white);
  }
  /* Animated underline pill — slides under the active link */
  .lnk.active::after,
  .lnk[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 20px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: translateX(-50%);
    box-shadow: 0 0 12px var(--gold);
  }

  /* Right — phone + CTA */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 14px;
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.2px;
    font-variant-numeric: tabular-nums;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .nav-phone svg {
    color: var(--gold);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-phone:hover {
    color: var(--white);
    background: var(--fill-subtle);
  }
  .nav-phone:hover svg {
    transform: rotate(-10deg);
  }

  .nav-signin {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    padding: 10px 14px;
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .nav-signin:hover {
    color: var(--white);
    background: var(--fill-subtle);
  }
  .nav-signin .nav-ext {
    font-size: 12px;
    color: var(--gold);
  }

  .nav-cta {
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 700;
    gap: 7px;
    min-height: 44px;
    box-shadow: 0 6px 20px rgba(245, 196, 24, 0.14);
  }
  .nav-cta-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-cta:hover .nav-cta-arrow { transform: translateX(3px); }

  /* Phone tiers — the number is the product demo; NEVER fully hidden on the
     desktop bar. Full number ≥1380; icon-only 44×44 pill from 1181–1379.
     Below 1180 the whole desktop bar is hidden and the shared drawer carries
     the phone. */
  @media (max-width: 1379px) {
    .nav-phone-text { display: none; }
    .nav-phone {
      width: 44px;
      padding: 10px;
      border: 1px solid var(--line);
      background: var(--fill-subtle);
    }
    .nav-phone:hover { border-color: var(--line-strong); }
  }

  /* Compression tiers for the centre cluster (Products mega + five links).
     Both sit ABOVE the 1180px hand-off to the hamburger, so the bar tightens
     gradually rather than going straight from roomy to overflowing. */
  @media (max-width: 1340px) {
    .lnk, .nav-centre :global(.megamenu-trigger) { padding: 11px 10px; }
    .nav-cta { padding: 11px 16px; }
  }
  @media (max-width: 1220px) {
    .lnk, .nav-centre :global(.megamenu-trigger) { padding: 11px 8px; font-size: 14.5px; }
    .nav-right { gap: 8px; }
    .nav-inner { gap: 12px; }
  }

  /* Hand over to the shared MobileBar + MobileDrawer (src/components/chrome/)
     at COMPACT_MAX — phones and tablets get the same bar and drawer as the
     international trees. */
  @media (max-width: 1180px) {
    .nav { display: none; }
  }

  /* AU-only drawer foot (tel / email / sign-in) — supplied via MobileDrawer's
     `foot` slot; styled here so the shared component carries no AU specifics. */
  .mdrawer-foot-call { width: 100%; justify-content: center; min-height: 48px; }
  .mdrawer-foot-call svg { color: var(--gold); flex: none; margin-inline-end: 6px; }
  .mdrawer-foot-email {
    text-align: center;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--mist-2);
    font-size: 14.5px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mdrawer-foot-email:hover { color: var(--white); }
</style>
