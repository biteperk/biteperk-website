---
/**
 * Sticky top nav — modern three-section layout.
 *
 *   ┌────────────────────────────────────────────────────────────────┐
 *   │ [★ biteperk]   Products▾  Pricing  Contact   📞 0450…  [CTA]  │
 *   └────────────────────────────────────────────────────────────────┘
 *
 * Left: logo + wordmark.
 * Centre: primary links (Products is a mega-menu via NavDropdown).
 * Right: a discreet phone link + a small filled "Meet VocoTable" CTA.
 *
 * Glassy translucent backdrop, gold hairline on scroll. Active link
 * marked with an animated underline pill.
 *
 * Mobile (<= 980px): logo + hamburger only; MobileMenu handles the
 * overlay.
 */
import StarMark from "@/components/StarMark.astro";
import NavDropdown from "@/components/NavDropdown.astro";
import MobileMenu from "@/components/MobileMenu.astro";
import { site } from "@/data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string): boolean {
  if (href.startsWith("#") || href.includes("#")) {
    const base = href.split("#")[0].replace(/\/$/, "") || "/";
    return pathname === base;
  }
  const n = href.replace(/\/$/, "") || "/";
  return pathname === n || pathname.startsWith(n + "/");
}

// Links shown in the centre cluster (Products handled separately as a
// mega-menu via <NavDropdown />).
const centreLinks = [
  { label: "Pricing", href: "/products/vocotable/#pricing" },
  { label: "Guides", href: "/blog/" },
  { label: "Contact", href: "/contact/" },
] as const;
---

<nav class="nav" id="nav" aria-label="Primary" data-ver="2" transition:persist>
  <div class="wrap nav-inner">
    <a class="brand nav-brand" href="/" aria-label="Biteperk home">
      <StarMark size={32} />
      <span class="brand-name">bite<span class="perk">perk</span></span>
    </a>

    <div class="nav-centre">
      <NavDropdown />
      {centreLinks.map((link) => (
        <a
          class:list={["lnk", { active: isActive(link.href) }]}
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="nav-right">
      <a class="nav-phone" href={site.phone.href} aria-label={`Call Biteperk on ${site.phone.display}`}>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M3.4 2.5C3 2.9 2.9 3.6 3.2 4.2c1.4 3 3.6 5.2 6.6 6.6.6.3 1.3.2 1.7-.2l.9-.9c.3-.3.3-.8 0-1.1l-1.5-1.5c-.3-.3-.8-.3-1.1 0l-.6.6c-1.5-.7-2.7-1.9-3.4-3.4l.6-.6c.3-.3.3-.8 0-1.1L4.9 1.1c-.3-.3-.8-.3-1.1 0z" fill="currentColor"/>
        </svg>
        <span class="nav-phone-text">{site.phone.display}</span>
      </a>
      <a class="btn nav-cta" href="/products/vocotable/" data-cta="meet-vocotable">
        <span class="nav-cta-full" aria-hidden="true">Meet VocoTable</span>
        <span class="nav-cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <button
      type="button"
      class="nav-burger"
      data-mobile-menu-trigger
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<MobileMenu />

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    background: rgba(10, 11, 13, 0.5);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
    padding-top: env(safe-area-inset-top);
  }
  .nav.scrolled {
    background: rgba(10, 11, 13, 0.85);
    border-bottom: 1px solid var(--line-gold);
    box-shadow: 0 8px 32px -16px rgba(0, 0, 0, 0.6);
  }
  .nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    height: 68px;
    gap: 20px;
    min-width: 0;
  }

  /* Left — brand */
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .nav-brand .brand-name {
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  /* Centre — links */
  .nav-centre {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    flex-wrap: nowrap;
    min-width: 0;
  }
  .lnk {
    font-size: 14px;
    font-weight: 500;
    color: var(--mist-2);
    padding: 8px 13px;
    border-radius: var(--r-md);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
    position: relative;
    white-space: nowrap;
  }
  .lnk:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.04);
  }
  .lnk.active,
  .lnk[aria-current="page"] {
    color: var(--white);
  }
  /* Animated underline pill — slides under the active link */
  .lnk.active::after,
  .lnk[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 18px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: translateX(-50%);
    box-shadow: 0 0 12px var(--gold);
  }

  /* Right — phone + CTA */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--r-pill);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.2px;
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .nav-phone svg {
    color: var(--gold);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-phone:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.04);
  }
  .nav-phone:hover svg {
    transform: rotate(-10deg);
  }

  .nav-cta {
    padding: 9px 18px;
    font-size: 13.5px;
    gap: 6px;
    min-height: 38px;
    box-shadow: 0 6px 20px rgba(245, 196, 24, 0.14);
  }
  .nav-cta-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-cta:hover .nav-cta-arrow { transform: translateX(3px); }

  /* Hamburger — mobile only */
  .nav-burger {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: var(--r-pill);
  }
  .nav-burger span {
    width: 20px;
    height: 1.6px;
    background: var(--white);
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .nav-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1240px) {
    .nav-phone-text { display: none; }
    .nav-phone { padding: 8px 10px; }
  }
  @media (max-width: 1100px) {
    .nav-phone { display: none; }
  }
  @media (max-width: 1040px) {
    .nav-cta { padding: 9px 14px; font-size: 13px; }
  }

  @media (max-width: 980px) {
    .nav-inner { grid-template-columns: auto 1fr auto; gap: 16px; height: 64px; }
    .nav-centre,
    .nav-right { display: none; }
    .nav-burger { display: inline-flex; justify-self: end; }
  }
</style>
