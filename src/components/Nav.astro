---
/**
 * Sticky top nav. Reads `Astro.url.pathname` so we can highlight the active
 * page link. Hidden link row on screens < 980px (matches the original
 * single-page behaviour — mobile nav is a P2 follow-up).
 */
import StarMark from "./StarMark.astro";
import { site, navLinks } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string): boolean {
  if (href.startsWith("http")) return false;
  // Anchor-only links (e.g. "/#contact") never highlight as active
  if (href.startsWith("/#")) return false;
  const normalised = href.replace(/\/$/, "") || "/";
  return pathname === normalised;
}
---

<nav class="nav" id="nav" aria-label="Primary">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Biteperk home">
      <StarMark size={38} />
      <span class="brand-name">bite<span class="perk">perk</span></span>
    </a>
    <div class="nav-links">
      {
        navLinks.map((link) => (
          <a
            class="lnk"
            href={link.href}
            rel={link.external ? "noopener" : undefined}
            target={link.external ? "_blank" : undefined}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        class="btn nav-call"
        href={site.phone.href}
        data-cta="bella-call"
        aria-label={`Call Biteperk on ${site.phone.display}`}
      >
        <span class="nav-call-full" aria-hidden="true">Call us · {site.phone.display}</span>
        <span class="nav-call-short" aria-hidden="true">Call</span>
      </a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(10, 11, 13, 0.65);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      background 0.3s ease;
  }
  .nav.scrolled {
    background: rgba(10, 11, 13, 0.95);
    border-bottom: 1px solid var(--bp-line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lnk {
    font-size: 14px;
    font-weight: 500;
    color: #c0c5ce;
    padding: 10px 14px;
    transition: color 0.2s;
  }
  .lnk:hover,
  .lnk[aria-current="page"] {
    color: #fff;
  }

  /* Responsive nav CTA: full phone number on roomy screens, "Call" on phones */
  .nav-call-short {
    display: none;
  }

  @media (max-width: 980px) {
    .nav-links .lnk {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .nav-call-full {
      display: none;
    }
    .nav-call-short {
      display: inline;
    }
    /* Tighten the gold pill on small screens — same visual weight, less width */
    .nav-call {
      padding: 12px 18px;
      font-size: 14px;
    }
  }
</style>
