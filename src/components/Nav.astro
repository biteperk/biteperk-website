---
/**
 * Sticky top nav — modern three-section layout.
 *
 *   ┌────────────────────────────────────────────────────────────────┐
 *   │ [★ biteperk]   Products▾  Pricing  Contact   📞 +61 2…  [CTA]  │
 *   └────────────────────────────────────────────────────────────────┘
 *
 * Left: logo + wordmark.
 * Centre: primary links (Products is a mega-menu via NavDropdown).
 * Right: a discreet phone link + a small filled "Book a demo" CTA.
 *
 * Glassy translucent backdrop, gold hairline on scroll. Active link
 * marked with an animated underline pill.
 *
 * Mobile (<= 980px): logo + hamburger only; MobileMenu handles the
 * overlay.
 */
import StarMark from "@/components/StarMark.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import NavDropdown from "@/components/NavDropdown.astro";
import MobileMenu from "@/components/MobileMenu.astro";
import { site } from "@/data/site";
import { headerNav, isNavActive } from "@/data/nav";

const pathname = Astro.url.pathname;

// Centre cluster = headerNav minus Products (which is the <NavDropdown />
// mega-menu). Single source shared with MobileMenu — see data/nav.ts.
const centreLinks = headerNav.filter((l) => l.desktop !== false);
---

<nav class="nav" id="nav" aria-label="Primary" transition:persist>
  <div class="wrap nav-inner">
    <a class="brand nav-brand" href="/" aria-label="Biteperk home">
      <StarMark size={34} />
      <span class="brand-name">bite<span class="perk">perk</span></span>
    </a>

    <div class="nav-centre">
      <NavDropdown />
      {centreLinks.map((link) => (
        <a
          class:list={["lnk", { active: isNavActive(pathname, link) }]}
          href={link.href}
          aria-current={isNavActive(pathname, link) ? "page" : undefined}
          data-nav-link={link.href.includes("#") ? undefined : link.href}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="nav-right">
      <ThemeToggle />
      <a
        class="nav-phone"
        href={site.phone.href}
        aria-label={`Call Biteperk on ${site.phone.display}`}
        title={site.phone.display}
        data-cta="call-nav"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3.4 2.5C3 2.9 2.9 3.6 3.2 4.2c1.4 3 3.6 5.2 6.6 6.6.6.3 1.3.2 1.7-.2l.9-.9c.3-.3.3-.8 0-1.1l-1.5-1.5c-.3-.3-.8-.3-1.1 0l-.6.6c-1.5-.7-2.7-1.9-3.4-3.4l.6-.6c.3-.3.3-.8 0-1.1L4.9 1.1c-.3-.3-.8-.3-1.1 0z" fill="currentColor"/>
        </svg>
        <span class="nav-phone-text">{site.phone.display}</span>
      </a>
      <a
        class="nav-signin"
        href={site.perktableUrl}
        target="_blank"
        rel="noopener"
        data-cta="sign-in"
      >
        Sign in
        <span class="nav-ext" aria-hidden="true">↗</span>
        <span class="sr-only">(opens the PerkTable app in a new tab)</span>
      </a>
      <a class="btn nav-cta" href="/contact/?intent=demo" data-cta="book-demo">
        Book a demo
        <span class="nav-cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <button
      type="button"
      class="nav-burger"
      data-mobile-menu-trigger
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<MobileMenu />

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    background: color-mix(in srgb, var(--ink-0) 55%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
    padding-top: env(safe-area-inset-top);
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--ink-0) 88%, transparent);
    border-bottom: 1px solid var(--line-gold);
    box-shadow: 0 8px 32px -16px rgba(0, 0, 0, 0.35);
  }
  /* One-shot entrance on full page load. Fixed position → no CLS; the
     nav is transition:persist'ed so this never replays on soft navs. */
  @media (prefers-reduced-motion: no-preference) {
    .nav {
      animation: nav-in 280ms var(--ease-soft) backwards;
    }
  }
  @keyframes nav-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    height: var(--nav-h);
    gap: 20px;
    min-width: 0;
    /* The bar carries more than the article column (6 links + mega-menu +
       theme toggle + the always-on phone number + Sign in + Book a demo),
       so it needs more room than --container-max (1180). Widen it here or
       the centre cluster overflows its 1fr track and — being centred —
       spills left over the wordmark. */
    max-width: 1300px;
  }
  /* Bar compresses slightly once scrolled — fixed position, so no CLS. */
  .nav.scrolled .nav-inner {
    height: var(--nav-h-scrolled);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-inner {
      transition: height var(--dur-base) var(--ease-out);
    }
  }

  /* Left — brand */
  .nav-brand {
    display: inline-flex;
    align-items: center;
    /* Extend the tap target into the bar's height without moving layout
       (the nav-inner grid centres it either way). */
    padding-block: 8px;
    margin-block: -8px;
    gap: 10px;
  }
  .nav-brand .brand-name {
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  /* Centre — links */
  .nav-centre {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex-wrap: nowrap;
    min-width: 0;
  }
  .lnk {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--mist-2);
    padding: 11px 13px;
    border-radius: var(--r-md);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
    position: relative;
    white-space: nowrap;
  }
  .lnk:hover {
    color: var(--white);
    background: var(--fill-subtle);
  }
  .lnk.active,
  .lnk[aria-current="page"] {
    color: var(--white);
  }
  /* Animated underline pill — slides under the active link */
  .lnk.active::after,
  .lnk[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 20px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: translateX(-50%);
    box-shadow: 0 0 12px var(--gold);
  }

  /* Right — phone + CTA */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 14px;
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.2px;
    font-variant-numeric: tabular-nums;
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .nav-phone svg {
    color: var(--gold);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-phone:hover {
    color: var(--white);
    background: var(--fill-subtle);
  }
  .nav-phone:hover svg {
    transform: rotate(-10deg);
  }

  .nav-signin {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    padding: 10px 14px;
    border-radius: var(--r-pill);
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .nav-signin:hover {
    color: var(--white);
    background: var(--fill-subtle);
  }
  .nav-signin .nav-ext {
    font-size: 12px;
    color: var(--gold);
  }

  .nav-cta {
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 700;
    gap: 7px;
    min-height: 44px;
    box-shadow: 0 6px 20px rgba(245, 196, 24, 0.14);
  }
  .nav-cta-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-cta:hover .nav-cta-arrow { transform: translateX(3px); }

  /* Hamburger — mobile only */
  .nav-burger {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: var(--r-pill);
  }
  .nav-burger span {
    width: 20px;
    height: 1.6px;
    background: var(--white);
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }
  .nav-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Phone tiers — the number is the product demo; NEVER fully hidden on
     desktop. Full number ≥1280; icon-only 44×44 pill below that. */
  @media (max-width: 1279px) {
    .nav-phone-text { display: none; }
    .nav-phone {
      width: 44px;
      padding: 10px;
      border: 1px solid var(--line);
      background: var(--fill-subtle);
    }
    .nav-phone:hover { border-color: var(--line-strong); }
  }

  /* Compression tiers for the 6-item centre cluster. */
  @media (max-width: 1160px) {
    .lnk, .nav-centre :global(.megamenu-trigger) { padding: 11px 10px; }
    .nav-cta { padding: 11px 16px; }
  }
  @media (max-width: 1060px) {
    .lnk, .nav-centre :global(.megamenu-trigger) { padding: 11px 8px; font-size: 14.5px; }
    .nav-right { gap: 8px; }
    .nav-inner { gap: 12px; }
  }

  @media (max-width: 980px) {
    .nav-inner { grid-template-columns: auto 1fr auto; gap: 16px; height: var(--nav-h-mobile); }
    .nav.scrolled .nav-inner { height: var(--nav-h-mobile); }
    .nav-centre,
    .nav-right { display: none; }
    .nav-burger { display: inline-flex; justify-self: end; }
  }
</style>
