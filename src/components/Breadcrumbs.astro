---
/**
 * Breadcrumb trail — renders <nav aria-label="Breadcrumb"> AND emits the
 * matching BreadcrumbList JSON-LD from the same items, so the two cannot drift
 * (the city page's did: "AI for Sydney restaurants" in the data, "Sydney" on
 * screen). Pages must NOT hand-roll their own BreadcrumbList any more.
 *
 * The last item has no href; its structured `item` is the current page.
 */
import { buildBreadcrumb } from "@/data/schema";

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: ReadonlyArray<Crumb>;
  /** Accessible name of the nav — localise on non-English pages. */
  label?: string;
  /** BCP 47 tag for the JSON-LD `inLanguage`. */
  lang?: string;
}
const { items, label = "Breadcrumb", lang } = Astro.props;
const here = Astro.url.pathname;
const jsonLd = buildBreadcrumb(
  items.map((c) => ({ name: c.label, path: c.href ?? here })),
  lang,
);
---

<nav class="crumbs" aria-label={label}>
  <ol>
    {items.map((c, i) => {
      const isLast = i === items.length - 1;
      return (
        <li>
          {isLast ? (
            <span aria-current="page">{c.label}</span>
          ) : c.href ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span>{c.label}</span>
          )}
          {!isLast && <span class="sep" aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .crumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 12.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--mist);
  }
  .crumbs li { display: inline-flex; align-items: center; gap: 8px; }
  .crumbs a {
    color: var(--mist);
    transition: color var(--dur-fast) var(--ease-out);
    /* Grow the tap target without shifting layout — crumbs are isolated
       (separator/current-page neighbours aren't interactive). */
    padding: 12px 4px;
    margin: -12px -4px;
  }
  .crumbs a:hover { color: var(--white); }
  .crumbs [aria-current="page"] { color: var(--white); }
  .sep { opacity: 0.5; }
</style>
