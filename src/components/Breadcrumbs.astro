---
/**
 * Breadcrumb trail, kept simple. Renders <nav aria-label="Breadcrumb">.
 */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: ReadonlyArray<Crumb>;
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => {
      const isLast = i === items.length - 1;
      return (
        <li>
          {isLast ? (
            <span aria-current="page">{c.label}</span>
          ) : c.href ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span>{c.label}</span>
          )}
          {!isLast && <span class="sep" aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .crumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 12.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--mist);
  }
  .crumbs li { display: inline-flex; align-items: center; gap: 8px; }
  .crumbs a {
    color: var(--mist);
    transition: color var(--dur-fast) var(--ease-out);
    /* Grow the tap target without shifting layout — crumbs are isolated
       (separator/current-page neighbours aren't interactive). */
    padding: 12px 4px;
    margin: -12px -4px;
  }
  .crumbs a:hover { color: var(--white); }
  .crumbs [aria-current="page"] { color: var(--white); }
  .sep { opacity: 0.5; }
</style>
