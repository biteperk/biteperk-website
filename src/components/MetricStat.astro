---
/**
 * Animated metric — counts up from 0 once it scrolls into view.
 *
 * Use when we have honest numbers. For unproven claims, prefer a
 * static chip instead — see TrustChip on the home page.
 */
interface Props {
  /** Number to count to. Use the underlying numeric value (e.g. 99.9 for "99.9%"). */
  to: number;
  /** Display format. */
  format?: "number" | "percent" | "time-ms" | "plain";
  /** Optional unit appended to the value (e.g. "venues", "%", "s"). */
  unit?: string;
  /** Lowercase label below the number. */
  label: string;
  /** Optional muted hint under the label. */
  hint?: string;
  /** Animation duration in ms. */
  duration?: number;
}
const { to, format = "number", unit, label, hint, duration = 1200 } = Astro.props;
---

<div class="stat">
  <div class="stat-row">
    <span
      class="stat-n tabular"
      data-counter
      data-counter-to={String(to)}
      data-counter-format={format}
      data-counter-duration={String(duration)}
    >0</span>
    {unit && <span class="stat-unit">{unit}</span>}
  </div>
  <div class="stat-l">{label}</div>
  {hint && <div class="stat-hint">{hint}</div>}
</div>

<style>
  .stat { min-width: 140px; }
  .stat-row {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .stat-n {
    font-size: clamp(34px, 3.6vw, 56px);
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stat-unit {
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 600;
    color: var(--gold);
  }
  .stat-l {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--mist);
    margin-top: 14px;
    font-weight: 500;
  }
  .stat-hint {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--mist-2);
  }
</style>
