---
/**
 * Full-screen mobile menu.
 *
 * Trigger lives in Nav.astro. Open/close + focus trap + scroll lock all
 * handled by src/scripts/mobile-menu.ts.
 */
import StarMark from "@/components/StarMark.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { products, statusLabel, productUrl } from "@/data/products";
import { headerNav, isNavActive } from "@/data/nav";
import { publishedCities, cityUrl } from "@/data/cities";
import { site } from "@/data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) => isNavActive(pathname, { label: "", href });
const companyLinks = headerNav.filter((l) => l.mobile !== false);
---

<div
  id="mobile-menu"
  class="mm"
  data-mobile-menu
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
>
  <div class="mm-backdrop" data-mobile-menu-backdrop aria-hidden="true"></div>
  <div class="mm-panel">
    <div class="mm-header">
      <a class="brand" href="/" aria-label="Biteperk home">
        <StarMark size={32} />
        <span class="brand-name">bite<span class="perk">perk</span></span>
      </a>
      <div class="mm-header-actions">
        <ThemeToggle />
        <button
          class="mm-close"
          data-mobile-menu-close
          aria-label="Close menu"
          type="button"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <nav class="mm-body" aria-label="Mobile">
      <div class="mm-section">
        <div class="mm-heading">Products</div>
        <p class="mm-subheading">Vox is one AI phone host. Bookings and takeaway are live; concierge and drive-thru roll out as add-ons.</p>
        {products.map((p) => (
          <a
            class:list={["mm-link", "mm-product", { active: isActive(productUrl(p)) }]}
            href={productUrl(p)}
          >
            <span class="mm-product-name">{p.name}</span>
            <span class:list={["mm-product-pill", `is-${p.status}`]}>{statusLabel(p.status)}</span>
          </a>
        ))}
        <a
          class:list={["mm-link", "mm-all", { active: isNavActive(pathname, { label: "", href: "/products/", activeMatch: "exact" }) }]}
          href="/products/"
        >
          See the Vox overview →
        </a>
      </div>

      <div class="mm-section">
        <div class="mm-heading">Company</div>
        {companyLinks.map((link) => (
          <a
            class:list={["mm-link", { active: isNavActive(pathname, link) }]}
            href={link.href}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="mm-section">
        <div class="mm-heading">Locations</div>
        <ul class="mm-cities">
          {publishedCities.map((c) => (
            <li>
              <a
                class:list={["mm-city", { active: isNavActive(pathname, { label: "", href: cityUrl(c) }) }]}
                href={cityUrl(c)}
              >
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="mm-cta">
        <a class="btn" href="/contact/?intent=demo" data-cta="book-demo">
          Book a demo
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost mm-call" href={site.phone.href} data-cta="call-menu">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path d="M3.4 2.5C3 2.9 2.9 3.6 3.2 4.2c1.4 3 3.6 5.2 6.6 6.6.6.3 1.3.2 1.7-.2l.9-.9c.3-.3.3-.8 0-1.1l-1.5-1.5c-.3-.3-.8-.3-1.1 0l-.6.6c-1.5-.7-2.7-1.9-3.4-3.4l.6-.6c.3-.3.3-.8 0-1.1L4.9 1.1c-.3-.3-.8-.3-1.1 0z" fill="currentColor"/>
          </svg>
          Call {site.phone.display}
        </a>
        <a class="mm-email" href={site.email.href}>Email hello@biteperk.com.au</a>
        <a class="mm-email" href={site.voxtableUrl} target="_blank" rel="noopener" data-cta="sign-in">
          Sign in to VoxTable ↗
        </a>
      </div>
    </nav>
  </div>
</div>

<style>
  .mm {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
  }
  .mm[hidden] { display: none; }
  .mm-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink-0) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .mm.is-open .mm-backdrop { opacity: 1; }

  .mm-panel {
    position: absolute;
    inset: 0;
    background: var(--ink-0);
    display: flex;
    flex-direction: column;
    transform: translateY(8px);
    opacity: 0;
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .mm.is-open .mm-panel {
    transform: none;
    opacity: 1;
  }
  /* Sections settle in sequence once the panel opens — the mobile
     mirror of the desktop mega-menu's staggered entrance. */
  @media (prefers-reduced-motion: no-preference) {
    .mm-section {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity var(--dur-base) var(--ease-soft),
        transform var(--dur-base) var(--ease-soft);
    }
    .mm.is-open .mm-section {
      opacity: 1;
      transform: none;
    }
    .mm.is-open .mm-section:nth-of-type(2) { transition-delay: 60ms; }
    .mm.is-open .mm-section:nth-of-type(3) { transition-delay: 120ms; }
    .mm.is-open .mm-section:nth-of-type(4) { transition-delay: 180ms; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-panel { transition: none; transform: none; }
    .mm-backdrop { transition: none; }
  }

  .mm-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 22px;
    border-bottom: 1px solid var(--line);
  }
  .mm-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mm-close {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-pill);
    color: var(--white);
  }
  .mm-close:hover { background: var(--fill-hover); }

  .mm-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px 22px 32px;
  }
  .mm-section { margin-bottom: 28px; }
  .mm-heading {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--mist);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .mm-subheading {
    margin: -4px 0 16px;
    color: var(--mist-2);
    font-size: 13px;
    line-height: 1.5;
  }
  .mm-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 4px;
    font-size: 18px;
    font-weight: 600;
    color: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .mm-link.active { color: var(--gold); }
  /* Native list-row press feedback (background flash, not scale). */
  .mm-link:active,
  .mm-city:active {
    background: var(--fill-hover);
  }
  .mm-link:last-child { border-bottom: 0; }
  .mm-all { color: var(--gold); font-size: 14px; letter-spacing: 1px; text-transform: uppercase; padding-top: 18px; }

  .mm-product { font-size: 17px; }
  .mm-product-pill {
    font-size: 10.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: var(--r-pill);
  }
  .mm-product-pill.is-live { background: var(--gold-fill); color: var(--gold-fill-text); }
  .mm-product-pill.is-in-development { color: var(--gold); border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent); }
  .mm-product-pill.is-concept { color: var(--mist-2); border: 1px solid var(--line); }

  /* Locations — compact two-per-row city chips */
  .mm-cities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .mm-city {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--ink-1);
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
  }
  .mm-city.active {
    color: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 35%, var(--line));
  }

  .mm-cta {
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }
  .mm-cta .btn,
  .mm-cta .btn-ghost {
    width: 100%;
    justify-content: center;
  }
  .mm-call svg { color: var(--gold); flex: none; }
  .mm-email {
    text-align: center;
    padding: 12px 4px;
    color: var(--mist-2);
    font-size: 14.5px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mm-email:hover { color: var(--white); }

  @media (min-width: 981px) {
    .mm { display: none; }
  }
</style>
