---
/**
 * Site footer. 4-column nav driven by `footerColumns` in src/data/nav.ts,
 * a brand blurb on the left, and a bottom bar with copyright, ABN and
 * the "Made in Sydney." signature.
 */
import StarMark from "@/components/StarMark.astro";
import { site } from "@/data/site";
import { footerColumns } from "@/data/nav";

const year = new Date().getFullYear();
const hasAbn = site.abn !== "TODO";
---

<footer class="cv-auto">
  <div class="wrap">
    <div class="foot-inner">
      <div class="foot-brand-cell">
        <div class="brand">
          <StarMark size={32} />
          <span class="brand-name foot-brand-name">
            bite<span class="perk">perk</span>
          </span>
        </div>
        <p class="foot-brand-text">
          Biteperk builds voice and AI tools for hospitality. Our first product, VoxTable,
          answers every restaurant call in a warm Australian voice. Made in Sydney.
        </p>
        <address class="foot-address">
          <a href={site.address.mapsUrl} rel="noopener" target="_blank">
            {site.address.street}<br />
            {site.address.locality} {site.address.region} {site.address.postalCode}
          </a>
          <a href={site.phone.href}>{site.phone.display}</a>
          <a href={site.email.href}>{site.email.display}</a>
        </address>
      </div>
      <div class="foot-cols reveal-stagger" style="--stagger-step: 40ms">
        {footerColumns.map((col) => (
          <div class="foot-col">
            <h4>{col.heading}</h4>
            {col.links.map((link) => (
              <a
                href={link.href}
                rel={link.external ? "noopener" : undefined}
                target={link.external ? "_blank" : undefined}
              >
                {link.label}
              </a>
            ))}
            {col.heading === "Legal" && (
              <button type="button" class="foot-col-btn" data-cookie-settings>
                Cookie settings
              </button>
            )}
          </div>
        ))}
      </div>
    </div>
    <div class="foot-bottom">
      <div>
        © {year} Biteperk Pty Ltd
        {hasAbn && <span> · ABN {site.abn}</span>}
        · All rights reserved.
      </div>
      <div class="foot-tag">
        <span class="dot" aria-hidden="true"></span>
        Made in {site.address.city}.
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 64px 0 36px;
    padding-bottom: calc(36px + env(safe-area-inset-bottom));
    background: var(--ink-0);
  }
  .foot-inner {
    display: grid;
    grid-template-columns: 1.1fr 2.4fr;
    gap: 56px;
  }
  .foot-brand-name { font-size: 17px; }
  .foot-brand-text {
    color: var(--mist);
    font-size: 14px;
    line-height: 1.65;
    margin-top: 16px;
    max-width: 340px;
  }
  .foot-address {
    font-style: normal;
    margin-top: 20px;
    display: grid;
    gap: 4px;
  }
  .foot-address a {
    color: var(--mist);
    font-size: 13.5px;
    line-height: 1.55;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-address a:hover,
  .foot-address a:focus-visible {
    color: var(--white);
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .foot-col h4 {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 18px;
    font-weight: 600;
  }
  .foot-col a {
    display: block;
    font-size: 14px;
    color: var(--mist);
    /* Real padding, no negative margins: these rows stack, and
       overlapping hit areas in a dense list cause mis-taps. */
    padding-block: 8px;
    margin-bottom: 2px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-col a:hover,
  .foot-col a:focus-visible {
    color: var(--white);
  }
  /* Matches .foot-col a exactly — it's a control (re-opens cookie settings),
     not a route, so it can't be a plain nav link. */
  .foot-col-btn {
    display: block;
    font-size: 14px;
    color: var(--mist);
    background: none;
    border: 0;
    text-align: left;
    padding-block: 8px;
    margin-bottom: 2px;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-col-btn:hover,
  .foot-col-btn:focus-visible {
    color: var(--white);
  }
  .foot-bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--mist);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .foot-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--mist-2);
  }
  .foot-tag .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 10px var(--gold);
  }

  @media (max-width: 980px) {
    .foot-inner { grid-template-columns: 1fr; gap: 40px; }
    .foot-cols { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
  }
  @media (max-width: 480px) {
    .foot-cols { grid-template-columns: 1fr; }
  }
</style>
