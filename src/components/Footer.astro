---
/**
 * Site footer. 4-column nav driven by `footerColumns` in src/data/nav.ts,
 * a brand blurb on the left, and a bottom bar with copyright, ABN and
 * the "Made in Sydney." signature.
 */
import StarMark from "@/components/StarMark.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { site } from "@/data/site";
import { footerColumns } from "@/data/nav";

const year = new Date().getFullYear();
const hasAbn = site.abn !== "TODO";
---

<footer class="cv-auto">
  <div class="wrap">
    <div class="foot-inner">
      <div class="foot-brand-cell">
        <div class="brand">
          <StarMark size={32} />
          <span class="brand-name foot-brand-name">
            bite<span class="perk">perk</span>
          </span>
        </div>
        <p class="foot-brand-text">
          Biteperk builds voice and AI tools for hospitality. Our first product, VoxTable,
          answers every restaurant call in a warm Australian voice. Made in Sydney.
        </p>
        <address class="foot-address">
          <a href={site.address.mapsUrl} rel="noopener" target="_blank">
            {site.address.street}<br />
            {site.address.locality} {site.address.region} {site.address.postalCode}
          </a>
          <a href={site.phone.href}>{site.phone.display}</a>
          <a href={site.email.href}>{site.email.display}</a>
        </address>
        {/* Sits in the brand cell rather than as a sixth footer column: these
            are identity, the same kind of thing as the address and the phone
            number, not a section of the site you can navigate to. */}
        <div class="foot-social">
          <SocialLinks label="Follow BitePerk" />
        </div>
      </div>
      <div class="foot-cols reveal-stagger" style="--stagger-step: 40ms">
        {footerColumns.map((col) => (
          <div class="foot-col">
            {/* h2, not h4: these are the top-level groupings inside the
                contentinfo landmark, and the preceding page heading is an h2,
                so h4 skipped a level. .foot-col h2 keeps the 11.5px uppercase
                treatment — level and scale are separate concerns. */}
            <h2>{col.heading}</h2>
            {col.links.map((link) => (
              <a
                href={link.href}
                rel={link.external ? "noopener" : undefined}
                target={link.external ? "_blank" : undefined}
              >
                {link.label}
              </a>
            ))}
            {col.heading === "Legal" && (
              <button type="button" class="foot-col-btn" data-cookie-settings>
                Cookie settings
              </button>
            )}
          </div>
        ))}
      </div>
    </div>
    <div class="foot-bottom">
      <div>
        © {year} Biteperk Pty Ltd
        {hasAbn && (
          <span>
            {" · "}
            {/* Linked, not plain text. Anyone can claim an ABN; the trust
                comes from being able to check it in one click on the
                government register. rel="nofollow" — it's a verification
                link, not an endorsement we're passing rank to. */}
            <a
              class="foot-abn"
              href={site.abnLookupUrl}
              rel="nofollow noopener"
              target="_blank"
              title={`Verify ABN ${site.abn} on the Australian Business Register`}
            >
              ABN {site.abn}
            </a>
          </span>
        )}
        · All rights reserved.
      </div>
      <div class="foot-tag">
        <span class="dot" aria-hidden="true"></span>
        Made in {site.address.city}.
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 64px 0 36px;
    padding-bottom: calc(36px + env(safe-area-inset-bottom));
    background: var(--ink-0);
  }
  .foot-inner {
    display: grid;
    grid-template-columns: 1.1fr 2.4fr;
    gap: 56px;
  }
  .foot-brand-name { font-size: 17px; }
  .foot-brand-text {
    color: var(--mist);
    font-size: 14px;
    line-height: 1.65;
    margin-top: 16px;
    max-width: 340px;
  }
  .foot-address {
    font-style: normal;
    margin-top: 20px;
    display: grid;
    gap: 4px;
  }
  .foot-address a {
    color: var(--mist);
    font-size: 13.5px;
    line-height: 1.55;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-address a:hover,
  .foot-address a:focus-visible {
    color: var(--white);
  }
  /* Negative inline start offset cancels the icon's own 12px tap padding so
     the first glyph optically aligns with the address text above it. */
  .foot-social {
    margin-top: 8px;
    margin-inline-start: -12px;
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .foot-col h2 {
    font-size: 11.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 18px;
    font-weight: 600;
  }
  .foot-col a {
    display: block;
    font-size: 14px;
    color: var(--mist);
    /* Real padding, no negative margins: these rows stack, and
       overlapping hit areas in a dense list cause mis-taps. */
    padding-block: 8px;
    margin-bottom: 2px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-col a:hover,
  .foot-col a:focus-visible {
    color: var(--white);
  }
  /* Matches .foot-col a exactly — it's a control (re-opens cookie settings),
     not a route, so it can't be a plain nav link. */
  .foot-col-btn {
    display: block;
    font-size: 14px;
    color: var(--mist);
    background: none;
    border: 0;
    text-align: left;
    padding-block: 8px;
    margin-bottom: 2px;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-col-btn:hover,
  .foot-col-btn:focus-visible {
    color: var(--white);
  }
  .foot-bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--mist);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* Inherits the bottom bar's colour so it reads as part of the legal line,
     not a call to action — the underline on hover is the only affordance it
     needs. Dotted underline at rest hints it's checkable without shouting. */
  .foot-abn {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    text-decoration-color: var(--mist-2);
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .foot-abn:hover,
  .foot-abn:focus-visible {
    color: var(--white);
    text-decoration-style: solid;
    text-decoration-color: currentColor;
  }
  .foot-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--mist-2);
  }
  .foot-tag .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 10px var(--gold);
  }

  @media (max-width: 980px) {
    .foot-inner { grid-template-columns: 1fr; gap: 40px; }
    .foot-cols { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
  }
  @media (max-width: 480px) {
    .foot-cols { grid-template-columns: 1fr; }
  }
</style>
