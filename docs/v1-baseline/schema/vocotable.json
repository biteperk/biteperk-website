  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How accurate is Bella with Australian accents and place names?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Very. The model is trained on Australian English and we hand-tune it for the suburbs and venues we serve. Edge cases get caught by our Sydney team — not an overseas help desk."
        }
      },
      {
        "@type": "Question",
        "name": "Does VocoTable plug into my booking system?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Today we sync to your VocoTable diary directly; integrations with the major Australian booking platforms are on the roadmap. Existing bookings stay yours and can be exported at any time."
        }
      },
      {
        "@type": "Question",
        "name": "What happens to call recordings and data?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Audio is processed in Australia, stored only as long as needed to confirm the booking, and never used to train models outside Biteperk. We are Privacy Act compliant."
        }
      },
      {
        "@type": "Question",
        "name": "Can I cancel if it doesn't work for my venue?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — VocoTable is month to month, no lock-in. You can cancel any time and your data is exported within 24 hours."
        }
      },
      {
        "@type": "Question",
        "name": "How is the price so low?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We built VocoTable from the ground up for hospitality, on infrastructure we run ourselves. Flat $80 a month, unlimited calls. No per-cover fees, ever."
        }
      },
      {
        "@type": "Question",
        "name": "Where is support based?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sydney. 9am to 9pm AEST, by phone or email, with a human who has answered restaurant phones before."
        }
      }
    ]
  },
